# ============================================
# OPTIMIZED DOCKERIGNORE - BALANCED APPROACH  
# ============================================

# EXCLUDE LARGE DIRECTORIES AND FILES
**/node_modules/
**/.turbo/
**/.next/
**/.cache/
**/dist/
!packages/api-utils/dist/
!packages/shared-ui/dist/
!packages/testing-utils/dist/
!packages/config-consolidated/eslint-config/dist/

# EXCLUDE DOCUMENTATION AND REPORTS
*.md
!README.md
*_REPORT.md
*_PLAN.md
*_STATUS.md

# EXCLUDE BINARIES AND LARGE FILES
*.zip
*.exe  
*.tar.gz
*.log
*.db
*.sqlite

# EXCLUDE DEPLOYMENT AND INFRASTRUCTURE
archive*/
deployment*/
infrastructure/
monitoring/
aws-*/
memorai-*/
cbd-*/
research/
docs/
tests/

# EXCLUDE UNNECESSARY APPS (keep only the 5 we need + romai for neural builds)
apps/*/node_modules/
apps/*/.next/
apps/*/.turbo/
apps/aide/
apps/ajutai/
apps/analizai/
apps/bancai/
apps/bancai-mobile/
apps/conversai/
apps/dexai/
apps/docs/
apps/donai/
apps/gateway/
apps/hub/
apps/id/
apps/legalizai/
apps/logai/
apps/memorai/
apps/memorai-landing/
apps/metu/
apps/mod/
apps/publicai/
apps/admin/

# EXCLUDE UNNECESSARY PACKAGES 
packages/*/node_modules/
packages/*/.turbo/
packages/*/.next/
packages/cbd/
packages/memorai-mcp/
packages/websocket-service/
packages/ssl-proxy/
packages/secure-gateway/
packages/ai-mcp/
packages/codai-sso-sdk/
packages/logai-universal/
packages/memorai-cli/
packages/memorai-sdk/
packages/service-registry/
!packages/api-utils/
!packages/shared-ui/
!packages/testing-utils/
!packages/config-consolidated/eslint-config/
!packages/translations/

# EXCLUDE LIBS
libs/
