# Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/.next/
**/.nuxt/
**/.turbo/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Cache directories
.cache/
**/.cache/
.tmp/
**/.tmp/
.temp/
**/.temp/

# Logs
logs/
*.log
**/*.log

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
**/coverage/
**/*.tsbuildinfo

# Documentation
*.md
!README.md
docs/
**/docs/

# Archives and backups
*.zip
*.tar.gz
*.tgz
archive*/
backup*/

# Exclude everything except CAUTAI-related packages
apps/*
!apps/cautai-server/

# Keep only essential packages for CAUTAI
packages/*
!packages/cautai-mcp/
!packages/cautai-config/
!packages/cautai-logger/
!packages/cautai-i18n/
!packages/cautai-client/
!packages/cautai-ui/

# Exclude other libs and configs
libs/
configs/
infrastructure/
monitoring/
load-balancing/
scripts/*
!scripts/init-cautai-databases.sh

# Exclude Docker files not needed for CAUTAI
docker-compose*.yml
!docker-compose.cautai.yml
Dockerfile.*
!apps/cautai-server/Dockerfile

# Exclude large data files
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3

# Exclude media files
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp

# Exclude development files
.prettierrc
.eslintrc*
jest.config.*
vitest.config.*
tsconfig.json
!packages/cautai-mcp/tsconfig.json
!apps/cautai-server/tsconfig.json
