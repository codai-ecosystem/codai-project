# ===========================================
# CODAI ECOSYSTEM - ENVIRONMENT TEMPLATE
# Copy to .env.local and configure your values
# ===========================================

# ===========================================
# AZURE AI SERVICES CONFIGURATION
# ===========================================

# Azure AI Foundry (Primary recommended service for most use cases)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_AI_FOUNDRY_KEY=your_azure_ai_foundry_key_here

# Azure OpenAI (Specialized OpenAI-only service)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Search (RAG capabilities) 
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_azure_search_key_here

# Resource Information
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_LOCATION=your-azure-region
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Service Names
AZURE_AI_FOUNDRY_NAME=your-ai-foundry-service
AZURE_AI_HUB_NAME=your-ai-hub-service
AZURE_OPENAI_NAME=your-openai-service
AZURE_SEARCH_NAME=your-search-service

# Deployed Models (comma-separated list)
AZURE_OPENAI_MODELS=gpt-4o,gpt-4o-mini,whisper,gpt-35-turbo

# Model-specific deployments for applications
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_GPT35_DEPLOYMENT=gpt-35-turbo

# ===========================================
# LEGACY AZURE OPENAI CONFIGURATION
# ===========================================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_INSTANCE_NAME=your-instance-name
AZURE_OPENAI_API_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/

# Azure Tenant & Client
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ===========================================
# GOOGLE CLOUD CONFIGURATION
# ===========================================
GOOGLE_CLOUD_PROJECT_ID=codai-ecosystem
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_ZONE=us-central1-a
GOOGLE_CLOUD_CLIENT_EMAIL=your-service@your-project.iam.gserviceaccount.com
GOOGLE_CLOUD_CLIENT_ID=your-client-id
GOOGLE_CLOUD_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
FIREBASE_PROJECT_ID=codai-ecosystem
FIREBASE_APP_ID=your-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Service-specific Firebase configs
MEMORAI_FIREBASE_PROJECT_ID=memorai-service
MEMORAI_FIREBASE_API_KEY=your-memorai-api-key
MEMORAI_FIREBASE_AUTH_DOMAIN=memorai-service.firebaseapp.com
MEMORAI_FIREBASE_STORAGE_BUCKET=memorai-service.firebasestorage.app
MEMORAI_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
MEMORAI_FIREBASE_APP_ID=your-memorai-app-id

BANCAI_FIREBASE_PROJECT_ID=bancai-service
BANCAI_FIREBASE_API_KEY=your-bancai-api-key
BANCAI_FIREBASE_AUTH_DOMAIN=bancai-service.firebaseapp.com
BANCAI_FIREBASE_STORAGE_BUCKET=bancai-service.firebasestorage.app
BANCAI_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
BANCAI_FIREBASE_APP_ID=your-bancai-app-id

KODEX_FIREBASE_PROJECT_ID=kodex-service
KODEX_FIREBASE_API_KEY=your-kodex-api-key
KODEX_FIREBASE_AUTH_DOMAIN=kodex-service.firebaseapp.com
KODEX_FIREBASE_STORAGE_BUCKET=kodex-service.firebasestorage.app
KODEX_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
KODEX_FIREBASE_APP_ID=your-kodex-app-id

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=postgresql://username:password@localhost:5432/codai_ecosystem
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/codai

# ===========================================
# AUTHENTICATION
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-here
AUTH_JWT_EXPIRY=7d
AUTH_REFRESH_TOKEN_EXPIRY=30d
AUTH_BCRYPT_ROUNDS=12

# ===========================================
# GITHUB CONFIGURATION
# ===========================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_ACCESS_TOKEN=your-github-access-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=your-app-id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# ===========================================
# PAYMENT PROVIDERS
# ===========================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# API CONFIGURATION
# ===========================================
API_GATEWAY_URL=https://api.codai.ro
API_GATEWAY_VERSION=v1
API_GATEWAY_TIMEOUT=30000
API_RATE_LIMIT=1000

# ===========================================
# EMAIL & COMMUNICATION
# ===========================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@codai.ro
SUPPORT_EMAIL=support@codai.ro

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
MIXPANEL_TOKEN=your-mixpanel-token
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ===========================================
# EXTERNAL APIS
# ===========================================
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENWEATHER_API_KEY=your-openweather-api-key
NEWS_API_KEY=your-news-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
LOG_LEVEL=info
DEBUG_MODE=true
CORS_ORIGIN=http://localhost:3000

# ===========================================
# SECURITY
# ===========================================
ENCRYPTION_KEY=your-32-character-encryption-key
CSRF_SECRET=your-csrf-secret
SESSION_SECRET=your-session-secret

# ===========================================
# CLOUD STORAGE
# ===========================================
GOOGLE_CLOUD_STORAGE_BUCKET=your-storage-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# ===========================================
# DOMAINS
# ===========================================
DOMAIN_CODAI=codai.ro
DOMAIN_MEMORAI=memorai.ro
DOMAIN_BANCAI=bancai.ro
DOMAIN_KODEX=kodex.ro
DOMAIN_HUB=hub.codai.ro
DOMAIN_API=api.codai.ro
DOMAIN_ADMIN=admin.codai.ro
