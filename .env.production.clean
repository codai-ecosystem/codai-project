# Production Environment Variables - Clean Version

# Node Environment
NODE_ENV=production

# Application Internal Ports (inside containers)
CBD_PORT=4180
HUB_PORT=3000
GATEWAY_PORT=4003
MEMORAI_MCP_PORT=4950

# Database Configuration
POSTGRES_DB=codai_prod
POSTGRES_USER=codai_user
POSTGRES_PASSWORD=codai_secure_password_2025
DATABASE_URL=postgresql://codai_user:codai_secure_password_2025@codai-postgres-prod:5432/codai_prod

# Redis Configuration
REDIS_URL=redis://codai-redis-prod:6379

# Security
JWT_SECRET=codai_production_jwt_secret_key_2025_very_secure_random_string

# External URLs (mapped to avoid conflicts with development)
NEXT_PUBLIC_CBD_API_URL=http://localhost:4190
NEXT_PUBLIC_HUB_URL=http://localhost:4018
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4013

# MemorAI Configuration
MEMORAI_API_KEY=memorai-prod-key-2025

# Monitoring
LOG_LEVEL=info
HEALTH_CHECK_INTERVAL=30
