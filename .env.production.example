# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Database Configuration
DATABASE_URL=postgresql://codaimaster:YOUR_PASSWORD@codai-production-db.cluster-xxx.us-east-1.rds.amazonaws.com:5432/codai_production
POSTGRES_DB=codai_production
POSTGRES_USER=codaimaster
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# Redis Configuration
REDIS_URL=redis://codai-production-redis.xxx.cache.amazonaws.com:6379

# JWT and Security
JWT_SECRET=YOUR_256_BIT_SECRET_KEY_HERE
MEMORAI_API_KEY=memorai-prod-key-2025

# API URLs
NEXT_PUBLIC_CBD_API_URL=https://api.codai.ro
CBD_API_URL=http://cbd-database:4180

# Domain Configuration
DOMAIN=codai.ro
SUBDOMAIN_HUB=hub.codai.ro
SUBDOMAIN_API=api.codai.ro
SUBDOMAIN_ADMIN=admin.codai.ro

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/codai.ro.crt
SSL_KEY_PATH=/etc/nginx/ssl/codai.ro.key

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# Container Registry
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
DOCKER_REGISTRY=codai-ecosystem

# Monitoring and Logging
LOG_LEVEL=info
DATADOG_API_KEY=YOUR_DATADOG_API_KEY
NEWRELIC_LICENSE_KEY=YOUR_NEWRELIC_LICENSE_KEY

# Performance and Scaling
MAX_CONNECTIONS=1000
WORKER_PROCESSES=auto
CACHE_TTL=3600

# Security Headers
SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Backup Configuration
BACKUP_S3_BUCKET=codai-production-backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"
