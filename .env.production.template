# ======================================
# CODAI Ecosystem - Production Environment Configuration Template
# ======================================
# Copy this file to .env.production and fill in actual values
# DO NOT commit actual .env.production file - only this template

# ======================================
# Core Infrastructure Configuration
# ======================================

# Environment
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=8192

# ======================================
# Service Ports & URLs (Production)
# ======================================

# Core Services
CBD_DATABASE_PORT=5432
MEMORAI_MCP_PORT=4950
MEMORAI_APP_PORT=4006
MEMORAI_GRAPHQL_PORT=4500
ROMAI_AGI_PORT=6101
ROMAI_ENTERPRISE_API_PORT=8001
GATEWAY_PORT=4000

# Application Ports
BANCAI_PORT=4005
CONTROLAI_DASHBOARD_PORT=3001
HUB_APP_PORT=3002
ADMIN_APP_PORT=3003
ID_APP_PORT=3004

# Base URLs (Production)
CBD_BASE_URL=https://api.codai-ecosystem.com
MEMORAI_API_BASE_URL=https://memorai.codai-ecosystem.com
MEMORAI_GRAPHQL_URL=https://graphql.codai-ecosystem.com
ROMAI_AGI_BASE_URL=https://romai.codai-ecosystem.com
ROMAI_ENTERPRISE_API_URL=https://enterprise.codai-ecosystem.com
GATEWAY_BASE_URL=https://gateway.codai-ecosystem.com

# Frontend URLs
FRONTEND_BASE_URL=https://codai-ecosystem.com
BANCAI_URL=https://bancai.codai-ecosystem.com
CONTROLAI_URL=https://controlai.codai-ecosystem.com
HUB_URL=https://hub.codai-ecosystem.com
ADMIN_URL=https://admin.codai-ecosystem.com
ID_URL=https://id.codai-ecosystem.com

# ======================================
# Database Configuration
# ======================================

# CODAI Better Database (CBD)
CBD_HOST=codai-database-cluster.cluster-xyz.region.rds.amazonaws.com
CBD_PORT=5432
CBD_DATABASE=codai_production
CBD_USERNAME=codai_app_user
CBD_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD
CBD_SSL_MODE=require
CBD_MAX_CONNECTIONS=50
CBD_CONNECTION_TIMEOUT=30000
CBD_LOG_LEVEL=info

# Database Connection Pool
CBD_POOL_MIN=5
CBD_POOL_MAX=20
CBD_POOL_IDLE_TIMEOUT=300000
CBD_POOL_ACQUIRE_TIMEOUT=60000

# ======================================
# Authentication & Security
# ======================================

# JWT Configuration
JWT_SECRET_KEY=REPLACE_WITH_SECURE_256_BIT_SECRET_KEY
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
JWT_ALGORITHM=HS256

# API Keys & Authentication
MEMORAI_API_KEY=REPLACE_WITH_PRODUCTION_MEMORAI_API_KEY
ROMAI_API_KEY=REPLACE_WITH_PRODUCTION_ROMAI_API_KEY
BANCAI_API_KEY=REPLACE_WITH_PRODUCTION_BANCAI_API_KEY
CONTROLAI_API_KEY=REPLACE_WITH_PRODUCTION_CONTROLAI_API_KEY

# Service Authentication Tokens
MEMORAI_SERVICE_TOKEN=REPLACE_WITH_MEMORAI_SERVICE_TOKEN
ROMAI_SERVICE_TOKEN=REPLACE_WITH_ROMAI_SERVICE_TOKEN
GRAPHQL_CLIENT_API_KEY=REPLACE_WITH_GRAPHQL_CLIENT_API_KEY
GRAPHQL_SERVICE_TOKEN=REPLACE_WITH_GRAPHQL_SERVICE_TOKEN

# Enterprise API Security
API_KEY_ENCRYPTION_KEY=REPLACE_WITH_API_KEY_ENCRYPTION_KEY_256_BIT
ENTERPRISE_API_SECRET=REPLACE_WITH_ENTERPRISE_API_SECRET_KEY

# ======================================
# AI/ML Services Configuration
# ======================================

# Azure OpenAI Configuration (Production)
AZURE_OPENAI_ENDPOINT=https://codai-openai-prod.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_WITH_PRODUCTION_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-production
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large-prod

# OpenAI Fallback Configuration
OPENAI_API_KEY=REPLACE_WITH_PRODUCTION_OPENAI_KEY
OPENAI_ORG_ID=REPLACE_WITH_OPENAI_ORG_ID

# RomAI AGI Configuration
ROMAI_ENV=production
ROMAI_LOG_LEVEL=INFO
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:2048
TRANSFORMERS_CACHE=/app/.cache/transformers
HF_HOME=/app/.cache/huggingface
MODEL_CACHE_DIR=/app/.cache/models

# AGI Engine Configuration
QUANTUM_ENABLED=true
CONSCIOUSNESS_ENGINE=true
AUTONOMOUS_REASONING=true
MATH_ENGINE_ENABLED=true
LOGICAL_ENGINE_ENABLED=true
ROMANIAN_ENGINE_ENABLED=true

# ======================================
# MemorAI MCP Server Configuration
# ======================================

# Memory & Search Configuration
ENABLE_VECTOR_SEARCH=true
ENABLE_HYBRID_SEARCH=true
ENABLE_FUZZY_MATCHING=true
ENABLE_KEYWORD_SEARCH=true
ENABLE_RBAC=true
ENABLE_REALTIME_COLLAB=true
ENABLE_ANALYTICS=true
ENABLE_TEMPORAL=true
ENABLE_PATTERNS=true
ENABLE_CLUSTERING=true
ENABLE_CROSS_REF=true
ENABLE_BACKUP=true
ENABLE_MONITORING=true

# Cache Configuration (Production)
VECTOR_CACHE_TTL=7200
SEARCH_CACHE_TTL=900
REDIS_CACHE_URL=redis://codai-redis-cluster.xyz.cache.amazonaws.com:6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ======================================
# SSL/TLS Configuration
# ======================================

# HTTPS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/app/ssl/codai-ecosystem.com.crt
SSL_KEY_PATH=/app/ssl/codai-ecosystem.com.key
SSL_CA_PATH=/app/ssl/ca-bundle.crt

# ======================================
# CORS & Security Headers
# ======================================

# CORS Configuration (Production)
CORS_ENABLED=true
CORS_ORIGINS=https://codai-ecosystem.com,https://bancai.codai-ecosystem.com,https://controlai.codai-ecosystem.com,https://hub.codai-ecosystem.com,https://admin.codai-ecosystem.com,https://id.codai-ecosystem.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,X-API-Key

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'

# ======================================
# Rate Limiting & Performance
# ======================================

# Rate Limiting (Production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_REDIS_URL=redis://codai-redis-cluster.xyz.cache.amazonaws.com:6379

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
REQUEST_TIMEOUT=30000
HEALTH_CHECK_INTERVAL=30000

# ======================================
# Compliance & Legal
# ======================================

# EU AI Act Compliance
COMPLIANCE_MODE=eu_ai_act
AUDIT_ENABLED=true
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555

# Regulatory Compliance
PCI_DSS_ENABLED=true
SOC2_COMPLIANCE=true
ISO27001_COMPLIANCE=true

# ======================================
# Monitoring & Logging
# ======================================

# Application Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file
LOG_FILE_PATH=/app/logs/codai-ecosystem.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_ROTATION=daily

# External Monitoring
DATADOG_API_KEY=REPLACE_WITH_DATADOG_API_KEY
NEW_RELIC_LICENSE_KEY=REPLACE_WITH_NEW_RELIC_LICENSE_KEY
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN

# Metrics & Analytics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000

# ======================================
# Cloud Infrastructure
# ======================================

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
AWS_S3_BUCKET=codai-production-assets
AWS_CLOUDFRONT_DISTRIBUTION=REPLACE_WITH_CLOUDFRONT_DISTRIBUTION_ID

# Container Registry
DOCKER_REGISTRY=your-registry.amazonaws.com/codai
IMAGE_TAG=latest

# ======================================
# Feature Flags & Configuration
# ======================================

# Feature Toggles
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_REAL_TIME_FEATURES=true
ENABLE_ENTERPRISE_FEATURES=true
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_MODE=false

# Performance Tuning
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_CDN=true

# ======================================
# Backup & Recovery
# ======================================

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=codai-production-backups

# Application Backup
APP_BACKUP_ENABLED=true
CONFIG_BACKUP_ENABLED=true

# ======================================
# Health Checks & Status
# ======================================

# Service Health Monitoring
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=5000
UPTIME_MONITORING_ENABLED=true

# Status Page Configuration
STATUS_PAGE_ENABLED=true
STATUS_PAGE_URL=https://status.codai-ecosystem.com