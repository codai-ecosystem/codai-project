# RomAI AGI Production Environment Configuration
# Phase 3E: CI/CD Pipeline Implementation
#
# SECURITY NOTICE: This file contains production secrets and should never be committed to version control
# Copy this file to .env.production and fill in your actual values

# ================================
# APPLICATION CONFIGURATION
# ================================
NODE_ENV=production
ROMAI_ENV=production
ROMAI_LOG_LEVEL=INFO
PORT=6101
HOST=0.0.0.0

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL Production Database
POSTGRES_USER=romai
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE
POSTGRES_DB=romai_production
POSTGRES_HOST=romai-postgres-prod
POSTGRES_PORT=5432

# Database URL for RomAI AGI
DATABASE_URL=postgresql://romai:YOUR_SECURE_POSTGRES_PASSWORD_HERE@romai-postgres-prod:5432/romai_production

# ================================
# REDIS CACHE CONFIGURATION
# ================================
REDIS_HOST=romai-redis-prod
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE
REDIS_DB=0
REDIS_URL=redis://:YOUR_SECURE_REDIS_PASSWORD_HERE@romai-redis-prod:6379/0

# ================================
# SECURITY CONFIGURATION
# ================================
# JWT Tokens
JWT_SECRET_KEY=YOUR_SUPER_SECURE_JWT_SECRET_KEY_MINIMUM_256_BITS
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=YOUR_SUPER_SECURE_REFRESH_TOKEN_SECRET_KEY
REFRESH_TOKEN_EXPIRATION=7d

# API Keys and Authentication
API_KEY_ENCRYPTION_KEY=YOUR_SUPER_SECURE_API_ENCRYPTION_KEY_32_BYTES
ADMIN_API_KEY=YOUR_SECURE_ADMIN_API_KEY_FOR_SYSTEM_ACCESS

# CORS Configuration
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://admin.your-domain.com
CORS_CREDENTIALS=true

# ================================
# AZURE OPENAI CONFIGURATION
# ================================
# Azure OpenAI for AI capabilities
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Embedding Model
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# ================================
# ADVANCED AI CONFIGURATION
# ================================
# RomAI AGI Specific Settings
QUANTUM_ENABLED=true
CONSCIOUSNESS_ENGINE=true
ADVANCED_CAPABILITIES_ENABLED=true
NEURAL_NETWORK_OPTIMIZATION=true

# Model Caching
TRANSFORMERS_CACHE=/app/.cache/transformers
HF_HOME=/app/.cache/huggingface
MODEL_CACHE_DIR=/app/.cache/models

# Performance Settings
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024
TOKENIZERS_PARALLELISM=false

# ================================
# COMPLIANCE CONFIGURATION
# ================================
# EU AI Act Compliance
COMPLIANCE_MODE=eu_ai_act
EU_AI_ACT_ENABLED=true
AI_SYSTEM_RISK_CATEGORY=high_risk
AI_SYSTEM_PURPOSE=general_purpose_ai

# GDPR Compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7 years
CONSENT_MANAGEMENT=strict

# Audit and Logging
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=2555
COMPLIANCE_REPORTING=enabled

# ================================
# MONITORING & OBSERVABILITY
# ================================
# Application Monitoring
MONITORING_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
PERFORMANCE_MONITORING=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=structured
LOG_OUTPUT=file
LOG_DIRECTORY=/app/logs

# ================================
# RATE LIMITING & SECURITY
# ================================
# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true
X_FRAME_OPTIONS=DENY

# ================================
# PRODUCTION OPTIMIZATION
# ================================
# Caching
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000
STATIC_CACHE_TTL=86400  # 24 hours

# Connection Pooling
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ================================
# FEATURE FLAGS
# ================================
# Feature Toggles
FEATURE_ADVANCED_REASONING=true
FEATURE_QUANTUM_COMPUTING=true
FEATURE_NEURAL_OPTIMIZATION=true
FEATURE_REAL_TIME_LEARNING=true
FEATURE_MULTI_LANGUAGE_SUPPORT=true

# Beta Features
BETA_FEATURES_ENABLED=false
EXPERIMENTAL_FEATURES=false

# ================================
# HEALTH CHECK CONFIGURATION
# ================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_PATH=/health

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30s
SHUTDOWN_SIGNAL_GRACE_PERIOD=10s