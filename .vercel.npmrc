# Vercel-compatible PNPM Configuration
# Optimized for cloud deployment

# Hoisting configuration for Vercel compatibility  
shamefully-hoist=true
node-linker=hoisted
prefer-symlinked-executables=false
public-hoist-pattern=*
hoist-pattern=*

# Disable symlinks for cloud deployment
symlink=false

# Performance settings
network-concurrency=4
child-concurrency=2
fetch-retries=3
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=10000
strict-peer-dependencies=false

# Workspace settings
link-workspace-packages=true
shared-workspace-lockfile=true
save-workspace-protocol=rolling

# Registry
registry=https://registry.npmjs.org/

# Disable local caching for cloud builds
prefer-offline=false
side-effects-cache=false

# Lockfile settings for deterministic builds
prefer-frozen-lockfile=true
lockfile-include-tarball-url=false

# Auto install peer dependencies
auto-install-peers=true
dedupe-peer-dependents=true

# Package import method for cloud compatibility
package-import-method=copy

# Resolution mode for reproducible builds  
resolution-mode=highest