# RomAI Neural Architecture Orchestrator - Lightweight Build
# Fast-building orchestrator for distributed neural processing
FROM python:3.11-slim

# Set environment variables
ENV PYTHONPATH=/app/romai_src
ENV PYTHONUNBUFFERED=1
ENV ROMAI_LOG_LEVEL=INFO

# Create non-root user
RUN useradd -m -u 1001 -s /bin/bash neural && \
    mkdir -p /app && \
    chown -R neural:neural /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Switch to non-root user
USER neural
WORKDIR /app

# Install Python dependencies (CPU-only for orchestrator)
RUN pip install --no-cache-dir --user \
    torch==2.0.1+cpu \
    torchvision==0.15.2+cpu \
    torchaudio==2.0.2+cpu \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir --user \
    fastapi==0.100.0 \
    uvicorn[standard]==0.23.0 \
    pydantic>=2.0.0 \
    starlette>=0.27.0 \
    numpy>=1.24.0 \
    scipy>=1.10.0 \
    psutil>=5.9.0 \
    requests>=2.31.0 \
    httpx>=0.24.0 \
    structlog>=23.1.0 \
    python-dotenv>=1.0.0 \
    transformers>=4.30.0 \
    sentence-transformers>=2.2.0

# Copy RomAI source code
COPY --chown=neural:neural apps/romai/src /app/romai_src

# Create startup script
RUN echo '#!/bin/bash\n\
echo "🧠 Starting RomAI Neural Architecture Orchestrator..."\n\
echo "🔧 Environment: $ROMAI_LOG_LEVEL"\n\
echo "📂 Python Path: $PYTHONPATH"\n\
cd /app\n\
export PATH="$HOME/.local/bin:$PATH"\n\
python -m romai_src.ml.distributed.neural_architecture_orchestrator serve' > /app/start.sh && \
    chmod +x /app/start.sh

# Health check (using correct port 8800)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8800/health || exit 1

# Expose port (neural orchestrator uses 8800)
EXPOSE 8800

# Start the orchestrator
CMD ["/app/start.sh"]