{
  "name": "@codai/analytics-dashboard",
  "version": "1.0.0",
  "description": "Comprehensive analytics and monitoring dashboard for CODAI ecosystem",
  "type": "module",
  "main": "dashboard.mjs",
  "scripts": {
    "start": "node dashboard.mjs",
    "dev": "node --watch dashboard.mjs",
