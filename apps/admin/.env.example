# ADMIN Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/admin"

# API Configuration  
PORT=3890
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Integration API Keys
GRAFANA_API_ENABLED=false
GRAFANA_API_API_KEY="your-api-key-here"
GRAFANA_API_BASE_URL="https://api.example.com"
PROMETHEUS_API_METRICS_ENABLED=false
PROMETHEUS_API_METRICS_API_KEY="your-api-key-here"
PROMETHEUS_API_METRICS_BASE_URL="https://api.example.com"
DATADOG_ENABLED=false
DATADOG_API_KEY="your-api-key-here"
DATADOG_BASE_URL="https://api.example.com"
WINSTON_ENABLED=false
WINSTON_API_KEY="your-api-key-here"
WINSTON_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false