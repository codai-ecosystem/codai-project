{
    "name": "CODAI Admin Dashboard",
    "short_name": "CODAI Admin",
    "description": "Professional Administration Platform for the CODAI Ecosystem",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#1f2937",
    "theme_color": "#3b82f6",
    "orientation": "portrait-primary",
    "scope": "/",
    "lang": "en",
    "categories": [
        "business",
        "productivity",
        "utilities"
    ],
    "screenshots": [
        {
            "src": "/screenshot-wide.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "CODAI Admin Dashboard - Desktop View"
        },
        {
            "src": "/screenshot-narrow.png",
            "sizes": "390x844",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "CODAI Admin Dashboard - Mobile View"
        }
    ],
    "icons": [
        {
            "src": "/icon-72x72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icon-96x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icon-128x128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icon-144x144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icon-152x152.png",
            "sizes": "152x152",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable any"
        },
        {
            "src": "/icon-384x384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable any"
        }
    ],
    "shortcuts": [
        {
            "name": "Dashboard",
            "short_name": "Dashboard",
            "description": "View admin dashboard",
            "url": "/",
            "icons": [
                {
                    "src": "/icon-dashboard.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Users",
            "short_name": "Users",
            "description": "Manage users",
            "url": "/users",
            "icons": [
                {
                    "src": "/icon-users.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Analytics",
            "short_name": "Analytics",
            "description": "View analytics",
            "url": "/analytics",
            "icons": [
                {
                    "src": "/icon-analytics.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Settings",
            "short_name": "Settings",
            "description": "Application settings",
            "url": "/settings",
            "icons": [
                {
                    "src": "/icon-settings.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "related_applications": [
        {
            "platform": "webapp",
            "url": "https://codai-hub.com/manifest.json"
        },
        {
            "platform": "webapp",
            "url": "https://codai-id.com/manifest.json"
        }
    ],
    "prefer_related_applications": false,
    "edge_side_panel": {
        "preferred_width": 400
    },
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "file_handlers": [
        {
            "action": "/files/",
            "accept": {
                "application/json": [
                    ".json"
                ],
                "text/csv": [
                    ".csv"
                ],
                "application/vnd.ms-excel": [
                    ".xlsx"
                ]
            }
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "codai",
            "url": "/handler?protocol=%s"
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "file",
                    "accept": [
                        "image/*",
                        "application/pdf"
                    ]
                }
            ]
        }
    }
}