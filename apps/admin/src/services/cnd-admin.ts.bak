/**
 * CBD Admin Service for CODAI Admin Dashboard
 * Provides comprehensive user management, RBAC, permissions,
 * and administrative operations using CBD enterprise features
 */

import { CBDClient } from '@codai/cbd';
import { z } from 'zod';

// Admin User schemas
const AdminUserSchema = z.object({
  id: z.string(),
  username: z.string(),
  email: z.string().email(),
  name: z.string(),
  role: z.enum(['super_admin', 'admin', 'manager', 'user', 'guest']),
  permissions: z.array(z.string()),
  department: z.string().optional(),
  status: z.enum(['active', 'inactive', 'suspended', 'pending']).default('active'),
  lastLogin: z.date().optional(),
  preferences: z.record(z.any()).optional(),
  metadata: z.record(z.any()).optional(),
  createdAt: z.date().default(() => new Date()),
  updatedAt: z.date().default(() => new Date())
});

const RoleSchema = z.object({
  id: z.string(),
  name: z.string(),
  description: z.string(),
  permissions: z.array(z.string()),
  level: z.number().min(0).max(100),
  isSystem: z.boolean().default(false),
  createdAt: z.date().default(() => new Date()),
  updatedAt: z.date().default(() => new Date())
});

const PermissionSchema = z.object({
  id: z.string(),
  name: z.string(),
  description: z.string(),
  resource: z.string(),
  action: z.enum(['create', 'read', 'update', 'delete', 'execute', 'manage']),
  scope: z.enum(['global', 'department', 'personal']).default('personal'),
  createdAt: z.date().default(() => new Date())
});

const AdminSessionSchema = z.object({
  id: z.string(),
  userId: z.string(),
  username: z.string(),
  role: z.string(),
  permissions: z.array(z.string()),
  ipAddress: z.string(),
  userAgent: z.string(),
  loginTime: z.date(),
  lastActivity: z.date(),
  expiresAt: z.date(),
  isActive: z.boolean().default(true)
});

const AuditLogSchema = z.object({
  id: z.string(),
  userId: z.string(),
  username: z.string(),
  action: z.string(),
  resource: z.string(),
  resourceId: z.string().optional(),
  details: z.record(z.any()),
  ipAddress: z.string(),
  userAgent: z.string(),
  timestamp: z.date().default(() => new Date()),
  severity: z.enum(['info', 'warning', 'error', 'critical']).default('info')
});

type AdminUser = z.infer<typeof AdminUserSchema>;
type Role = z.infer<typeof RoleSchema>;
type Permission = z.infer<typeof PermissionSchema>;
type AdminSession = z.infer<typeof AdminSessionSchema>;
type AuditLog = z.infer<typeof AuditLogSchema>;

export class CNDAdminService {
  private cnd: CND;
  private isInitialized = false;

  constructor() {
    // Initialize CND with Admin-specific configuration
    const cndConfig = {
      cbd: {
        host: process.env.CBD_HOST || 'localhost',
        port: parseInt(process.env.CBD_PORT || '5000'),
        database: process.env.CBD_DATABASE || 'codai_admin_db'
      },
      enterprise: {
        enabled: true,
        features: {
          serviceDiscovery: true,
          authentication: true,
          authorization: true,
          audit: true,
          monitoring: true
        }
      },
      auth: {
        enabled: true,
        provider: 'internal',
        config: {
          secret: process.env.CND_AUTH_SECRET || 'codai-admin-service-secret'
        }
      },
      serviceDiscovery: {
        enabled: true,
        serviceName: 'codai-admin-service',
        tags: ['admin', 'user-management', 'rbac', 'permissions', 'audit'],
        healthCheckInterval: 30000
      },
      security: {
        audit: {
          enabled: true,
          logLevel: 'detailed',
          storage: 'database',
          retentionDays: 2555 // 7 years for compliance
        }
      },
      performance: {
        monitoring: {
          enabled: true,
          metricsEnabled: true,
          healthChecksEnabled: true,
          customMetrics: {
            'admin_user_actions': 'counter',
            'permission_checks': 'counter',
            'role_assignments': 'counter',
            'audit_logs_created': 'counter',
            'admin_sessions_active': 'gauge',
            'user_management_operations': 'histogram'
          }
        }
      },
      cache: {
        enabled: true,
        ttl: 300 // 5 minutes for admin operations
      },
      logging: {
        enabled: true,
        level: 'info'
      }
    };

    this.cnd = new CND(cndConfig);
  }

  async initialize(): Promise<void> {
    if (this.isInitialized) {
      return;
    }

    try {
      await this.cnd.connect();
      await this.setupDatabase();
      await this.setupDefaultRolesAndPermissions();
      this.isInitialized = true;

      await this.logAudit('admin_service_initialized', {
        service: 'codai-admin-service',
        timestamp: new Date(),
        status: 'success'
      });

      console.log('✅ CND Admin Service initialized successfully');
    } catch (error) {
      console.error('❌ Failed to initialize CND Admin Service:', error);
      throw error;
    }
  }

  private async setupDatabase(): Promise<void> {
    // Create admin users table
    await this.cnd.sql().query(`
      CREATE TABLE IF NOT EXISTS admin_users (
        id VARCHAR(36) PRIMARY KEY,
        username VARCHAR(100) UNIQUE NOT NULL,
        email VARCHAR(255) UNIQUE NOT NULL,
        name VARCHAR(255) NOT NULL,
        role VARCHAR(50) NOT NULL,
        permissions TEXT,
        department VARCHAR(100),
        status VARCHAR(20) DEFAULT 'active',
        last_login DATETIME,
        preferences TEXT,
        metadata TEXT,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
      )
    `);

    // Create roles table
    await this.cnd.sql().query(`
      CREATE TABLE IF NOT EXISTS admin_roles (
        id VARCHAR(36) PRIMARY KEY,
        name VARCHAR(100) UNIQUE NOT NULL,
        description TEXT NOT NULL,
        permissions TEXT NOT NULL,
        level INTEGER NOT NULL,
        is_system BOOLEAN DEFAULT false,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
      )
    `);

    // Create permissions table
    await this.cnd.sql().query(`
      CREATE TABLE IF NOT EXISTS admin_permissions (
        id VARCHAR(36) PRIMARY KEY,
        name VARCHAR(100) UNIQUE NOT NULL,
        description TEXT NOT NULL,
        resource VARCHAR(100) NOT NULL,
        action VARCHAR(20) NOT NULL,
        scope VARCHAR(20) DEFAULT 'personal',
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
      )
    `);

    // Create admin sessions table
    await this.cnd.sql().query(`
      CREATE TABLE IF NOT EXISTS admin_sessions (
        id VARCHAR(36) PRIMARY KEY,
        user_id VARCHAR(36) NOT NULL,
        username VARCHAR(100) NOT NULL,
        role VARCHAR(50) NOT NULL,
        permissions TEXT,
        ip_address VARCHAR(45),
        user_agent TEXT,
        login_time DATETIME NOT NULL,
        last_activity DATETIME NOT NULL,
        expires_at DATETIME NOT NULL,
        is_active BOOLEAN DEFAULT true
      )
    `);

    // Create audit logs table
    await this.cnd.sql().query(`
      CREATE TABLE IF NOT EXISTS admin_audit_logs (
        id VARCHAR(36) PRIMARY KEY,
        user_id VARCHAR(36) NOT NULL,
        username VARCHAR(100) NOT NULL,
        action VARCHAR(100) NOT NULL,
        resource VARCHAR(100) NOT NULL,
        resource_id VARCHAR(36),
        details TEXT NOT NULL,
        ip_address VARCHAR(45),
        user_agent TEXT,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
        severity VARCHAR(20) DEFAULT 'info'
      )
    `);

    // Create system statistics table
    await this.cnd.sql().query(`
      CREATE TABLE IF NOT EXISTS admin_system_stats (
        id VARCHAR(36) PRIMARY KEY,
        stat_name VARCHAR(100) NOT NULL,
        stat_value TEXT NOT NULL,
        category VARCHAR(50) NOT NULL,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
      )
    `);

    console.log('✅ Admin database schema created');
  }

  private async setupDefaultRolesAndPermissions(): Promise<void> {
    // Setup default permissions
    const defaultPermissions = [
      { name: 'users:create', description: 'Create new users', resource: 'users', action: 'create', scope: 'global' },
      { name: 'users:read', description: 'View user information', resource: 'users', action: 'read', scope: 'global' },
      { name: 'users:update', description: 'Update user information', resource: 'users', action: 'update', scope: 'global' },
      { name: 'users:delete', description: 'Delete users', resource: 'users', action: 'delete', scope: 'global' },
      { name: 'roles:manage', description: 'Manage user roles and permissions', resource: 'roles', action: 'manage', scope: 'global' },
      { name: 'audit:read', description: 'View audit logs', resource: 'audit', action: 'read', scope: 'global' },
      { name: 'system:manage', description: 'System administration', resource: 'system', action: 'manage', scope: 'global' },
      { name: 'reports:read', description: 'View system reports', resource: 'reports', action: 'read', scope: 'global' },
      { name: 'settings:manage', description: 'Manage system settings', resource: 'settings', action: 'manage', scope: 'global' }
    ];

    for (const perm of defaultPermissions) {
      const permId = `perm_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
      await this.cnd.sql().query(`
        INSERT OR IGNORE INTO admin_permissions (id, name, description, resource, action, scope, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?)
      `, [
        permId,
        perm.name,
        perm.description,
        perm.resource,
        perm.action,
        perm.scope,
        new Date().toISOString()
      ]);
    }

    // Setup default roles
    const defaultRoles = [
      {
        name: 'super_admin',
        description: 'Super Administrator with full system access',
        permissions: defaultPermissions.map(p => p.name),
        level: 100,
        isSystem: true
      },
      {
        name: 'admin',
        description: 'Administrator with user and system management',
        permissions: ['users:create', 'users:read', 'users:update', 'users:delete', 'roles:manage', 'audit:read', 'reports:read'],
        level: 80,
        isSystem: true
      },
      {
        name: 'manager',
        description: 'Manager with limited administrative capabilities',
        permissions: ['users:read', 'users:update', 'audit:read', 'reports:read'],
        level: 60,
        isSystem: true
      },
      {
        name: 'user',
        description: 'Standard user with basic access',
        permissions: ['users:read'],
        level: 40,
        isSystem: true
      },
      {
        name: 'guest',
        description: 'Guest with minimal access',
        permissions: [],
        level: 0,
        isSystem: true
      }
    ];

    for (const role of defaultRoles) {
      const roleId = `role_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
      await this.cnd.sql().query(`
        INSERT OR IGNORE INTO admin_roles (id, name, description, permissions, level, is_system, created_at, updated_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
      `, [
        roleId,
        role.name,
        role.description,
        JSON.stringify(role.permissions),
        role.level,
        role.isSystem,
        new Date().toISOString(),
        new Date().toISOString()
      ]);
    }

    console.log('✅ Default roles and permissions created');
  }

  // User Management
  async createAdminUser(user: Omit<AdminUser, 'id' | 'createdAt' | 'updatedAt'>): Promise<AdminUser> {
    const userId = `admin_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    const now = new Date();

    const adminUser: AdminUser = {
      ...user,
      id: userId,
      createdAt: now,
      updatedAt: now
    };

    // Validate user data
    const validatedUser = AdminUserSchema.parse(adminUser);

    await this.cnd.sql().query(`
      INSERT INTO admin_users (id, username, email, name, role, permissions, department, status, preferences, metadata, created_at, updated_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      validatedUser.id,
      validatedUser.username,
      validatedUser.email,
      validatedUser.name,
      validatedUser.role,
      JSON.stringify(validatedUser.permissions),
      validatedUser.department || null,
      validatedUser.status,
      JSON.stringify(validatedUser.preferences || {}),
      JSON.stringify(validatedUser.metadata || {}),
      validatedUser.createdAt.toISOString(),
      validatedUser.updatedAt.toISOString()
    ]);

    await this.recordMetric('admin_user_created');
    await this.logAudit('admin_user_created', { userId, username: validatedUser.username, role: validatedUser.role });

    return validatedUser;
  }

  async getAdminUser(userId: string): Promise<AdminUser | null> {
    const result = await this.cnd.sql().query(`
      SELECT * FROM admin_users WHERE id = ?
    `, [userId]);

    if (!result.data || result.data.length === 0) {
      return null;
    }

    const row = result.data[0];
    return {
      id: row.id,
      username: row.username,
      email: row.email,
      name: row.name,
      role: row.role,
      permissions: JSON.parse(row.permissions || '[]'),
      department: row.department,
      status: row.status,
      lastLogin: row.last_login ? new Date(row.last_login) : undefined,
      preferences: row.preferences ? JSON.parse(row.preferences) : {},
      metadata: row.metadata ? JSON.parse(row.metadata) : {},
      createdAt: new Date(row.created_at),
      updatedAt: new Date(row.updated_at)
    };
  }

  async getAllAdminUsers(limit: number = 100): Promise<AdminUser[]> {
    const result = await this.cnd.sql().query(`
      SELECT * FROM admin_users ORDER BY created_at DESC LIMIT ?
    `, [limit]);

    if (!result.data) {
      return [];
    }

    return result.data.map(row => ({
      id: row.id,
      username: row.username,
      email: row.email,
      name: row.name,
      role: row.role,
      permissions: JSON.parse(row.permissions || '[]'),
      department: row.department,
      status: row.status,
      lastLogin: row.last_login ? new Date(row.last_login) : undefined,
      preferences: row.preferences ? JSON.parse(row.preferences) : {},
      metadata: row.metadata ? JSON.parse(row.metadata) : {},
      createdAt: new Date(row.created_at),
      updatedAt: new Date(row.updated_at)
    }));
  }

  async updateAdminUser(userId: string, updates: Partial<AdminUser>): Promise<AdminUser | null> {
    const existingUser = await this.getAdminUser(userId);
    if (!existingUser) {
      return null;
    }

    const updatedUser = { ...existingUser, ...updates, updatedAt: new Date() };
    const validatedUser = AdminUserSchema.parse(updatedUser);

    await this.cnd.sql().query(`
      UPDATE admin_users 
      SET username = ?, email = ?, name = ?, role = ?, permissions = ?, department = ?, 
          status = ?, preferences = ?, metadata = ?, updated_at = ?
      WHERE id = ?
    `, [
      validatedUser.username,
      validatedUser.email,
      validatedUser.name,
      validatedUser.role,
      JSON.stringify(validatedUser.permissions),
      validatedUser.department,
      validatedUser.status,
      JSON.stringify(validatedUser.preferences || {}),
      JSON.stringify(validatedUser.metadata || {}),
      validatedUser.updatedAt.toISOString(),
      userId
    ]);

    await this.recordMetric('admin_user_updated');
    await this.logAudit('admin_user_updated', { userId, changes: updates });

    return validatedUser;
  }

  // Role Management
  async getAllRoles(): Promise<Role[]> {
    const result = await this.cnd.sql().query(`
      SELECT * FROM admin_roles ORDER BY level DESC
    `);

    if (!result.data) {
      return [];
    }

    return result.data.map(row => ({
      id: row.id,
      name: row.name,
      description: row.description,
      permissions: JSON.parse(row.permissions),
      level: row.level,
      isSystem: row.is_system,
      createdAt: new Date(row.created_at),
      updatedAt: new Date(row.updated_at)
    }));
  }

  async getAllPermissions(): Promise<Permission[]> {
    const result = await this.cnd.sql().query(`
      SELECT * FROM admin_permissions ORDER BY resource, action
    `);

    if (!result.data) {
      return [];
    }

    return result.data.map(row => ({
      id: row.id,
      name: row.name,
      description: row.description,
      resource: row.resource,
      action: row.action,
      scope: row.scope,
      createdAt: new Date(row.created_at)
    }));
  }

  // Permission Checking
  async hasPermission(userId: string, permission: string): Promise<boolean> {
    const user = await this.getAdminUser(userId);
    if (!user) return false;

    await this.recordMetric('permission_checks');
    return user.permissions.includes(permission);
  }

  async hasAnyPermission(userId: string, permissions: string[]): Promise<boolean> {
    const user = await this.getAdminUser(userId);
    if (!user) return false;

    await this.recordMetric('permission_checks');
    return permissions.some(perm => user.permissions.includes(perm));
  }

  // Audit Logging
  async logAudit(action: string, details: any, userId?: string, username?: string): Promise<void> {
    const auditId = `audit_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;

    await this.cnd.sql().query(`
      INSERT INTO admin_audit_logs (id, user_id, username, action, resource, details, timestamp)
      VALUES (?, ?, ?, ?, ?, ?, ?)
    `, [
      auditId,
      userId || 'system',
      username || 'system',
      action,
      'admin',
      JSON.stringify(details),
      new Date().toISOString()
    ]);

    await this.recordMetric('audit_logs_created');
  }

  async getAuditLogs(limit: number = 100): Promise<AuditLog[]> {
    const result = await this.cnd.sql().query(`
      SELECT * FROM admin_audit_logs ORDER BY timestamp DESC LIMIT ?
    `, [limit]);

    if (!result.data) {
      return [];
    }

    return result.data.map(row => ({
      id: row.id,
      userId: row.user_id,
      username: row.username,
      action: row.action,
      resource: row.resource,
      resourceId: row.resource_id,
      details: JSON.parse(row.details),
      ipAddress: row.ip_address,
      userAgent: row.user_agent,
      timestamp: new Date(row.timestamp),
      severity: row.severity
    }));
  }

  // System Statistics
  async getSystemStatistics(): Promise<any> {
    const userStatsResult = await this.cnd.sql().query(`
      SELECT 
        COUNT(*) as total_users,
        COUNT(CASE WHEN status = 'active' THEN 1 END) as active_users,
        COUNT(CASE WHEN status = 'inactive' THEN 1 END) as inactive_users,
        COUNT(CASE WHEN role = 'admin' THEN 1 END) as admin_users
      FROM admin_users
    `);

    const roleStatsResult = await this.cnd.sql().query(`
      SELECT name, COUNT(*) as user_count 
      FROM admin_users 
      GROUP BY role
    `);

    const sessionStatsResult = await this.cnd.sql().query(`
      SELECT COUNT(*) as active_sessions
      FROM admin_sessions 
      WHERE is_active = true AND expires_at > ?
    `, [new Date().toISOString()]);

    const auditStatsResult = await this.cnd.sql().query(`
      SELECT COUNT(*) as total_audit_logs
      FROM admin_audit_logs
      WHERE timestamp > ?
    `, [new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString()]); // Last 24 hours

    return {
      users: userStatsResult.data?.[0] || {},
      roleDistribution: roleStatsResult.data || [],
      sessions: sessionStatsResult.data?.[0] || {},
      auditActivity: auditStatsResult.data?.[0] || {}
    };
  }

  // Utility Methods
  private async recordMetric(metricName: string, value: number = 1): Promise<void> {
    try {
      // In a full implementation, this would use the metrics manager
      console.log(`📊 Admin Metric recorded: ${metricName} = ${value}`);
    } catch (error) {
      console.error('Failed to record admin metric:', error);
    }
  }

  // Health and Status Methods
  async getHealthStatus(): Promise<any> {
    const status = await this.cnd.getHealthStatus();

    // Add admin-specific health checks
    const adminStatus = {
      ...status,
      adminFeatures: {
        userManagement: true,
        roleBasedAccess: true,
        permissionSystem: true,
        auditLogging: true,
        systemMonitoring: true
      }
    };

    return adminStatus;
  }

  async getServiceMetrics(): Promise<any> {
    const metrics = this.cnd.getCurrentMetrics();
    const stats = await this.getSystemStatistics();

    return {
      ...metrics,
      adminMetrics: {
        totalUsers: stats.users.total_users || 0,
        activeUsers: stats.users.active_users || 0,
        activeSessions: stats.sessions.active_sessions || 0,
        auditLogsToday: stats.auditActivity.total_audit_logs || 0
      }
    };
  }

  async disconnect(): Promise<void> {
    await this.logAudit('admin_service_disconnected', { timestamp: new Date() });
    await this.cnd.disconnect();
    this.isInitialized = false;
  }
}

// Singleton instance
let cndAdminService: CNDAdminService | null = null;

export function getCNDAdminService(): CNDAdminService {
  if (!cndAdminService) {
    cndAdminService = new CNDAdminService();
  }
  return cndAdminService;
}

export { AdminUser, Role, Permission, AdminSession, AuditLog };
