{
  "name": "@codai/aide-api",
  "version": "1.0.0",
  "description": "AIDE API Server - Backend API service for the CODAI AIDE platform. Provides REST/GraphQL endpoints for project management, user authentication, and ecosystem integration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@codai/shared-types": "workspace:*",
    "@codai/config": "workspace:*",
    "@codai/analytics": "workspace:*",
    "@codai/auth": "workspace:*",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "apollo-server-express": "^3.12.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "zod": "^3.23.8",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "tsx": "^4.7.1",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0",
    "eslint": "^9.11.1"
  }
}