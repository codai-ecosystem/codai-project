# AIDE Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/AIDE"

# API Configuration  
PORT=3034
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Azure OpenAI Configuration (Required)
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Integration API Keys
_TENSORFLOW_TFJS_NODE_ENABLED=false
_TENSORFLOW_TFJS_NODE_API_KEY="your-api-key-here"
_TENSORFLOW_TFJS_NODE_BASE_URL="https://api.example.com"
PYTORCH_ENABLED=false
PYTORCH_API_KEY="your-api-key-here"
PYTORCH_BASE_URL="https://api.example.com"
HUGGINGFACE_ENABLED=false
HUGGINGFACE_API_KEY="your-api-key-here"
HUGGINGFACE_BASE_URL="https://api.example.com"
WANDB_ENABLED=false
WANDB_API_KEY="your-api-key-here"
WANDB_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false