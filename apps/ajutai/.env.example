# AJUTAI Support & Documentation System Environment Configuration
# Copy this to .env and fill in your actual values

# Core Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="AJUTAI"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="http://localhost:4043"

# Azure OpenAI Configuration (Required for AI Chatbot)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-azure-instance.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name_here
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Database Configuration (PostgreSQL for support tickets and knowledge base)
DATABASE_URL=postgresql://username:password@localhost:5432/ajutai_db
DIRECT_URL=postgresql://username:password@localhost:5432/ajutai_db

# Email Configuration (for notifications and ticket updates)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@ajutai.com
SUPPORT_EMAIL=support@ajutai.com

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:4043
NEXTAUTH_SECRET=your_super_secret_key_for_nextauth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Real-time Communications (Socket.IO)
SOCKET_IO_SERVER_URL=http://localhost:4043
SOCKET_IO_PATH=/api/socket

# File Storage (for documentation assets and attachments)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ajutai-documents

# API Keys and Integrations
GITHUB_TOKEN=your_github_token_for_api_docs
DISCORD_WEBHOOK_URL=your_discord_webhook_for_support_alerts
SLACK_WEBHOOK_URL=your_slack_webhook_for_team_notifications
ZENDESK_API_TOKEN=your_zendesk_api_token
INTERCOM_APP_ID=your_intercom_app_id

# Support System Configuration
TICKET_ESCALATION_THRESHOLD=24
SLA_RESPONSE_TIME_HOURS=2
MAX_FILE_UPLOAD_SIZE=10485760
SUPPORTED_FILE_TYPES=pdf,doc,docx,txt,png,jpg,jpeg,gif
AUTO_CLOSE_RESOLVED_TICKETS_DAYS=7

# Documentation Configuration
DOCS_AUTO_GENERATION=true
API_DOCS_ENDPOINT=/api/docs
ENABLE_INTERACTIVE_TUTORIALS=true
ENABLE_VIDEO_CONTENT=true
MULTI_LANGUAGE_SUPPORT=true
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ro,es,fr,de

# Performance and Security
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ENABLE_CONTENT_SECURITY_POLICY=true
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4043
SESSION_TIMEOUT_MINUTES=60

# Logging and Debug
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true
DEBUG_MODE=false

# Feature Flags
ENABLE_AI_CHATBOT=true
ENABLE_VIDEO_CALLS=true
ENABLE_SCREEN_SHARING=false
ENABLE_LIVE_CHAT=true
ENABLE_KNOWLEDGE_BASE_SEARCH=true
ENABLE_TICKET_AUTOMATION=true
ENABLE_CUSTOMER_SATISFACTION_SURVEYS=true