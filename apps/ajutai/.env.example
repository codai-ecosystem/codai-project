# AJUTAI Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/ajutai"

# API Configuration  
PORT=3744
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Integration API Keys
DISCORD.JS_ENABLED=false
DISCORD.JS_API_KEY="your-api-key-here"
DISCORD.JS_BASE_URL="https://api.example.com"
SLACK_SDK_ENABLED=false
SLACK_SDK_API_KEY="your-api-key-here"
SLACK_SDK_BASE_URL="https://api.example.com"
ZENDESK_NODE_API_ENABLED=false
ZENDESK_NODE_API_API_KEY="your-api-key-here"
ZENDESK_NODE_API_BASE_URL="https://api.example.com"
INTERCOM_CLIENT_ENABLED=false
INTERCOM_CLIENT_API_KEY="your-api-key-here"
INTERCOM_CLIENT_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false