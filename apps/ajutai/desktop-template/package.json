{
    "name": "@codai/desktop-template",
    "version": "1.0.0",
    "description": "Modern Electron template for CODAI ecosystem desktop applications",
    "main": "dist/main/index.js",
    "author": "CODAI Team",
    "license": "MIT",
    "homepage": "https://codai.ro",
    "keywords": [
        "codai",
        "desktop",
        "electron",
        "react",
        "typescript",
        "vite"
    ],
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "build:win": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux",
        "build:portable": "electron-builder --win portable",
        "preview": "electron-vite preview",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
        "clean": "rimraf dist coverage test-results"
    },
    "dependencies": {
        "@codai/ui": "workspace:*",
        "@codai/sdk": "workspace:*",
        "@codai/realtime": "workspace:*",
        "@electron-toolkit/utils": "^4.0.0",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.2.4",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-toast": "^1.2.14",
        "@radix-ui/react-tooltip": "^1.2.7",
        "clsx": "^2.1.1",
        "framer-motion": "^11.15.0",
        "lucide-react": "^0.468.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.53.2",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@electron/rebuild": "^3.6.0",
        "@playwright/test": "^1.49.1",
        "@types/node": "^22.10.2",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@typescript-eslint/eslint-plugin": "^8.18.1",
        "@typescript-eslint/parser": "^8.18.1",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^2.1.8",
        "autoprefixer": "^10.4.20",
        "electron": "^28.2.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "postcss": "^8.5.6",
        "prettier": "^3.4.2",
        "rimraf": "^6.0.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vitest": "^2.1.8"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "build": {
        "appId": "ro.codai.desktop-template",
        "productName": "CODAI Desktop",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "resources/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icon.ico",
            "requestedExecutionLevel": "asInvoker"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "resources/icon.icns"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "CODAI Desktop"
        },
        "portable": {
            "artifactName": "CODAI-Desktop-Portable.exe"
        }
    }
}