# ANALIZAI Analytics Platform Environment Configuration

# Application Settings
APP_NAME="ANALIZAI"
APP_DESCRIPTION="AI-Powered Analytics & Insights Platform"
APP_VERSION="1.0.0"
APP_PORT=4071
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="analizai"
NEXT_PUBLIC_APP_URL="http://localhost:4071"
NEXT_PUBLIC_API_URL="/api"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/analizai_db"
SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/analizai_shadow_db"

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars
NEXTAUTH_URL=http://localhost:4071

# Analytics Data Sources
GOOGLE_ANALYTICS_API_KEY=your_ga_api_key_here
GOOGLE_ANALYTICS_VIEW_ID=your_ga_view_id_here
MIXPANEL_PROJECT_TOKEN=your_mixpanel_token_here
AMPLITUDE_API_KEY=your_amplitude_api_key_here

# Business Intelligence Integrations
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Data Processing
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# AI Model Configuration
OPENAI_API_KEY=your_openai_fallback_key_here
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# File Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=analizai-data-storage

# Security & Monitoring
JWT_SECRET=your_jwt_secret_min_64_chars_for_analytics_security
ENCRYPTION_KEY=your_32_char_encryption_key_here
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Email Notifications
SENDGRID_API_KEY=your_sendgrid_api_key_here
NOTIFICATION_EMAIL=alerts@codai.ro

# Rate Limiting & Performance
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CACHE_TTL_SECONDS=3600

# Feature Flags
ENABLE_REAL_TIME_ANALYTICS=true
ENABLE_PREDICTIVE_INSIGHTS=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_AUTOMATED_REPORTS=true
ENABLE_AI_RECOMMENDATIONS=true

# Localization
DEFAULT_LANGUAGE=ro
SUPPORTED_LANGUAGES=en,ro