// ANALIZAI Analytics Platform Database Schema
// Comprehensive analytics, business intelligence, and AI insights

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(ANALYST)
  avatar    String?
  
  // Preferences
  timezone     String  @default("UTC")
  language     String  @default("en")
  theme        String  @default("light")
  
  // Analytics Access
  dashboards      Dashboard[]
  reports         Report[]
  insights        Insight[]
  alertRules      AlertRule[]
  dataConnections DataConnection[]
  
  // Activity
  sessions    AnalyticsSession[]
  queries     Query[]
  annotations Annotation[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
  DATA_SCIENTIST
  BUSINESS_USER
}

model Dashboard {
  id          String   @id @default(cuid())
  name        String
  description String?
  layout      Json     // Widget positions and sizes
  
  // Configuration
  isPublic    Boolean @default(false)
  isTemplate  Boolean @default(false)
  refreshRate Int     @default(300) // seconds
  
  // Ownership
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  
  // Components
  widgets Widget[]
  shares  DashboardShare[]
  
  // Metadata
  tags      String[]
  category  String?
  viewCount Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("dashboards")
}

model Widget {
  id          String     @id @default(cuid())
  name        String
  type        WidgetType
  config      Json       // Chart config, filters, etc.
  position    Json       // x, y, width, height
  
  // Data Source
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id])
  dataSourceId String?
  query        String?     // SQL/Query for data
  
  // Dashboard Relation
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dashboardId String
  
  // Cache
  lastRefresh DateTime?
  cacheData   Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("widgets")
}

enum WidgetType {
  LINE_CHART
  BAR_CHART
  PIE_CHART
  AREA_CHART
  SCATTER_PLOT
  HEATMAP
  TABLE
  METRIC_CARD
  GAUGE
  FUNNEL
  TREEMAP
  HISTOGRAM
  BOX_PLOT
  RADAR_CHART
  SANKEY
  WATERFALL
  MAP
  TEXT
  IMAGE
  AI_INSIGHT
}

model DataSource {
  id          String         @id @default(cuid())
  name        String
  type        DataSourceType
  config      Json           // Connection details, credentials
  
  // Status
  status      DataSourceStatus @default(ACTIVE)
  lastSync    DateTime?
  errorMessage String?
  
  // Relationships
  widgets     Widget[]
  queries     Query[]
  connections DataConnection[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("data_sources")
}

enum DataSourceType {
  POSTGRESQL
  MYSQL
  MONGODB
  GOOGLE_ANALYTICS
  MIXPANEL
  AMPLITUDE
  STRIPE
  REST_API
  CSV_UPLOAD
  ELASTICSEARCH
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
  PENDING
}

model DataConnection {
  id           String     @id @default(cuid())
  name         String
  description  String?
  
  // Connection Details
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id])
  dataSourceId String
  
  // User Access
  user   User   @relation(fields: [userId], references: [id])
  userId String
  
  // Configuration
  config      Json // Specific connection settings
  permissions Json // What user can access
  
  // Status
  isActive   Boolean  @default(true)
  lastUsed   DateTime?
  usageCount Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("data_connections")
}

model Query {
  id          String      @id @default(cuid())
  name        String?
  description String?
  sqlQuery    String
  
  // Execution
  executionTime Float?  // milliseconds
  rowCount      Int?
  status        QueryStatus @default(PENDING)
  errorMessage  String?
  
  // Data Source
  dataSource   DataSource? @relation(fields: [dataSourceId], references: [id])
  dataSourceId String?
  
  // User
  user   User   @relation(fields: [userId], references: [id])
  userId String
  
  // Results
  results Json?
  
  // Metadata
  tags      String[]
  isPublic  Boolean @default(false)
  favorite  Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("queries")
}

enum QueryStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Report {
  id          String     @id @default(cuid())
  name        String
  description String?
  type        ReportType
  
  // Configuration
  config     Json // Report parameters, filters
  schedule   Json? // Cron-like scheduling
  format     ReportFormat @default(PDF)
  
  // Generation
  status        ReportStatus @default(DRAFT)
  lastGenerated DateTime?
  nextRun       DateTime?
  filePath      String?
  fileSize      Int?
  
  // User
  user   User   @relation(fields: [userId], references: [id])
  userId String
  
  // Distribution
  recipients String[] // Email addresses
  deliveries ReportDelivery[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("reports")
}

enum ReportType {
  SCHEDULED
  AD_HOC
  AUTOMATED
  SUBSCRIPTION
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
  JSON
  HTML
  EMAIL
}

enum ReportStatus {
  DRAFT
  ACTIVE
  PAUSED
  FAILED
  ARCHIVED
}

model ReportDelivery {
  id       String   @id @default(cuid())
  
  report   Report   @relation(fields: [reportId], references: [id])
  reportId String
  
  // Delivery Details
  recipient    String
  status       DeliveryStatus
  deliveredAt  DateTime?
  errorMessage String?
  attempts     Int            @default(0)
  
  createdAt DateTime @default(now())
  
  @@map("report_deliveries")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  OPENED
  CLICKED
}

model Insight {
  id          String      @id @default(cuid())
  title       String
  description String
  type        InsightType
  
  // AI Analysis
  confidence   Float // 0-1 confidence score
  significance Float // Statistical significance
  aiModel      String? // Model used for generation
  
  // Data
  metrics     Json   // Key metrics and values
  trends      Json   // Trend analysis
  anomalies   Json   // Detected anomalies
  predictions Json   // Forecast data
  
  // Categorization
  category    String?
  priority    InsightPriority @default(MEDIUM)
  status      InsightStatus   @default(ACTIVE)
  
  // User
  user   User   @relation(fields: [userId], references: [id])
  userId String
  
  // Engagement
  isRead       Boolean @default(false)
  isBookmarked Boolean @default(false)
  feedback     InsightFeedback?
  
  // Validity
  expiresAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("insights")
}

enum InsightType {
  TREND_DETECTION
  ANOMALY_ALERT
  FORECAST
  CORRELATION
  PERFORMANCE_ISSUE
  OPTIMIZATION_OPPORTUNITY
  BUSINESS_RECOMMENDATION
  RISK_ASSESSMENT
  SEASONALITY
  USER_BEHAVIOR
}

enum InsightPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  EXPIRED
}

enum InsightFeedback {
  HELPFUL
  NOT_HELPFUL
  INACCURATE
  IRRELEVANT
}

model AlertRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  
  // Rule Configuration
  metric      String    // Metric to monitor
  condition   Json      // Alert conditions
  threshold   Float     // Alert threshold
  frequency   Int       // Check frequency in minutes
  
  // Status
  isActive    Boolean   @default(true)
  lastCheck   DateTime?
  lastTrigger DateTime?
  triggerCount Int      @default(0)
  
  // User
  user   User   @relation(fields: [userId], references: [id])
  userId String
  
  // Notifications
  channels    AlertChannel[]
  alerts      Alert[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("alert_rules")
}

model AlertChannel {
  id     String      @id @default(cuid())
  type   ChannelType
  config Json        // Channel-specific config (email, webhook URL, etc.)
  
  // Alert Rule
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id])
  alertRuleId String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("alert_channels")
}

enum ChannelType {
  EMAIL
  SMS
  SLACK
  DISCORD
  WEBHOOK
  PUSH_NOTIFICATION
  TEAMS
}

model Alert {
  id      String      @id @default(cuid())
  level   AlertLevel
  message String
  
  // Rule Reference
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id])
  alertRuleId String
  
  // Data
  triggerData Json // Data that triggered the alert
  
  // Status
  status        AlertStatus @default(ACTIVE)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("alerts")
}

enum AlertLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model AnalyticsSession {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  
  // User
  user   User?   @relation(fields: [userId], references: [id])
  userId String?
  
  // Session Data
  ipAddress   String?
  userAgent   String?
  referrer    String?
  country     String?
  city        String?
  device      String?
  browser     String?
  os          String?
  
  // Timing
  startTime DateTime
  endTime   DateTime?
  duration  Int?     // seconds
  
  // Activity
  pageViews Int @default(0)
  events    AnalyticsEvent[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  category  String?
  action    String?
  label     String?
  value     Float?
  
  // Context
  page      String?
  element   String?
  metadata  Json?
  
  // Session
  session   AnalyticsSession @relation(fields: [sessionId], references: [id])
  sessionId String
  
  timestamp DateTime @default(now())
  
  @@map("analytics_events")
}

model Annotation {
  id          String   @id @default(cuid())
  title       String
  description String?
  
  // Positioning
  timestamp DateTime
  dashboard String? // Dashboard ID
  widget    String? // Widget ID
  
  // User
  user   User   @relation(fields: [userId], references: [id])
  userId String
  
  // Metadata
  color String @default("#007bff")
  icon  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("annotations")
}

model DashboardShare {
  id           String    @id @default(cuid())
  token        String    @unique
  expiresAt    DateTime?
  isPublic     Boolean   @default(false)
  permissions  Json      // View, edit permissions
  
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
  dashboardId String
  
  // Usage
  viewCount   Int @default(0)
  lastAccessed DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("dashboard_shares")
}
