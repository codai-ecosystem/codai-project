{
  "name": "bancai-mobile",
  "version": "1.0.0",
  "description": "Mobile banking app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "next start -p 4600",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "next lint",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "rimraf .expo dist coverage",
    "dev": "next dev -p 4600",
    "build": "next build",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@codai/api-keys": "workspace:*",
    "@codai/core": "workspace:*",
    "@codai/logai-integration": "workspace:*",
    "@codai/logai-sdk": "workspace:*",
    "@codai/sdk": "workspace:*",
    "@codai/shared-ui": "workspace:*",
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "expo": "^53.0.19",
    "expo-blur": "^14.1.5",
    "expo-font": "^13.3.2",
    "expo-haptics": "^14.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-notifications": "^0.31.4",
    "expo-router": "^5.1.3",
    "expo-secure-store": "^14.2.3",
    "expo-splash-screen": "^0.30.10",
    "expo-status-bar": "^2.2.3",
    "nativewind": "^4.1.23",
    "react": "^19.1.0",
    "react-native": "^0.80.1",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-svg": "^15.12.0",
    "zustand": "^5.0.6",
    "@codai/shared-ui": "workspace:*",
    "@codai/translations": "workspace:*",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "babel-preset-expo": "^13.2.3",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.0.4",
    "jest-expo": "^53.0.9",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "@types/react-dom": "^19.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-safe-area-context"
      ]
    }
  },
  "private": true
}
