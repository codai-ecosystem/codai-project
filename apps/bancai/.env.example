# BANCAI Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/bancai"

# API Configuration  
PORT=3522
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Integration API Keys
STRIPE_ENABLED=false
STRIPE_API_KEY="your-api-key-here"
STRIPE_BASE_URL="https://api.example.com"
PLAID_ENABLED=false
PLAID_API_KEY="your-api-key-here"
PLAID_BASE_URL="https://api.example.com"
SQUARE_ENABLED=false
SQUARE_API_KEY="your-api-key-here"
SQUARE_BASE_URL="https://api.example.com"
PAYPAL_REST_SDK_ENABLED=false
PAYPAL_REST_SDK_API_KEY="your-api-key-here"
PAYPAL_REST_SDK_BASE_URL="https://api.example.com"
COINBASE_ENABLED=false
COINBASE_API_KEY="your-api-key-here"
COINBASE_BASE_URL="https://api.example.com"
AWS_SDK_ENABLED=false
AWS_SDK_API_KEY="your-api-key-here"
AWS_SDK_BASE_URL="https://api.example.com"
COMPLIANCE_CHECKER_ENABLED=false
COMPLIANCE_CHECKER_API_KEY="your-api-key-here"
COMPLIANCE_CHECKER_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false