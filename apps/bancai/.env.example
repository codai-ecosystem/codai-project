# BANCAI App Environment Configuration
# Copy this to .env.local and configure your values
# This app inherits configuration from the root .env.local file

# ===========================================
# APP-SPECIFIC CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_NAME=BANCAI
NEXT_PUBLIC_APP_VERSION=1.0.0
PORT=3522

# ===========================================
# DATABASE (if app-specific needed)
# ===========================================
# DATABASE_URL=postgresql://localhost:5432/bancai
# Note: Use root DATABASE_URL if shared database

# ===========================================
# BANCAI SECURITY CONFIGURATION (CRITICAL)
# ===========================================
# JWT Secret for session management (generate with: openssl rand -base64 32)
BANCAI_JWT_SECRET=your-super-secure-jwt-secret-key-here-at-least-32-characters

# Data encryption key (generate with: openssl rand -hex 32)
BANCAI_ENCRYPTION_KEY=your-256-bit-encryption-key-in-hex-format-here

# Audit logging directory
BANCAI_AUDIT_LOG_DIR=./logs/audit

# Session configuration
BANCAI_SESSION_DURATION=28800000
BANCAI_SECURE_COOKIES=true

# Rate limiting configuration
BANCAI_RATE_LIMIT_WINDOW=900000
BANCAI_RATE_LIMIT_MAX=100

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3522
JWT_SECRET=your-jwt-secret-here

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false

# ===========================================
# FINANCIAL INTEGRATIONS
# ===========================================
# All API keys inherit from root config
STRIPE_ENABLED=true
PLAID_ENABLED=false
SQUARE_ENABLED=false
PAYPAL_REST_SDK_ENABLED=false
COINBASE_ENABLED=false
AWS_SDK_ENABLED=false
COMPLIANCE_CHECKER_ENABLED=false

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
DEBUG_MODE=true
LOG_LEVEL=info
MONITORING_ENABLED=true

# ===========================================
# CORS & SECURITY
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3522

# ===========================================
# BANKING SPECIFIC SETTINGS (ENHANCED SECURITY)
# ===========================================
TRANSACTION_LIMIT_DAILY=10000
TRANSACTION_LIMIT_MONTHLY=100000
ENABLE_FRAUD_DETECTION=true
ENABLE_KYC_VERIFICATION=true

# PCI DSS compliance settings
BANCAI_PCI_COMPLIANCE=true
BANCAI_FRAUD_DETECTION=true
BANCAI_AUDIT_REQUIRED=true

# Banking operation limits
BANCAI_MAX_TRANSACTION_AMOUNT=1000000
BANCAI_DAILY_TRANSACTION_LIMIT=10
BANCAI_MONTHLY_TRANSACTION_LIMIT=100