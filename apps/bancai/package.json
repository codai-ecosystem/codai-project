{
  "name": "bancai",
  "version": "1.0.0",
  "description": "AI-powered banking platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4005",
    "build": "next build",
    "start": "next start -p 4005",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "next lint",
    "type-check": "pnpm exec tsc --noEmit",
    "build:analyze": "ANALYZE=true next build",
    "build:speed": "SPEED_MEASURE=true next build",
    "build:prod": "NODE_ENV=production next build",
    "build:fast": "NEXT_PHASE=production-server next build",
    "analyze:bundle": "node ../../analysis/bundle-analysis.js",
    "analyze:build": "ANALYZE=true pnpm build",
    "monitor:build": "node ../../lib/build-monitoring/build-monitor.js",
    "cache:clear": "rm -rf .next/cache && rm -rf node_modules/.cache",
    "cache:analyze": "next info",
    "dev:fast": "next dev --turbo",
    "dev:profile": "next dev --profile",
    "start:prod": "NODE_ENV=production next start",
    "preview": "pnpm build && pnpm start",
    "check:all": "pnpm type-check && pnpm lint && pnpm test",
    "check:fast": "pnpm type-check && pnpm lint --fix"
  },
  "dependencies": {
    "@codai/shared-ui": "workspace:*",
    "@codai/logai-sdk": "^1.0.0",
    "@stripe/stripe-js": "^7.5.0",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "next": "^15.4.5",
    "next-auth": "^4.24.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.0",
    "stripe": "^18.3.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "zustand": "^5.0.6",
    "geist": "^1.4.2",
    "react-i18next": "^15.3.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.1",
    "@codai/translations": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4",
    "happy-dom": "^18.0.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "@codai/testing-utils": "workspace:*",
    "i18next-parser": "^9.0.0",
    "@types/react-i18next": "^8.1.0"
  },
  "nextBundleAnalysis": {
    "enabled": true,
    "openAnalyzer": false,
    "analyzerMode": "static",
    "generateStatsFile": true
  }
}