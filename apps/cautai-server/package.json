{
  "name": "@codai/cautai-server",
  "version": "1.0.0",
  "description": "Cautai HTTP Server API - Secure search API with authentication and rate limiting",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "build": "unbuild",
    "build:watch": "unbuild --watch",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "docs": "swagger-jsdoc -d ./swagger.config.js -o ./docs/api.json src/**/*.ts"
  },
  "dependencies": {
    "@codai/cautai-client": "workspace:*",
    "@codai/cautai-config": "workspace:*",
    "@codai/cautai-mcp": "workspace:*",
    "@fastify/auth": "^4.4.0",
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/redis": "^6.1.1",
    "@fastify/sensible": "^5.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@scalar/fastify-api-reference": "^1.24.5",
    "@sinclair/typebox": "^0.32.15",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.1",
    "fastify": "^4.25.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@codai/cautai-i18n": "workspace:*",
    "@playwright/test": "^1.41.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.10",
    "@types/pg": "^8.10.9",
    "eslint": "^8.56.0",
    "playwright": "^1.41.2",
    "rimraf": "^5.0.5",
    "swagger-jsdoc": "^6.2.8",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2",
    "unbuild": "^2.0.0",
    "vitest": "^1.2.2"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "keywords": [
    "api",
    "server",
    "fastify",
    "search",
    "http",
    "rest",
    "authentication",
    "cautai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "apps/cautai-server"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://cautai.ro"
}