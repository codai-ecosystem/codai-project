# CODAI App Environment Configuration
# Copy this to .env.local and configure your values
# This app inherits configuration from the root .env.local file

# ===========================================
# APP-SPECIFIC CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_NAME=CODAI
NEXT_PUBLIC_APP_VERSION=1.0.0
PORT=4001

# ===========================================
# DATABASE (if app-specific needed)
# ===========================================
# DATABASE_URL=postgresql://localhost:5432/codai
# Note: Use root DATABASE_URL if shared database

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:4001

# Keycloak SSO Configuration
KEYCLOAK_CLIENT_ID=codai-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# CODAI ID Enterprise Service
CODAI_ID_URL=http://localhost:4032
CODAI_ID_SERVICE_TOKEN=your-service-token

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false

# ===========================================
# AI PROVIDERS (inherits from root config)
# ===========================================
# These are inherited from root .env.local:
# - AZURE_OPENAI_API_KEY
# - OPENAI_API_KEY
# - ANTHROPIC_API_KEY
DEFAULT_AI_PROVIDER=azure

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
DEBUG_MODE=true
LOG_LEVEL=debug

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:4001/api
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:4001

# ===========================================
# CORS & SECURITY
# ===========================================
CORS_ORIGINS=http://localhost:4001,http://localhost:4032

# ===========================================
# AGENT CONFIGURATION
# ===========================================
AIDE_PERSISTENCE_PATH=./data/memory-graph
AIDE_ENABLE_REACTIVE_UPDATES=true
AIDE_MAX_CONCURRENT_AGENTS=5
AIDE_MESSAGE_TIMEOUT=30000
AIDE_AUTO_ACTIVATE_EXTENSIONS=true
AIDE_ENABLE_COPILOT_INTEGRATION=true

# ===========================================
# SERVICE INTEGRATIONS
# ===========================================
MEMORAI_API_URL=http://localhost:3001
MEMORAI_API_KEY=dev_key_123

# GPT-5 Deployments (New - August 2025)
AZURE_OPENAI_GPT5_DEPLOYMENT=gpt-5
AZURE_OPENAI_GPT5_MINI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_GPT5_NANO_DEPLOYMENT=gpt-5-nano