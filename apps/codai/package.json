{
  "name": "codai",
  "version": "1.0.0",
  "description": "AI-native development environment",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4002",
    "build": "next build",
    "start": "next start -p 4002",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "next lint",
    "type-check": "pnpm exec tsc --noEmit",
    "build:analyze": "ANALYZE=true next build",
    "build:speed": "SPEED_MEASURE=true next build",
    "build:prod": "NODE_ENV=production next build",
    "build:fast": "NEXT_PHASE=production-server next build",
    "analyze:bundle": "node ../../analysis/bundle-analysis.js",
    "analyze:build": "ANALYZE=true pnpm build",
    "monitor:build": "node ../../lib/build-monitoring/build-monitor.js",
    "cache:clear": "rm -rf .next/cache && rm -rf node_modules/.cache",
    "cache:analyze": "next info",
    "dev:fast": "next dev --turbo",
    "dev:profile": "next dev --profile",
    "start:prod": "NODE_ENV=production next start",
    "preview": "pnpm build && pnpm start",
    "check:all": "pnpm type-check && pnpm lint && pnpm test",
    "check:fast": "pnpm type-check && pnpm lint --fix"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.3",
    "@codai/cbd": "^1.0.7",
    "@hookform/resolvers": "^5.1.1",
    "@next/env": "^15.4.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@swc/helpers": "^0.5.17",
    "@tailwindcss/postcss": "^4.1.12",
    "clsx": "^2.1.1",
    "cookie": "^1.0.1",
    "framer-motion": "^12.23.6",
    "i18next": "^25.4.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.1",
    "lucide-react": "^0.525.0",
    "nanoid": "^5.1.5",
    "next": "15.5.0",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "oauth": "^0.10.0",
    "openapi-types": "^12.1.3",
    "openid-client": "^6.2.1",
    "preact": "^10.25.3",
    "preact-render-to-string": "^6.5.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^15.3.0",
    "recharts": "^3.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.6",
    "source-map-js": "^1.2.1",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@types/react-i18next": "^8.1.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^18.0.1",
    "i18next-parser": "^9.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supertest": "^7.1.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "nextBundleAnalysis": {
    "enabled": true,
    "openAnalyzer": false,
    "analyzerMode": "static",
    "generateStatsFile": true
  },
  "main": ".eslintrc.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
