{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["./src/types/*"],
      "@codai/auth": ["../../packages/codai-auth/src"],
      "@codai/auth/*": ["../../packages/codai-auth/src/*"]
    },
    "types": ["node", "react", "react-dom"],
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx", 
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "config/**/*.ts",
    "middleware.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "scripts/**/*",
    "*.js",
    "**/*.js",
    "!src/tailwind-rtl-plugin.js",
    "vitest.setup.ts",
    "vitest.config.ts",
    "vitest.*.ts",
    "playwright.config.ts",
    "next.config.js",
    "next.config.ts",
    "postcss.config.js",
    "postcss.config.ts",
    "tailwind.config.ts",
    "eslint.config.js",
    ".eslintrc.js",
    "gulpfile.js",
    "jest.setup.js",
    "server.js",
    "simple-server.js",
    "health.js",
    "empty-module.js",
    "demo-cnd-ai-service.js",
    "next-i18n.config.js",
    "tests/**/*.js"
  ]
}
