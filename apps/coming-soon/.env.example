# Environment Configuration for CODAI Coming Soon Page
# Copy this file to .env.local for development
# For production, set these in your deployment platform

# Application Configuration
NEXT_PUBLIC_APP_NAME=CODAI Coming Soon
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://coming-soon.codai.com
NODE_ENV=production

# Deployment Configuration
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_TOKEN=your-vercel-token

# Analytics & Monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=coming-soon
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Core Web Vitals Monitoring
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=/api/metrics
NEXT_PUBLIC_PERFORMANCE_MONITORING_ENABLED=true

# Error Tracking
NEXT_PUBLIC_ERROR_REPORTING_ENABLED=true
ERROR_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Alerting Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/alert/webhook
ALERT_EMAIL_RECIPIENTS=alerts@codai.com,devops@codai.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Feature Flags
NEXT_PUBLIC_ENABLE_ANIMATIONS=true
NEXT_PUBLIC_ENABLE_I18N=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_SHOW_DEVELOPMENT_TOOLS=false

# Security
NEXT_PUBLIC_CSP_NONCE_ENABLED=true
CORS_ALLOWED_ORIGINS=https://codai.com,https://www.codai.com

# Database (if needed for waitlist/analytics)
DATABASE_URL=postgresql://username:password@host:5432/database
REDIS_URL=redis://localhost:6379

# Content Delivery Network
NEXT_PUBLIC_CDN_URL=https://cdn.codai.com
NEXT_PUBLIC_IMAGES_DOMAIN=images.codai.com

# Email Service (for waitlist notifications)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM_ADDRESS=noreply@codai.com
EMAIL_FROM_NAME=CODAI Team

# Social Media Integration
NEXT_PUBLIC_TWITTER_HANDLE=@codaicom
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/codai
NEXT_PUBLIC_GITHUB_ORG=https://github.com/codai-org

# Rate Limiting (for waitlist/contact forms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Lighthouse CI (for performance monitoring)
LHCI_GITHUB_APP_TOKEN=your-lighthouse-ci-token
LHCI_SERVER_BASE_URL=https://your-lighthouse-ci-server.com

# Testing Configuration
PLAYWRIGHT_BASE_URL=https://staging.coming-soon.codai.com
E2E_TEST_EMAIL=test@codai.com

# Build Configuration
ANALYZE_BUNDLE=false
NEXT_TELEMETRY_DISABLED=1
SKIP_ENV_VALIDATION=false

# Maintenance Mode
NEXT_PUBLIC_MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We're performing scheduled maintenance. Please check back soon.

# API Configuration  
API_RATE_LIMIT_PER_MINUTE=60
API_TIMEOUT_MS=30000

# Caching
CACHE_MAX_AGE=3600
STATIC_CACHE_MAX_AGE=31536000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Development Tools
NEXT_PUBLIC_SHOW_PERFORMANCE_METRICS=false
NEXT_PUBLIC_SHOW_DEBUG_INFO=false