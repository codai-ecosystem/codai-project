{
    "name": "codai-coming-soon",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --port 5001",
        "build": "next build",
        "build:analyze": "ANALYZE=true next build",
        "start": "next start --port 5001",
        "start:prod": "NODE_ENV=production next start --port 3000",
        "export": "next export",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ci": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:all": "npm run test:ci && npm run test:e2e",
        "test:comprehensive": "node run-tests.js",
        "test:unit": "vitest run --testNamePattern=\"(components|utils|hooks)\" --reporter=verbose",
        "test:integration": "vitest run --testNamePattern=\"integration\" --reporter=verbose",
        "test:accessibility": "vitest run --testNamePattern=\"accessibility\" --reporter=verbose",
        "test:performance": "vitest run --testNamePattern=\"performance\" --reporter=verbose",
        "test:responsive": "vitest run --testNamePattern=\"responsive\" --reporter=verbose",
        "validate": "npm run type-check && npm run lint && npm run test:ci",
        "lighthouse": "lhci autorun",
        "lighthouse:desktop": "lighthouse --chrome-flags=\"--headless\" --output=json --output-path=./lighthouse-results.json http://localhost:3000",
        "performance": "npm run build && npm run lighthouse",
        "deploy": "vercel --prod",
        "deploy:preview": "vercel"
    },
    "dependencies": {
        "next": "^15.0.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "clsx": "^2.1.1",
        "tailwind-merge": "^2.5.4",
        "lucide-react": "^0.469.0",
        "framer-motion": "^11.0.0",
        "react-i18next": "^15.0.0",
        "i18next": "^25.4.1",
        "react-intersection-observer": "^9.13.1",
        "i18next-browser-languagedetector": "^8.0.0",
        "gsap": "^3.12.2"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-next": "^15.0.0",
        "postcss": "^8.5.1",
        "tailwindcss": "^3.4.14",
        "typescript": "^5.0.0",
        "@testing-library/jest-dom": "^6.1.4",
        "@testing-library/react": "^15.0.0",
        "@testing-library/user-event": "^14.5.1",
        "@playwright/test": "^1.48.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "webpack-bundle-analyzer": "^4.10.1",
        "@lhci/cli": "^0.13.0",
        "lighthouse": "^11.4.0",
        "@heroicons/react": "^2.0.0",
        "@vitejs/plugin-react": "^4.2.1",
        "vitest": "^1.2.2",
        "@vitest/ui": "^1.2.2",
        "jsdom": "^24.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}