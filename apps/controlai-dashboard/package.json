{
  "name": "controlai-dashboard",
  "version": "1.0.0",
  "description": "Real-time dashboard for ControlAI MCP project management and coordination",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:accessibility": "playwright test tests/accessibility",
    "test:performance": "playwright test tests/performance",
    "test:all": "pnpm test && pnpm test:e2e",
    "playwright:install": "playwright install",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rimraf .next dist coverage test-results playwright-report",
    "build:analyze": "ANALYZE=true next build",
    "build:speed": "SPEED_MEASURE=true next build",
    "build:prod": "NODE_ENV=production next build",
    "build:fast": "next build",
    "analyze:bundle": "node ../../analysis/bundle-analysis.js",
    "analyze:build": "ANALYZE=true pnpm build",
    "monitor:build": "node ../../lib/build-monitoring/build-monitor.js",
    "cache:clear": "rimraf .next/cache node_modules/.cache",
    "cache:analyze": "next info",
    "dev:fast": "next dev --turbo",
    "dev:profile": "next dev --profile",
    "start:prod": "NODE_ENV=production next start",
    "preview": "pnpm build && pnpm start",
    "check:all": "pnpm type-check && pnpm lint && pnpm test",
    "check:fast": "pnpm type-check && pnpm lint --fix"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "framer-motion": "^11.15.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.536.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "recharts": "^2.8.0",
    "socket.io-client": "^4.7.5",
    "sonner": "^1.4.3",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2",
    "react-i18next": "^15.3.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.1",
    "@codai/translations": "workspace:*"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.1.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "@codai/testing-utils": "workspace:*",
    "i18next-parser": "^9.0.0",
    "@types/react-i18next": "^8.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "nextBundleAnalysis": {
    "enabled": true,
    "openAnalyzer": false,
    "analyzerMode": "static",
    "generateStatsFile": true
  }
}