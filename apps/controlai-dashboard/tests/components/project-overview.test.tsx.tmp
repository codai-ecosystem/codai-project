import React from 'react'
import { describe, it, expect, vi, beforeEach } from 'vitest'
import { render, screen, fireEvent, waitFor } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import ProjectOverview from '../../src/components/ProjectOverview'
import { TEST_TIMEOUT } from '../setup'

const mockDashboardData = {
  metrics: {
    totalProjects: 12,
    totalAgents: 8,
    activeTasks: 24,
    completedTasks: 156,
    agentUtilization: 78,
    systemHealth: 95
  },
  projects: [
    {
      id: 'proj-1',
      name: 'CODAI Ecosystem Enhancement',
      description: 'Comprehensive testing and quality improvements for the CODAI ecosystem',
      status: 'active' as const,
      progress: 85,
      teamSize: 6,
      tasks: [],
      createdAt: '2025-01-30T10:00:00Z'
    },
    {
      id: 'proj-2',
      name: 'Authentication Security Audit',
      description: 'Complete security overhaul of authentication systems',
      status: 'completed' as const,
      progress: 100,
      teamSize: 4,
      tasks: [],
      createdAt: '2025-01-15T14:30:00Z'
    },
    {
      id: 'proj-3',
      name: 'Frontend Testing Initiative',
      description: 'Comprehensive testing for all frontend applications',
      status: 'planning' as const,
      progress: 15,
      teamSize: 3,
      tasks: [],
      createdAt: '2025-02-01T09:15:00Z'
    }
  ],
  agents: [],
  tasks: []
}

describe('ProjectOverview Component', () => {
  beforeEach(() => {
    vi.clearAllMocks()
  })

  describe('Component Rendering', () => {
    it('should render projects overview title', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByRole('heading', { level: 2 })).toHaveTextContent('Projects Overview')
    }, TEST_TIMEOUT)

    it('should render all statistics cards', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('Total Projects')).toBeInTheDocument()
      expect(screen.getByText('Active Teams')).toBeInTheDocument()
      expect(screen.getByText('Avg Progress')).toBeInTheDocument()
      expect(screen.getByText('Completed')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should display correct statistics values', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('12')).toBeInTheDocument() // Total Projects
      expect(screen.getByText('8')).toBeInTheDocument() // Active Teams
      expect(screen.getByText('67%')).toBeInTheDocument() // Avg Progress (85+100+15)/3 = 67%
      expect(screen.getByText('1')).toBeInTheDocument() // Completed projects
    }, TEST_TIMEOUT)

    it('should render project list section', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('Recent Projects')).toBeInTheDocument()
    }, TEST_TIMEOUT)
  })

  describe('Statistics Cards', () => {
    it('should render project statistics with correct icons', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      // Check for icon presence using test IDs
      expect(screen.getByTestId('folder-kanban-icon')).toBeInTheDocument()
      expect(screen.getByTestId('users-icon')).toBeInTheDocument()
      expect(screen.getByTestId('clock-icon')).toBeInTheDocument()
      expect(screen.getByTestId('check-circle-icon')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should calculate average progress correctly', () => {
      const customData = {
        ...mockDashboardData,
        projects: [
          { ...mockDashboardData.projects[0], progress: 50 },
          { ...mockDashboardData.projects[1], progress: 100 },
          { ...mockDashboardData.projects[2], progress: 0 }
        ]
      }
      
      render(<ProjectOverview data={customData} />)
      
      // (50 + 100 + 0) / 3 = 50%
      expect(screen.getByText('50%')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should count completed projects correctly', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      // Only one project has status 'completed'
      expect(screen.getByText('1')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should handle zero projects gracefully', () => {
      const emptyData = {
        ...mockDashboardData,
        projects: []
      }
      
      render(<ProjectOverview data={emptyData} />)
      
      expect(screen.getByText('0')).toBeInTheDocument() // Total Projects
      expect(screen.getByText('0%')).toBeInTheDocument() // Avg Progress
    }, TEST_TIMEOUT)
  })

  describe('Project List', () => {
    it('should render all projects in the list', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('CODAI Ecosystem Enhancement')).toBeInTheDocument()
      expect(screen.getByText('Authentication Security Audit')).toBeInTheDocument()
      expect(screen.getByText('Frontend Testing Initiative')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should display project descriptions', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('Comprehensive testing and quality improvements for the CODAI ecosystem')).toBeInTheDocument()
      expect(screen.getByText('Complete security overhaul of authentication systems')).toBeInTheDocument()
      expect(screen.getByText('Comprehensive testing for all frontend applications')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should show project progress bars', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      // Check for progress percentages
      expect(screen.getByText('85%')).toBeInTheDocument()
      expect(screen.getByText('100%')).toBeInTheDocument()
      expect(screen.getByText('15%')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should display team sizes', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('6 members')).toBeInTheDocument()
      expect(screen.getByText('4 members')).toBeInTheDocument()
      expect(screen.getByText('3 members')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should show correct status badges', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('Active')).toBeInTheDocument()
      expect(screen.getByText('Completed')).toBeInTheDocument()
      expect(screen.getByText('Planning')).toBeInTheDocument()
    }, TEST_TIMEOUT)
  })

  describe('Status Badge Styling', () => {
    it('should apply correct styles for active status', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const activeBadge = screen.getByText('Active')
      expect(activeBadge).toHaveClass('bg-green-100', 'text-green-800')
    }, TEST_TIMEOUT)

    it('should apply correct styles for completed status', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const completedBadge = screen.getByText('Completed')
      expect(completedBadge).toHaveClass('bg-blue-100', 'text-blue-800')
    }, TEST_TIMEOUT)

    it('should apply correct styles for planning status', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const planningBadge = screen.getByText('Planning')
      expect(planningBadge).toHaveClass('bg-yellow-100', 'text-yellow-800')
    }, TEST_TIMEOUT)

    it('should handle unknown status gracefully', () => {
      const dataWithUnknownStatus = {
        ...mockDashboardData,
        projects: [{
          ...mockDashboardData.projects[0],
          status: 'unknown' as any
        }]
      }
      
      render(<ProjectOverview data={dataWithUnknownStatus} />)
      
      const unknownBadge = screen.getByText('unknown')
      expect(unknownBadge).toHaveClass('bg-gray-100', 'text-gray-800')
    }, TEST_TIMEOUT)
  })

  describe('Progress Bars', () => {
    it('should render progress bars with correct values', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const progressBars = screen.getAllByRole('progressbar')
      expect(progressBars).toHaveLength(3)
      
      // Check aria-valuenow attributes
      expect(progressBars[0]).toHaveAttribute('aria-valuenow', '85')
      expect(progressBars[1]).toHaveAttribute('aria-valuenow', '100')
      expect(progressBars[2]).toHaveAttribute('aria-valuenow', '15')
    }, TEST_TIMEOUT)

    it('should have proper accessibility attributes', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const progressBars = screen.getAllByRole('progressbar')
      
      progressBars.forEach(progressBar => {
        expect(progressBar).toHaveAttribute('aria-valuemin', '0')
        expect(progressBar).toHaveAttribute('aria-valuemax', '100')
      })
    }, TEST_TIMEOUT)

    it('should handle edge cases for progress values', () => {
      const edgeCaseData = {
        ...mockDashboardData,
        projects: [
          { ...mockDashboardData.projects[0], progress: 0 },
          { ...mockDashboardData.projects[1], progress: 100 },
          { ...mockDashboardData.projects[2], progress: 50 }
        ]
      }
      
      render(<ProjectOverview data={edgeCaseData} />)
      
      expect(screen.getByText('0%')).toBeInTheDocument()
      expect(screen.getByText('100%')).toBeInTheDocument()
      expect(screen.getByText('50%')).toBeInTheDocument()
    }, TEST_TIMEOUT)
  })

  describe('Responsive Design', () => {
    it('should render properly on mobile devices', () => {
      Object.defineProperty(window, 'innerWidth', {
        writable: true,
        configurable: true,
        value: 375,
      })
      
      render(<ProjectOverview data={mockDashboardData} />)
      
      expect(screen.getByText('Projects Overview')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should adapt grid layout for different screen sizes', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const statsGrid = document.querySelector('.grid')
      expect(statsGrid).toHaveClass('grid-cols-1', 'md:grid-cols-2', 'lg:grid-cols-4')
    }, TEST_TIMEOUT)
  })

  describe('Accessibility', () => {
    it('should have proper heading hierarchy', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const mainHeading = screen.getByRole('heading', { level: 2 })
      expect(mainHeading).toHaveTextContent('Projects Overview')
      
      const sectionHeading = screen.getByRole('heading', { level: 3 })
      expect(sectionHeading).toHaveTextContent('Recent Projects')
    }, TEST_TIMEOUT)

    it('should have proper ARIA labels for statistics', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      // Check for accessible text content
      expect(screen.getByText('Total Projects')).toBeInTheDocument()
      expect(screen.getByText('Active Teams')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should support keyboard navigation', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      // All interactive elements should be keyboard accessible
      const interactiveElements = screen.getAllByRole('button', { hidden: true })
      // Since this is primarily a display component, there might be no buttons
      // but the component should still be accessible via screen readers
      
      expect(screen.getByText('Projects Overview')).toBeInTheDocument()
    }, TEST_TIMEOUT)
  })

  describe('Data Handling', () => {
    it('should handle null dashboard data gracefully', () => {
      const nullData = {
        metrics: { totalProjects: 0, totalAgents: 0 },
        projects: [],
        agents: [],
        tasks: []
      }
      
      render(<ProjectOverview data={nullData} />)
      
      expect(screen.getByText('No projects found')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should handle missing project properties', () => {
      const incompleteData = {
        ...mockDashboardData,
        projects: [{
          id: 'incomplete',
          name: 'Incomplete Project',
          description: '',
          status: 'active' as const,
          progress: 0,
          teamSize: 0,
          tasks: [],
          createdAt: ''
        }]
      }
      
      render(<ProjectOverview data={incompleteData} />)
      
      expect(screen.getByText('Incomplete Project')).toBeInTheDocument()
      expect(screen.getByText('0 members')).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should format dates correctly', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      // Check that dates are displayed (exact format depends on implementation)
      const projectCards = screen.getAllByRole('article', { hidden: true })
      expect(projectCards.length).toBeGreaterThan(0)
    }, TEST_TIMEOUT)
  })

  describe('Performance', () => {
    it('should not cause memory leaks on unmount', () => {
      const { unmount } = render(<ProjectOverview data={mockDashboardData} />)
      
      expect(() => unmount()).not.toThrow()
    }, TEST_TIMEOUT)

    it('should handle large datasets efficiently', () => {
      const largeDataset = {
        ...mockDashboardData,
        projects: Array.from({ length: 100 }, (_, i) => ({
          id: `proj-${i}`,
          name: `Project ${i}`,
          description: `Description for project ${i}`,
          status: 'active' as const,
          progress: Math.floor(Math.random() * 100),
          teamSize: Math.floor(Math.random() * 10) + 1,
          tasks: [],
          createdAt: new Date().toISOString()
        }))
      }
      
      const startTime = performance.now()
      render(<ProjectOverview data={largeDataset} />)
      const endTime = performance.now()
      
      // Should render within reasonable time (less than 100ms)
      expect(endTime - startTime).toBeLessThan(100)
    }, TEST_TIMEOUT)
  })

  describe('Visual Design', () => {
    it('should apply correct Tailwind CSS classes', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const container = document.querySelector('.space-y-6')
      expect(container).toBeInTheDocument()
    }, TEST_TIMEOUT)

    it('should have consistent spacing and layout', () => {
      render(<ProjectOverview data={mockDashboardData} />)
      
      const statsCards = screen.getAllByRole('heading', { level: 4 })
      expect(statsCards.length).toBe(4)
    }, TEST_TIMEOUT)
  })
})
