{
  "name": "conversai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AI conversation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 4700",
    "build": "next build",
    "start": "next start -p 4700",
    "lint": "next lint",
    "test": "vitest",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "pnpm --filter @codai/conversai-web clean",
    "dev:api": "pnpm --filter @codai/conversai-api dev",
    "dev:mobile": "pnpm --filter @codai/conversai-mobile start",
    "setup": "pnpm install",
    "setup:web": "pnpm --filter @codai/conversai-web install",
    "setup:api": "pnpm --filter @codai/conversai-api install",
    "setup:mobile": "pnpm --filter @codai/conversai-mobile install",
    "clean:all": "pnpm -r clean && rimraf node_modules",
    "install:all": "pnpm install",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "zod": "^4.0.5",
    "zustand": "^5.0.6",
    "next": "^15.4.1",
    "geist": "^1.4.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.1.13",
    "@radix-ui/react-tabs": "^1.1.2",
    "date-fns": "^4.1.0",
    "react-hot-toast": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "email",
    "ai",
    "codai",
    "romanian",
    "professional",
    "communication"
  ],
  "author": "CODAI Ecosystem",
  "license": "MIT"
}