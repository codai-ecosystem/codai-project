rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write access to dictionary entries (for development)
    match /dictionary_entries/{document} {
      allow read, write: if true;
    }
    
    // Allow read and write access to search logs (for analytics)
    match /search_logs/{document} {
      allow read, write: if true;
    }
    
    // Allow read and write access to user favorites (for future use)
    match /user_favorites/{document} {
      allow read, write: if true;
    }
    
    // Allow read and write access to statistics
    match /statistics/{document} {
      allow read, write: if true;
    }
    
    // Allow read and write access to admin collections
    match /admin/{document} {
      allow read, write: if true;
    }
    
    // Default deny all other collections for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
