{
  "name": "dexai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 5013",
    "build": "next build",
    "start": "next start -p 5013",
    "lint": "next lint",
    "test": "pnpm --filter @codai/dexai-web test",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "pnpm --filter @codai/dexai-web clean",
    "dev:mobile": "pnpm --filter mobile start",
    "setup": "pnpm install",
    "setup:web": "pnpm --filter @codai/dexai-web install",
    "setup:mobile": "pnpm --filter mobile install",
    "clean:all": "pnpm -r clean && rimraf node_modules",
    "install:all": "pnpm install"
  },
  "dependencies": {
    "@codai/logai-universal": "^2.0.0",
    "@hookform/resolvers": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "zod": "^4.0.5",
    "zustand": "^5.0.6",
    "next": "^15.4.1",
    "geist": "^1.4.2",
    "@codai/shared-ui": "workspace:*",
    "@codai/translations": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "AI data exchange platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/dexai.git"
  },
  "author": "Your Name",
  "license": "MIT"
}
