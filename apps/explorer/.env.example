# EXPLORER Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/explorer"

# API Configuration  
PORT=3511
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Integration API Keys
WEB3_ENABLED=false
WEB3_API_KEY="your-api-key-here"
WEB3_BASE_URL="https://api.example.com"
AXIOS_ENABLED=false
AXIOS_API_KEY="your-api-key-here"
AXIOS_BASE_URL="https://api.example.com"
CHART.JS_ENABLED=false
CHART.JS_API_KEY="your-api-key-here"
CHART.JS_BASE_URL="https://api.example.com"
D3_ENABLED=false
D3_API_KEY="your-api-key-here"
D3_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false