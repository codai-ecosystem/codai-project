# Environment Configuration for CODAI API Gateway

# Gateway Configuration
GATEWAY_PORT=4003
JWT_SECRET=your-jwt-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:4003,https://codai.ro,https://id.codai.ro

# Rate Limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Service URLs - Core Services
ID_SERVICE_URL=http://localhost:4004
MEMORAI_SERVICE_URL=http://localhost:4006
HUB_SERVICE_URL=http://localhost:4008
ADMIN_SERVICE_URL=http://localhost:4007
CBD_SERVICE_URL=http://localhost:4180

# Service URLs - Business Platform Services
CODAI_SERVICE_URL=http://localhost:4001
BANCAI_SERVICE_URL=http://localhost:4005
CONTROLAI_SERVICE_URL=http://localhost:4200
ROMAI_SERVICE_URL=http://localhost:6100

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
HELMET_ENABLED=true
CORS_ENABLED=true
COMPRESSION_ENABLED=true

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=4099
