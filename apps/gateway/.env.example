# Environment Configuration for CODAI API Gateway

# Gateway Configuration
GATEWAY_PORT=4000
JWT_SECRET=your-jwt-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,https://codai.ro,https://id.codai.ro

# Rate Limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Service URLs - Core Services
ID_SERVICE_URL=http://localhost:4001
MEMORAI_SERVICE_URL=http://localhost:4002
HUB_SERVICE_URL=http://localhost:4003
LOGAI_SERVICE_URL=http://localhost:4004
ADMIN_SERVICE_URL=http://localhost:4005

# Service URLs - Business Platform Services
CODAI_SERVICE_URL=http://localhost:4006
BANCAI_SERVICE_URL=http://localhost:4007
CUMPARAI_SERVICE_URL=http://localhost:4008
WALLET_SERVICE_URL=http://localhost:4009
MARKETAI_SERVICE_URL=http://localhost:4010
FABRICAI_SERVICE_URL=http://localhost:4011

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
HELMET_ENABLED=true
CORS_ENABLED=true
COMPRESSION_ENABLED=true

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=4099
