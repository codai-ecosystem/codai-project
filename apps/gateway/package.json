{
    "name": "@codai/gateway",
    "version": "2.0.0",
    "description": "CODAI Ecosystem API Gateway - Production-ready centralized routing and management for all CODAI services",
    "main": "dist/api-gateway.js",
    "types": "dist/api-gateway.d.ts",
    "scripts": {
        "build": "tsc",
        "build:working": "tsc --project tsconfig-working.json",
        "start": "node dist/api-gateway.js",
        "start:working": "node dist/gateway-working.js",
        "dev": "ts-node-dev --respawn --transpile-only src/api-gateway.ts",
        "dev:working": "ts-node-dev --respawn --transpile-only src/gateway-working.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts tests/**/*.ts",
        "type-check": "tsc --noEmit",
        "type-check:working": "tsc src/gateway-working.ts --noEmit --target ES2020 --module commonjs --esModuleInterop --strict --skipLibCheck"
    },
    "keywords": [
        "api-gateway",
        "microservices",
        "routing",
        "codai",
        "ecosystem"
    ],
    "author": "CODAI Team",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "http-proxy-middleware": "^2.0.6",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "cors": "^2.8.5",
        "compression": "^1.7.4",
        "jsonwebtoken": "^9.0.2",
        "swagger-ui-express": "^5.0.0",
        "zod": "^3.22.4",
        "winston": "^3.11.0",
        "prom-client": "^15.1.0",
        "@codai/api-standards": "workspace:*",
        "@codai/security": "workspace:*"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/compression": "^1.7.5",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/node": "^20.10.4",
        "@types/jest": "^29.5.8",
        "@types/supertest": "^6.0.2",
        "typescript": "^5.3.3",
        "ts-node-dev": "^2.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "supertest": "^6.3.4",
        "eslint": "^8.55.0",
        "@typescript-eslint/eslint-plugin": "^6.13.2",
        "@typescript-eslint/parser": "^6.13.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}