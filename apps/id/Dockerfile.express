FROM node:20-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Create app directory
WORKDIR /app

# Create simple package.json
RUN echo '{"name":"codai-id-service","version":"1.0.0","dependencies":{"express":"^4.18.2","cors":"^2.8.5"}}' > package.json

# Install dependencies
RUN npm install --production

# Copy service file
COPY id.service.js .

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S codai -u 1001

# Change to non-root user
USER codai

# Expose port
EXPOSE 4004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:4004/api/health || exit 1

# Start the service
CMD ["node", "id.service.js"]