# Enterprise Environment Configuration
# Production-ready settings for CODAI ID System

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Primary PostgreSQL Database
DATABASE_URL=postgresql://codai_user:${POSTGRES_PASSWORD}@postgres-primary:5432/codai_id
DATABASE_READ_URL=postgresql://codai_user:${POSTGRES_PASSWORD}@postgres-replica:5432/codai_id

# Connection Pooling
PGBOUNCER_URL=postgresql://codai_user:${POSTGRES_PASSWORD}@pgbouncer:5432/codai_id

# Database Credentials
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_REPLICATION_PASSWORD=your_replication_password_here

# ===========================================
# KEYCLOAK SSO CONFIGURATION
# ===========================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=codai-ecosystem
KEYCLOAK_CLIENT_ID=codai-id
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_DB_PASSWORD=your_keycloak_db_password_here
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_redis_password_here
SESSION_STORE_URL=redis://redis:6379/0

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your_super_secure_jwt_secret_256_bits_minimum
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=codai-id-service
JWT_AUDIENCE=codai-ecosystem

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_minimum
NEXTAUTH_URL=http://localhost:4800

# ===========================================
# MFA CONFIGURATION
# ===========================================
# TOTP Settings
MFA_TOTP_ISSUER=CODAI Ecosystem
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD=30

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Provider (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@codai.ro

# ===========================================
# OAUTH PROVIDERS
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_CLIENT_SECRET=your_azure_client_secret
AZURE_AD_TENANT_ID=your_azure_tenant_id

# ===========================================
# ENCRYPTION & SECURITY
# ===========================================
# Data Encryption
DATA_ENCRYPTION_KEY=your_32_byte_encryption_key_here
AES_ENCRYPTION_IV=your_16_byte_iv_here

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=false

# ===========================================
# AUDIT & LOGGING
# ===========================================
# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=codai-id-audit

# Log Levels
LOG_LEVEL=info
AUDIT_LOG_LEVEL=info
SECURITY_LOG_LEVEL=warn

# ===========================================
# BIOMETRIC AUTHENTICATION
# ===========================================
# Face Recognition Service
FACE_RECOGNITION_API_URL=http://face-recognition-service:8081
FACE_RECOGNITION_API_KEY=your_face_api_key

# Fingerprint Service
FINGERPRINT_SERVICE_URL=http://fingerprint-service:8082
FINGERPRINT_API_KEY=your_fingerprint_api_key

# ===========================================
# COMPLIANCE & GDPR
# ===========================================
# Data Retention
DATA_RETENTION_PERIOD=7 years
AUDIT_LOG_RETENTION=10 years
SESSION_RETENTION=30 days

# GDPR Settings
GDPR_ENABLED=true
DATA_EXPORT_ENABLED=true
RIGHT_TO_BE_FORGOTTEN_ENABLED=true

# ===========================================
# MONITORING & ALERTING
# ===========================================
# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Grafana
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# Alerting (Slack)
SLACK_WEBHOOK_URL=your_slack_webhook_url
ALERT_EMAIL=alerts@codai.ro

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_MFA_ENABLED=true
FEATURE_BIOMETRIC_AUTH=true
FEATURE_SSO_ENABLED=true
FEATURE_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_FRAUD_DETECTION=true

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
DEBUG_MODE=true
VERBOSE_LOGGING=true

# ===========================================
# CORS & SECURITY HEADERS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4800,https://codai.ro
CORS_CREDENTIALS=true

# Security Headers
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_MAX_AGE=31536000

# ===========================================
# API GATEWAY
# ===========================================
API_GATEWAY_URL=http://api-gateway:8000
API_RATE_LIMIT_RPM=1000
API_TIMEOUT_MS=30000
