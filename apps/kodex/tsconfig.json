{
  "extends": "../../configs/tsconfig.node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "*.js",
    "*.ts",
    "../../types/**/*",
    "src/**/*",
    ".next/types/**/*.ts"
  ]
}
