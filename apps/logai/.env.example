# LOGAI Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/logai"

# API Configuration  
PORT=3517
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Integration API Keys
_AUTH0_AUTH0_SPA_JS_ENABLED=false
_AUTH0_AUTH0_SPA_JS_API_KEY="your-api-key-here"
_AUTH0_AUTH0_SPA_JS_BASE_URL="https://api.example.com"
PASSPORT_ENABLED=false
PASSPORT_API_KEY="your-api-key-here"
PASSPORT_BASE_URL="https://api.example.com"
PASSPORT_GOOGLE_OAUTH20_ENABLED=false
PASSPORT_GOOGLE_OAUTH20_API_KEY="your-api-key-here"
PASSPORT_GOOGLE_OAUTH20_BASE_URL="https://api.example.com"
PASSPORT_GITHUB2_ENABLED=false
PASSPORT_GITHUB2_API_KEY="your-api-key-here"
PASSPORT_GITHUB2_BASE_URL="https://api.example.com"
SPEAKEASY_ENABLED=false
SPEAKEASY_API_KEY="your-api-key-here"
SPEAKEASY_BASE_URL="https://api.example.com"
LDAPJS_ENABLED=false
LDAPJS_API_KEY="your-api-key-here"
LDAPJS_BASE_URL="https://api.example.com"
SAML2_JS_ENABLED=false
SAML2_JS_API_KEY="your-api-key-here"
SAML2_JS_BASE_URL="https://api.example.com"
HELMET_ENABLED=false
HELMET_API_KEY="your-api-key-here"
HELMET_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false