# MARKETAI Environment Configuration

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Application
NEXT_PUBLIC_APP_NAME="marketai"
NEXT_PUBLIC_APP_URL="https://marketai.ro"
NEXT_PUBLIC_API_URL="/api"

# Stripe Payment Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/marketai_db

# Blockchain Configuration (Ethereum/Polygon)
INFURA_PROJECT_ID=your_infura_project_id
PRIVATE_KEY=your_ethereum_private_key_for_revenue_sharing
CONTRACT_ADDRESS=your_deployed_contract_address

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:4056

# File Storage (for agent uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=marketai-agent-storage

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Third-party Integrations
SENDGRID_API_KEY=your_sendgrid_api_key_for_notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_for_alerts