// Prisma database schema for MARKETAI - Agent Marketplace Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(USER)
  verified      Boolean   @default(false)
  stripeCustomerId String?
  
  // Relations
  agents        Agent[]
  purchases     Purchase[]
  reviews       Review[]
  subscriptions Subscription[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("users")
}

model Agent {
  id            String      @id @default(cuid())
  name          String
  description   String
  version       String      @default("1.0.0")
  price         Decimal     @db.Decimal(10, 2)
  category      String
  tags          String[]
  
  // Agent verification and quality
  status        AgentStatus @default(PENDING)
  qualityScore  Float       @default(0.0)
  downloads     Int         @default(0)
  rating        Float       @default(0.0)
  
  // Files and metadata
  fileUrl       String
  fileSize      Int
  fileHash      String      @unique
  
  // Security scanning results
  securityScan  Json?
  lastScanned   DateTime?
  
  // Performance benchmarks
  benchmarkResults Json?
  lastBenchmarked  DateTime?
  
  // Author
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  
  // Relations
  purchases     Purchase[]
  reviews       Review[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@map("agents")
}

model Purchase {
  id              String        @id @default(cuid())
  userId          String
  agentId         String
  amount          Decimal       @db.Decimal(10, 2)
  stripePaymentId String?
  blockchainTxId  String?
  status          PaymentStatus @default(PENDING)
  
  // Revenue sharing
  authorRevenue   Decimal       @db.Decimal(10, 2)
  platformRevenue Decimal       @db.Decimal(10, 2)
  
  // Relations
  user            User          @relation(fields: [userId], references: [id])
  agent           Agent         @relation(fields: [agentId], references: [id])
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([userId, agentId])
  @@map("purchases")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  rating    Int      // 1-5 stars
  comment   String?
  helpful   Int      @default(0)
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  agent     Agent    @relation(fields: [agentId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, agentId])
  @@map("reviews")
}

model Subscription {
  id              String           @id @default(cuid())
  userId          String
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(ACTIVE)
  stripeSubId     String?          @unique
  currentPeriodEnd DateTime?
  
  // Relations
  user            User             @relation(fields: [userId], references: [id])
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@map("subscriptions")
}

model Analytics {
  id          String   @id @default(cuid())
  agentId     String?
  eventType   String   // download, view, purchase, review
  metadata    Json?
  timestamp   DateTime @default(now())
  
  @@map("analytics")
}

// Enums
enum UserRole {
  USER
  DEVELOPER
  ADMIN
}

enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}
