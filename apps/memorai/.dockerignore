# MemorAI App Specific Docker Ignore

# Node.js
node_modules /
    npm - debug.log *
    yarn - debug.log *
    yarn - error.log *
.pnpm - debug.log *

# Next.js
    .next /
    out /

# Build outputs
dist /
    build /

# Environment files
    .env
    .env.*
    !.env.example

# IDE
    .vscode /
.idea /

# OS
    .DS_Store
Thumbs.db

# Git
    .git /
.gitignore

# Testing
coverage /
.nyc_output /

# Logs
    *.log
logs /

# Cache
    .cache /
.turbo /

# Development
    *.test.js
    *.test.ts
    *.spec.js
    *.spec.ts
__tests__ /
    test /
    tests /

# Documentation
    *.md
!README.md

# Temporary
tmp /
    temp /
.tmp /

# Large files
    *.zip
    *.tar.gz
    *.pdf
    *.mp4
    *.avi

# Database
    *.db
    *.sqlite
    *.sqlite3

# Security
    *.pem
    *.key
    *.crt

# GraphQL specific exclusions
graphql / node_modules /
    graphql / coverage /
    graphql / dist /
    graphql /.cache /

# TypeScript build info
    *.tsbuildinfo
