import type { NextConfig } from "next";

const nextConfig: NextConfig = {
  output: 'standalone',
  typescript: {
    ignoreBuildErrors: true,
  },
  eslint: {
    ignoreDuringBuilds: true,
  },
  experimental: {
    optimizePackageImports: ['lucide-react', '@radix-ui/react-icons'],
  },
  // Microsoft's bundle optimization patterns
  webpack: (config, { buildId, dev, isServer, defaultLoaders, webpack }) => {
    // Fix for 'self is not defined' error in SSR
    if (isServer) {
      config.plugins.push(
        new webpack.DefinePlugin({
          'self': 'globalThis',
          'window': 'undefined'
        })
      );
    }

    // Enable tree shaking for better bundle optimization
    config.optimization = {
      ...config.optimization,
      usedExports: true,
      sideEffects: false,
      // Enhanced module concatenation for smaller bundles
      concatenateModules: true,
      // Split chunks for better caching
      splitChunks: {
        chunks: 'all',
        cacheGroups: {
          // UI components chunk for better caching
          ui: {
            test: /[\\/]node_modules[\\/](@radix-ui|framer-motion|lucide-react)[\\/]/,
            name: 'ui-components',
            chunks: 'all',
            priority: 20,
          },
          // Chart components for selective loading
          charts: {
            test: /[\\/]node_modules[\\/](recharts)[\\/]/,
            name: 'chart-components',
            chunks: 'all',
            priority: 15,
          },
          // Core React libraries
          react: {
            test: /[\\/]node_modules[\\/](react|react-dom)[\\/]/,
            name: 'react-vendor',
            chunks: 'all',
            priority: 30,
          },
          // Default vendor chunk for other dependencies
          vendor: {
            test: /[\\/]node_modules[\\/]/,
            name: 'vendors',
            chunks: 'all',
            priority: 10,
          },
        },
      },
    };

    // Microsoft's path-based import optimization for Lucide React
    config.resolve.alias = {
      ...config.resolve.alias,
      // Enable tree-shaking for icon libraries
      '^lucide-react/dist/esm/icons/(.+)$': 'lucide-react/dist/esm/icons/$1',
    };

    // Analyze bundle size in development
    if (process.env.ANALYZE === 'true') {
      const { BundleAnalyzerPlugin } = require('@next/bundle-analyzer')({
        enabled: true,
      });
      config.plugins.push(new BundleAnalyzerPlugin());
    }

    return config;
  },
  // Enable compression for better runtime performance
  compress: true,
  // Optimize images for better loading
  images: {
    formats: ['image/avif', 'image/webp'],
    dangerouslyAllowSVG: true,
    contentDispositionType: 'attachment',
    contentSecurityPolicy: "default-src 'self'; script-src 'none'; sandbox;",
  },
  // Microsoft's performance optimization patterns
  poweredByHeader: false,
  reactStrictMode: true,
  productionBrowserSourceMaps: false,
};

export default nextConfig;

