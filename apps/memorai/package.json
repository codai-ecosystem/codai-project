{
  "name": "memorai",
  "version": "1.0.0",
  "description": "AI-powered memory and knowledge management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4006",
    "build": "cd ../../ && pnpm exec next build --experimental-build-mode=compile apps/memorai",
    "start": "next start -p 4006",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "next lint",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@codai/cbd": "workspace:*",
    "@codai/memorai": "workspace:*",
    "@codai/shared-ui": "workspace:*",
    "@codai/sso-sdk": "workspace:*",
    "@codai/security": "workspace:*",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "framer-motion": "^12.23.6",
    "fuse.js": "^7.1.0",
    "geist": "^1.4.2",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "next-auth": "^4.24.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^3.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
