{
  "name": "memorai",
  "version": "1.0.0",
  "description": "AI-powered memory and knowledge management platform",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4006",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start -p 4006",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:unit": "vitest run src/**/*.test.{ts,tsx}",
    "test:components": "vitest run src/components/__tests__/*.test.tsx",
    "test:services": "vitest run src/services/__tests__/*.test.ts",
    "test:integration": "vitest run tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:ci": "pnpm test:coverage && pnpm test:e2e --reporter=junit",
    "test:performance": "playwright test --grep @performance",
    "test:security": "pnpm test:unit --grep security",
    "test:ui": "vitest --ui",
    "test:mcp": "cd ../../packages/memorai-mcp && npm test",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "build:speed": "SPEED_MEASURE=true next build",
    "build:prod": "NODE_ENV=production next build",
    "build:fast": "NEXT_PHASE=production-server next build",
    "analyze:bundle": "node ../../analysis/bundle-analysis.js",
    "analyze:build": "ANALYZE=true pnpm build",
    "monitor:build": "node ../../lib/build-monitoring/build-monitor.js",
    "cache:clear": "rm -rf .next/cache && rm -rf node_modules/.cache",
    "cache:analyze": "next info",
    "dev:fast": "next dev --turbo",
    "dev:profile": "next dev --profile",
    "start:prod": "NODE_ENV=production next start",
    "preview": "pnpm build && pnpm start",
    "check:all": "pnpm type-check && pnpm lint && pnpm test",
    "check:fast": "pnpm type-check && pnpm lint --fix"
  },
  "dependencies": {
    "@codai/shared-ui": "workspace:*",
    "@codai/cbd": "^1.0.10",
    "@codai/shared-types": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^12.23.6",
    "fuse.js": "^7.1.0",
    "geist": "^1.4.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.525.0",
    "next": "15.4.1",
    "next-auth": "5.0.0-beta.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-is": "^19.1.1",
    "recharts": "^3.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.6",
    "@codai/api-utils": "workspace:*",
    "react-i18next": "^15.3.0",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.1",
    "@codai/translations": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "axe-core": "^4.8.3",
    "axe-playwright": "^2.0.3",
    "jest-axe": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.4.1",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@codai/testing-utils": "workspace:*",
    "i18next-parser": "^9.0.0",
    "@types/react-i18next": "^8.1.0"
  },
  "nextBundleAnalysis": {
    "enabled": true,
    "openAnalyzer": false,
    "analyzerMode": "static",
    "generateStatsFile": true
  }
}