{
  "name": "@codai/memorai-cli",
  "version": "0.1.5",
  "description": "CLI tools for Memorai MCP - Agent memory management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "memorai": "./dist/bin/memorai.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "pnpm exec eslint src/**/*.ts",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "keywords": [
    "cli",
    "memory",
    "ai",
    "agent",
    "mcp"
  ],
  "author": "CodeAI",
  "license": "MIT",
  "dependencies": {
    "@codai/memorai-core": "^2.3.0",
    "@codai/memorai-sdk": "^0.1.8",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "inquirer": "^12.7.0",
    "ora": "^8.2.0",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.8",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}