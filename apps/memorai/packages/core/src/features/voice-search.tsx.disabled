/**
 * Voice Search Implementation for Memorai v3.0
 * Web Speech API integration with multi-language support
 */

import { useState, useEffect, useCallback } from 'react';

interface VoiceSearchConfig {
  language?: string;
  continuous?: boolean;
  interimResults?: boolean;
  maxAlternatives?: number;
}

interface VoiceSearchResult {
  transcript: string;
  confidence: number;
  isFinal: boolean;
  alternatives?: string[];
}

interface VoiceSearchHook {
  isListening: boolean;
  transcript: string;
  confidence: number;
  error: string | null;
  isSupported: boolean;
  startListening: () => void;
  stopListening: () => void;
  resetTranscript: () => void;
}

export const useVoiceSearch = (config: VoiceSearchConfig = {}): VoiceSearchHook => {
  const [isListening, setIsListening] = useState(false);
  const [transcript, setTranscript] = useState('');
  const [confidence, setConfidence] = useState(0);
  const [error, setError] = useState<string | null>(null);
  const [recognition, setRecognition] = useState<any>(null);

  const {
    language = 'en-US',
    continuous = false,
    interimResults = true,
    maxAlternatives = 3
  } = config;

  // Check for Web Speech API support
  const isSupported = typeof window !== 'undefined' && 
    ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window);

  useEffect(() => {
    if (!isSupported || typeof window === 'undefined') return;

    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (!SpeechRecognition) return;
    
    const recognitionInstance = new SpeechRecognition();

    recognitionInstance.continuous = continuous;
    recognitionInstance.interimResults = interimResults;
    recognitionInstance.lang = language;
    recognitionInstance.maxAlternatives = maxAlternatives;

    recognitionInstance.onstart = () => {
      setIsListening(true);
      setError(null);
    };

    recognitionInstance.onresult = (event: SpeechRecognitionEvent) => {
      let finalTranscript = '';
      let interimTranscript = '';

      for (let i = event.resultIndex; i < event.results.length; i++) {
        const result = event.results[i];
        const transcriptPart = result[0].transcript;

        if (result.isFinal) {
          finalTranscript += transcriptPart;
          setConfidence(result[0].confidence);
        } else {
          interimTranscript += transcriptPart;
        }
      }

      setTranscript(finalTranscript || interimTranscript);
    };

    recognitionInstance.onerror = (event: SpeechRecognitionErrorEvent) => {
      setError(`Speech recognition error: ${event.error}`);
      setIsListening(false);
    };

    recognitionInstance.onend = () => {
      setIsListening(false);
    };

    setRecognition(recognitionInstance);

    return () => {
      if (recognitionInstance) {
        recognitionInstance.abort();
      }
    };
  }, [language, continuous, interimResults, maxAlternatives, isSupported]);

  const startListening = useCallback(() => {
    if (recognition && !isListening) {
      setError(null);
      setTranscript('');
      recognition.start();
    }
  }, [recognition, isListening]);

  const stopListening = useCallback(() => {
    if (recognition && isListening) {
      recognition.stop();
    }
  }, [recognition, isListening]);

  const resetTranscript = useCallback(() => {
    setTranscript('');
    setConfidence(0);
    setError(null);
  }, []);

  return {
    isListening,
    transcript,
    confidence,
    error,
    isSupported,
    startListening,
    stopListening,
    resetTranscript
  };
};

/**
 * Voice Search Component
 */
interface VoiceSearchProps {
  onTranscript?: (result: VoiceSearchResult) => void;
  language?: string;
  placeholder?: string;
  className?: string;
}

export const VoiceSearchComponent: React.FC<VoiceSearchProps> = ({
  onTranscript,
  language = 'en-US',
  placeholder = 'Click to start voice search...',
  className = ''
}) => {
  const {
    isListening,
    transcript,
    confidence,
    error,
    isSupported,
    startListening,
    stopListening,
    resetTranscript
  } = useVoiceSearch({ language });

  useEffect(() => {
    if (transcript && onTranscript) {
      onTranscript({
        transcript,
        confidence,
        isFinal: !isListening,
        alternatives: []
      });
    }
  }, [transcript, confidence, isListening, onTranscript]);

  if (!isSupported) {
    return (
      <div className={`voice-search-unsupported ${className}`}>
        <p>Voice search is not supported in your browser</p>
      </div>
    );
  }

  return (
    <div className={`voice-search-container ${className}`}>
      <div className="voice-search-controls">
        <button
          onClick={isListening ? stopListening : startListening}
          className={`voice-search-button ${isListening ? 'listening' : 'idle'}`}
          disabled={!!error}
        >
          {isListening ? (
            <div className="listening-indicator">
              <span className="pulse-dot"></span>
              Listening...
            </div>
          ) : (
            <div className="idle-indicator">
              🎤 {placeholder}
            </div>
          )}
        </button>
        
        {transcript && (
          <button
            onClick={resetTranscript}
            className="reset-button"
          >
            Clear
          </button>
        )}
      </div>

      {transcript && (
        <div className="voice-search-results">
          <div className="transcript">
            <strong>Transcript:</strong> {transcript}
          </div>
          {confidence > 0 && (
            <div className="confidence">
              <strong>Confidence:</strong> {(confidence * 100).toFixed(1)}%
            </div>
          )}
        </div>
      )}

      {error && (
        <div className="voice-search-error">
          <strong>Error:</strong> {error}
        </div>
      )}

      <style jsx>{`
        .voice-search-container {
          padding: 1rem;
          border: 1px solid #e5e7eb;
          border-radius: 0.5rem;
          background: white;
        }

        .voice-search-controls {
          display: flex;
          gap: 0.5rem;
          align-items: center;
        }

        .voice-search-button {
          flex: 1;
          padding: 1rem;
          border: none;
          border-radius: 0.375rem;
          cursor: pointer;
          transition: all 0.2s;
        }

        .voice-search-button.idle {
          background: #3b82f6;
          color: white;
        }

        .voice-search-button.listening {
          background: #ef4444;
          color: white;
          animation: pulse 2s infinite;
        }

        .pulse-dot {
          display: inline-block;
          width: 8px;
          height: 8px;
          background: white;
          border-radius: 50%;
          margin-right: 8px;
          animation: pulse 1s infinite;
        }

        .reset-button {
          padding: 0.5rem 1rem;
          background: #6b7280;
          color: white;
          border: none;
          border-radius: 0.375rem;
          cursor: pointer;
        }

        .voice-search-results {
          margin-top: 1rem;
          padding: 1rem;
          background: #f9fafb;
          border-radius: 0.375rem;
        }

        .transcript {
          margin-bottom: 0.5rem;
        }

        .confidence {
          font-size: 0.875rem;
          color: #6b7280;
        }

        .voice-search-error {
          margin-top: 1rem;
          padding: 1rem;
          background: #fef2f2;
          border: 1px solid #fecaca;
          border-radius: 0.375rem;
          color: #dc2626;
        }

        @keyframes pulse {
          0%, 100% { opacity: 1; }
          50% { opacity: 0.5; }
        }
      `}</style>
    </div>
  );
};

/**
 * Memory Search Integration
 */
export const VoiceMemorySearch: React.FC<{
  onSearch: (query: string) => Promise<any[]>;
  className?: string;
}> = ({ onSearch, className }) => {
  const [searchResults, setSearchResults] = useState<any[]>([]);
  const [isSearching, setIsSearching] = useState(false);

  const handleVoiceTranscript = async (result: VoiceSearchResult) => {
    if (result.isFinal && result.transcript.trim()) {
      setIsSearching(true);
      try {
        const results = await onSearch(result.transcript.trim());
        setSearchResults(results);
      } catch (error) {
        console.error('Voice search error:', error);
      } finally {
        setIsSearching(false);
      }
    }
  };

  return (
    <div className={`voice-memory-search ${className}`}>
      <VoiceSearchComponent
        onTranscript={handleVoiceTranscript}
        placeholder="Search your memories with voice..."
      />

      {isSearching && (
        <div className="searching-indicator">
          <div className="spinner"></div>
          Searching memories...
        </div>
      )}

      {searchResults.length > 0 && (
        <div className="search-results">
          <h3>Memory Search Results:</h3>
          {searchResults.map((memory, index) => (
            <div key={index} className="memory-result">
              <p>{memory.content}</p>
              <small>Relevance: {(memory.score * 100).toFixed(1)}%</small>
            </div>
          ))}
        </div>
      )}

      <style jsx>{`
        .voice-memory-search {
          max-width: 600px;
          margin: 0 auto;
        }

        .searching-indicator {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-top: 1rem;
          padding: 1rem;
          background: #f0f9ff;
          border-radius: 0.375rem;
        }

        .spinner {
          width: 16px;
          height: 16px;
          border: 2px solid #e5e7eb;
          border-top-color: #3b82f6;
          border-radius: 50%;
          animation: spin 1s linear infinite;
        }

        .search-results {
          margin-top: 1rem;
        }

        .memory-result {
          padding: 1rem;
          margin: 0.5rem 0;
          background: white;
          border: 1px solid #e5e7eb;
          border-radius: 0.375rem;
        }

        @keyframes spin {
          to { transform: rotate(360deg); }
        }
      `}</style>
    </div>
  );
};

// Type declarations for Web Speech API
declare global {
  interface Window {
    SpeechRecognition: typeof SpeechRecognition;
    webkitSpeechRecognition: typeof SpeechRecognition;
  }
}

export default VoiceSearchComponent;
