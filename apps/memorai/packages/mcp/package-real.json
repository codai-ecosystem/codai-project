    "scripts": {
        "build": "echo 'No build needed - using JavaScript'",
        "prepublishOnly": "echo 'Publishing real-server.js'"
    },
    "keywords": [
        "mcp",
        "memory",
        "ai",
        "agent",
        "context",
        "protocol",
        "memorai",
        "real-data",
        "no-mocks",
        "authentic",
        "enterprise",
        "vscode",
        "copilot",
        "performance"
    ],
    "author": "CodeAI",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.15.1"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}