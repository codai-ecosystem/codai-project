{
    "name": "@codai/memorai-mcp",
    "version": "7.1.0",
    "description": "REAL Enterprise MCP Server - No Mock Data, Authentic Memory Operations with sub-2ms responses",
    "type": "module",
    "main": "./dist/real-server.js",
    "types": "./dist/real-server.d.ts",
    "bin": {
        "memorai-mcp": "./dist/real-server.js",
        "memorai-mcp-real": "./dist/real-server.js"
