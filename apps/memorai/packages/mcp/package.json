{
  "name": "@codai/memorai-mcp",
  "version": "6.1.3",
  "description": "WORLD-CLASS Enterprise MCP Server - Greatest of All Time achievement with sub-2ms responses, bank-grade security, and unlimited performance capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "memorai-mcp": "./dist/ultra-fast-server.js",
    "memorai-mcp-ultra": "./dist/ultra-fast-server.js",
    "memorai-mcp-enterprise": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "mcp.config.json",
    ".env.example",
    "docker-compose.dev.yml"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent",
    "context",
    "protocol",
    "memorai",
    "enterprise",
    "vscode",
    "copilot",
    "performance",
    "world-class",
    "greatest-of-all-time",
    "sub-2ms",
    "bank-grade-security",
    "unlimited-performance",
    "production-ready",
    "kubernetes",
    "cicd",
    "monitoring"
  ],
  "author": "CodeAI",
  "license": "MIT",
  "homepage": "https://github.com/dragoscv/memorai-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/memorai-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/dragoscv/memorai-mcp/issues"
  },
  "dependencies": {
    "@codai/memorai-core": "^2.3.0",
    "@codai/memorai-server": "^0.1.8",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcp": {
    "name": "memorai",
    "description": "Enterprise-grade memory management for AI agents",
    "version": "1.0.0",
    "server": {
      "command": "memorai-mcp",
      "args": []
    }
  }
}