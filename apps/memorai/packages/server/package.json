{
  "name": "@codai/memorai-server",
  "version": "0.1.5",
  "description": "Enterprise MCP server for agent-native memory management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "memorai-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "pnpm exec eslint src/**/*.ts",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent",
    "context",
    "protocol"
  ],
  "author": "CodeAI",
  "license": "MIT",
  "dependencies": {
    "@codai/memorai-core": "^2.3.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "node-cron": "^4.2.1",
    "winston": "^3.17.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
