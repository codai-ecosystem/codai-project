/**
 * MemorAI Middleware
 * Handles authentication, user isolation, and request routing
 */

import { NextRequest, NextResponse } from 'next/server';
import { CodaiUser } from '@/lib/auth';

// Protected routes that require authentication
const protectedRoutes = [
    '/dashboard',
    '/memories',
    '/search',
    '/profile',
    '/settings',
];

// API routes that require authentication
const protectedApiRoutes = [
    '/api/memories',
    '/api/search',
    '/api/categories',
    '/api/performance',
];

// Public routes that don't require authentication
const publicRoutes = [
    '/',
    '/auth/signin',
    '/auth/signup',
    '/auth/error',
    '/api/auth',
    '/api/health',
    '/user-journey-test', // Allow testing page
    '/test', // Allow test page
    '/security-validation', // Allow security testing page
    '/performance-testing', // Allow performance testing page
    '/performance-monitoring', // Allow performance monitoring page
];

interface AuthToken {
    userId: string;
    email: string;
    roles: string[];
    permissions: string[];
    exp: number;
}

// Extract user from authentication token
function extractUserFromToken(token: string): CodaiUser | null {
    try {
        // Handle test token
        if (token === 'test.token.here') {
            return {
                id: 'test-user-123',
                name: 'Test User',
                email: 'test@memorai.dev',
                roles: ['user', 'tester'],
                permissions: ['memorai:read', 'memorai:write'],
            };
        }

        // Handle mock authenticated token
        if (token === 'mock.authenticated.token') {
            return {
                id: 'mock-user-456',
                name: 'Mock User',
                email: 'mock@memorai.dev',
                roles: ['user'],
                permissions: ['memorai:read', 'memorai:write'],
            };
        }

        // In a real implementation, you would verify the JWT token
        // For now, we'll decode a simple base64 token
        const payload = JSON.parse(atob(token.split('.')[1] || ''));

        if (payload.exp && payload.exp < Date.now() / 1000) {
            return null; // Token expired
        }

        return {
            id: payload.userId || payload.sub,
            name: payload.name,
            email: payload.email,
            roles: payload.roles || [],
            permissions: payload.permissions || [],
        };
    } catch (error) {
        console.error('Token parsing error:', error);
        return null;
    }
}

// Check if user has required permissions
function hasPermission(user: CodaiUser, permission: string): boolean {
    return user.permissions?.includes(permission) || false;
}

// Get authentication token from request
function getAuthToken(request: NextRequest): string | null {
    const { pathname } = request.nextUrl;

    // Check Authorization header
    const authHeader = request.headers.get('authorization');
    if (authHeader && authHeader.startsWith('Bearer ')) {
        const token = authHeader.substring(7);

        // Only allow test token for specific test pages
        if (token === 'test.token.here' && (
            pathname.startsWith('/user-journey-test') ||
            pathname.startsWith('/test')
        )) {
            return token;
        }

        // For all other tokens, verify them properly
        if (token !== 'test.token.here') {
            return token;
        }
    }

    // Check cookie
    const cookieToken = request.cookies.get('memorai-auth')?.value;
    if (cookieToken === 'authenticated') {
        // In development, return a mock token only for authenticated users
        return 'mock.authenticated.token';
    }

    return null;
}

// Add user context to request headers
function addUserContext(response: NextResponse, user: CodaiUser): NextResponse {
    response.headers.set('X-User-ID', user.id);
    response.headers.set('X-User-Email', user.email || '');
    response.headers.set('X-User-Roles', JSON.stringify(user.roles || []));
    response.headers.set('X-User-Permissions', JSON.stringify(user.permissions || []));
    return response;
}

// Middleware function
export function middleware(request: NextRequest) {
    const { pathname } = request.nextUrl;
    const method = request.method;

    console.log(`[Middleware] ${method} ${pathname}`);

    // Skip middleware for static files and Next.js internals
    if (
        pathname.startsWith('/_next/') ||
        pathname.startsWith('/favicon.ico') ||
        pathname.includes('.')
    ) {
        return NextResponse.next();
    }

    // Check if route is public
    const isPublicRoute = publicRoutes.some(route =>
        pathname === route || pathname.startsWith(route + '/')
    );

    // Check if API route is protected
    const isProtectedApiRoute = protectedApiRoutes.some(route =>
        pathname.startsWith(route)
    );

    // Check if page route is protected
    const isProtectedPageRoute = protectedRoutes.some(route =>
        pathname === route || pathname.startsWith(route + '/')
    );

    // Get authentication token
    const token = getAuthToken(request);
    const user = token ? extractUserFromToken(token) : null;

    // Handle protected API routes
    if (isProtectedApiRoute) {
        if (!user) {
            return NextResponse.json(
                { error: 'Authentication required', code: 'UNAUTHORIZED' },
                { status: 401 }
            );
        }

        // Check MemorAI permissions
        if (!hasPermission(user, 'memorai:read') && !hasPermission(user, 'memorai:write')) {
            return NextResponse.json(
                { error: 'Insufficient permissions', code: 'FORBIDDEN' },
                { status: 403 }
            );
        }

        // Add user context to API requests
        const response = NextResponse.next();
        return addUserContext(response, user);
    }

    // Handle protected page routes
    if (isProtectedPageRoute) {
        if (!user) {
            const signInUrl = new URL('/auth/signin', request.url);
            signInUrl.searchParams.set('callbackUrl', pathname);
            return NextResponse.redirect(signInUrl);
        }

        // Check MemorAI permissions
        if (!hasPermission(user, 'memorai:read') && !hasPermission(user, 'memorai:write')) {
            const errorUrl = new URL('/auth/error', request.url);
            errorUrl.searchParams.set('error', 'InsufficientPermissions');
            return NextResponse.redirect(errorUrl);
        }

        // Add user context to page requests
        const response = NextResponse.next();
        return addUserContext(response, user);
    }

    // Handle public routes
    if (isPublicRoute) {
        // If user is authenticated and trying to access auth pages, redirect to dashboard
        if (user && (pathname.startsWith('/auth/signin') || pathname === '/')) {
            return NextResponse.redirect(new URL('/dashboard', request.url));
        }

        return NextResponse.next();
    }

    // Default: allow request to proceed
    return NextResponse.next();
}

// Configure which routes the middleware should run on
export const config = {
    matcher: [
        /*
         * Match all request paths except for the ones starting with:
         * - api/auth (auth routes)
         * - _next/static (static files)
         * - _next/image (image optimization files)
         * - favicon.ico (favicon file)
         */
        '/((?!api/auth|_next/static|_next/image|favicon.ico).*)',
    ],
};

// User isolation utilities for API routes
export const userIsolation = {
    // Extract user ID from request headers
    getUserId: (request: NextRequest): string | null => {
        return request.headers.get('X-User-ID');
    },

    // Extract user permissions from request headers
    getUserPermissions: (request: NextRequest): string[] => {
        const permissionsHeader = request.headers.get('X-User-Permissions');
        if (!permissionsHeader) return [];

        try {
            return JSON.parse(permissionsHeader);
        } catch {
            return [];
        }
    },

    // Check if user has specific permission
    hasUserPermission: (request: NextRequest, permission: string): boolean => {
        const permissions = userIsolation.getUserPermissions(request);
        return permissions.includes(permission);
    },

    // Create user-scoped query filter
    createUserFilter: (request: NextRequest): { userId: string } | null => {
        const userId = userIsolation.getUserId(request);
        return userId ? { userId } : null;
    },

    // Validate user ownership of resource
    validateUserOwnership: (request: NextRequest, resourceUserId: string): boolean => {
        const currentUserId = userIsolation.getUserId(request);
        return currentUserId === resourceUserId;
    },
};
