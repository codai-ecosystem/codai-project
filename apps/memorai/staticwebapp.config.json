{
  "$schema": "https://aka.ms/azure-static-web-apps-config",
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated", "anonymous"]
    },
    {
      "route": "/auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/admin/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/auth/login",
      "statusCode": 302
    },
    "403": {
      "redirect": "/unauthorized",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css": "text/css",
    ".js": "application/javascript",
    ".woff2": "font/woff2"
  },
  "forwardingGateway": {
    "allowedForwardedHosts": [
      "memorai.com",
      "*.memorai.com"
    ]
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/auth/*", "/images/*.{png,jpg,gif}"]
  },
  "platform": {
    "apiRuntime": "node:18"
  }
}