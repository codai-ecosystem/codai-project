// Emergency TypeScript configuration for production deployment
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": false, // Temporarily disable strict mode for production emergency
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true, // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": false // Temporarily disable casing check
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "src/**/*.stories.tsx", // Exclude Storybook files from build
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "node_modules"
  ]
}
