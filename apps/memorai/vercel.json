{
    "version": 2,
    "framework": "nextjs",
    "buildCommand": "npm run build",
    "installCommand": "npm install --legacy-peer-deps",
    "regions": [
        "fra1"
    ],
    "functions": {
        "app/api/**": {
            "maxDuration": 30
        }
    },
    "env": {
        "NEXT_TYPESCRIPT_IGNORE_BUILD_ERRORS": "true",
        "NEXTAUTH_URL": "https://app.memorai.ro",
        "NODE_ENV": "production",
        "NEXT_PUBLIC_API_URL": "https://api.memorai.ro",
        "NEXT_PUBLIC_CBD_URL": "https://cbd.memorai.ro",
        "NEXT_PUBLIC_MCP_URL": "https://mcp.memorai.ro",
        "NEXT_PUBLIC_DOCS_URL": "https://docs.memorai.ro",
        "NEXT_PUBLIC_ADMIN_URL": "https://admin.memorai.ro",
        "NEXT_PUBLIC_SDK_URL": "https://sdk.memorai.ro",
        "NEXT_PUBLIC_CLI_URL": "https://cli.memorai.ro",
        "NEXT_PUBLIC_STATUS_URL": "https://status.memorai.ro",
        "NEXT_PUBLIC_MEMORAI_VERSION": "1.0.0",
        "NEXT_PUBLIC_DOMAIN": "memorai.ro",
        "NEXT_PUBLIC_ID_SERVICE_URL": "https://id.codai.ro",
        "NEXT_PUBLIC_AUTH_SERVICE_URL": "https://auth.codai.ro",
        "NEXT_PUBLIC_GATEWAY_URL": "https://gateway.codai.ro"
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.vercel.app *.memorai.ro; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.memorai.ro https://cbd.memorai.ro https://mcp.memorai.ro https://id.codai.ro https://auth.codai.ro https://gateway.codai.ro https://codai-sweden-central.openai.azure.com;"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/_next/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/gateway/(.*)",
            "destination": "https://gateway.codai.ro/$1"
        },
        {
            "source": "/api/cbd/(.*)",
            "destination": "https://cbd.memorai.ro/$1"
        },
        {
            "source": "/api/mcp/(.*)",
            "destination": "https://mcp.memorai.ro/$1"
        },
        {
            "source": "/api/id/(.*)",
            "destination": "https://id.codai.ro/$1"
        },
        {
            "source": "/api/auth/(.*)",
            "destination": "https://auth.codai.ro/$1"
        }
    ],
    "redirects": [
        {
            "source": "/admin",
            "destination": "https://admin.memorai.ro",
            "permanent": false
        },
        {
            "source": "/docs",
            "destination": "https://docs.memorai.ro",
            "permanent": false
        },
        {
            "source": "/sdk",
            "destination": "https://sdk.memorai.ro",
            "permanent": false
        },
        {
            "source": "/cli",
            "destination": "https://cli.memorai.ro",
            "permanent": false
        },
        {
            "source": "/status",
            "destination": "https://status.memorai.ro",
            "permanent": false
        }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "github": {
        "autoJobCancelation": true,
        "autoAlias": false
    }
}