# METU Advanced Voice Assistant - Environment Configuration
# Copy this to .env.local and configure your values
# This app inherits configuration from the root .env.local file

# ===========================================
# APP-SPECIFIC CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_NAME=METU
NEXT_PUBLIC_APP_VERSION=1.0.0
PORT=4400

# ===========================================
# SERVER CONFIGURATION
# ===========================================
SERVER_PORT=4401
WEBSOCKET_PORT=4402
CLUSTER_WORKERS=4
NODE_ENV=development

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=./data/metu.db
DATABASE_TYPE=sqlite
REDIS_URL=redis://localhost:6379

# ===========================================
# ROMAI AGI CONFIGURATION
# ===========================================
ROMAI_AGI_ENABLED=true
ROMAI_QUANTUM_MODE=true
ROMAI_ROMANIAN_INTELLIGENCE=true
ROMAI_API_KEY=your-romai-api-key-here

# ===========================================
# MCP CONFIGURATION
# ===========================================
MEMORAI_MCP_URL=localhost:8002
CONTROLAI_MCP_ENABLED=true
PLAYWRIGHT_MCP_ENABLED=true
GLASS_MCP_ENABLED=true
CONTEXT7_MCP_ENABLED=true
MICROSOFT_DOCS_MCP_ENABLED=true
ROMAI_INTELLIGENCE_MCP_ENABLED=true

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:4400
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long
SESSION_TIMEOUT=3600

# ===========================================
# TRANSLATION CONFIGURATION
# ===========================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ro
AUTO_DETECT_LANGUAGE=true

# ===========================================
# MOBILE CONFIGURATION
# ===========================================
ANDROID_API_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
CROSS_PLATFORM_SYNC=true

# ===========================================
# AZURE AI SERVICES CONFIGURATION  
# ===========================================

# Azure AI Foundry (Primary AI service)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_AI_FOUNDRY_KEY=your_azure_ai_foundry_key_here

# Azure OpenAI (Language models)
AZURE_OPENAI_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Search (RAG capabilities)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your_azure_search_key_here

# Model deployments for METU voice assistant
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_GPT35_DEPLOYMENT=gpt-35-turbo

# ===========================================
# VOICE CONFIGURATION
# ===========================================
VOICE_PROVIDER=azure
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-region
VOICE_MODEL=whisper
SPEECH_TO_TEXT_MODEL=whisper
TEXT_TO_SPEECH_MODEL=azure-tts

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE=./logs/metu.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
CACHE_TTL=3600
MAX_CONNECTIONS=1000
REQUEST_TIMEOUT=30000

# ===========================================
# CORS & SECURITY
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4400

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
DEBUG_MODE=true
MONITORING_ENABLED=true

# GPT-5 Deployments (New - August 2025)
AZURE_OPENAI_GPT5_DEPLOYMENT=gpt-5
AZURE_OPENAI_GPT5_MINI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_GPT5_NANO_DEPLOYMENT=gpt-5-nano