{
  "name": "metu",
  "version": "1.0.0",
  "description": "Meeting and team utilities",
  "main": "dist/main/index.js",
  "author": "D C <dc@codai.ro>",
  "license": "MIT",
  "homepage": "https://metu.ro",
  "keywords": [
    "voice",
    "ai",
    "assistant",
    "windows",
    "electron",
    "metu"
  ],
  "scripts": {
    "dev": "next dev -p 5026",
    "build": "next build",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "preview": "electron-vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "clean": "rimraf dist coverage test-results",
    "start": "next start -p 5026",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@codai/shared-ui": "workspace:*",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.45.0",
    "node-fetch": "^3.3.2",
    "openai": "^5.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.3",
    "zustand": "^5.0.6",
    "next": "^15.4.1",
    "typescript": "^5.8.3",
    "geist": "^1.4.2",
    "@codai/translations": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "happy-dom": "^18.0.1",
    "eslint-config-next": "^15.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "ro.codai.metu",
    "productName": "METU",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "METU"
    },
    "portable": {
      "artifactName": "METU-Portable.exe"
    }
  },
  "private": true
}
