{
  "name": "metu  "scripts": {
    "dev": "next dev -p 4400",
    "dev:web": "next dev -p 4400",
    "dev:windows": "concurrently \"pnpm dev:web\" \"wait-on http://localhost:4400 && electron-vite dev\"",
    "build": "next build",
    "build:electron": "pnpm build && electron-vite build",
    "dev:electron": "concurrently \"pnpm dev\" \"wait-on http://localhost:4400 && electron-vite dev\"",
    "dev:electron-only": "wait-on http://localhost:4400 && electron-vite dev",
    "dev:electron-manual": "node dev-electron-manual.js",
    "build:win": "pnpm build:electron && electron-builder --win",
    "build:portable": "pnpm build:electron && electron-builder --win portable",
    "server:dev": "tsx watch src/services/server/index.ts",
    "server:build": "tsc src/services/server/**/*.ts --outDir dist/server",
    "server:start": "node dist/server/index.js",
    "dev:full": "concurrently \"pnpm dev:web\" \"pnpm server:dev\" \"wait-on http://localhost:4400 && pnpm dev:windows\"", "1.0.0",
  "type": "module",
  "description": "Meeting and team utilities",
  "main": "dist/main/index.cjs",
  "author": "D C <dc@codai.ro>",
  "license": "MIT",
  "homepage": "https://metu.ro",
  "keywords": [
    "voice",
    "ai",
    "assistant",
    "windows",
    "electron",
    "metu"
  ],
  "scripts": {
    "dev": "next dev -p 4400",
    "dev:web": "next dev -p 4400",
    "dev:windows": "concurrently \"pnpm dev:web\" \"wait-on http://localhost:4400 && electron-vite dev\"",
    "build": "next build",
    "build:electron": "pnpm build && electron-vite build",
    "dev:electron": "concurrently \"pnpm dev\" \"wait-on http://localhost:4400 && electron-vite dev\"",
    "dev:electron-only": "wait-on http://localhost:4400 && electron-vite dev",
    "dev:electron-manual": "node dev-electron-manual.js",
    "build:win": "pnpm build:electron && electron-builder --win",
    "build:portable": "pnpm build:electron && electron-builder --win portable",
    "server:dev": "tsx watch src/services/server/index.ts",
    "server:build": "tsc src/services/server/**/*.ts --outDir dist/server",
    "server:start": "node dist/server/index.js",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm server:dev\" \"wait-on http://localhost:4401 && electron-vite dev\"",
    "preview": "electron-vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "clean": "rimraf dist coverage test-results",
    "start": "next start -p 4400",
    "type-check": "pnpm exec tsc --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@codai/cnd": "workspace:*",
    "@codai/romai-agi": "workspace:*",
    "@codai/shared-ui": "workspace:*",
    "@codai/translations": "workspace:*",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.10.0",
    "azure-identity": "0.0.1-security",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "framer-motion": "^12.23.6",
    "geist": "^1.4.2",
    "helmet": "^7.1.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.45.0",
    "next": "^15.4.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.104.0",
    "rate-limiter-flexible": "^7.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.3.0",
    "redis": "^4.6.12",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.6",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "winston": "^3.11.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "ro.codai.metu",
    "productName": "METU",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "METU"
    },
    "portable": {
      "artifactName": "METU-Portable.exe"
    }
  },
  "private": true
}