            "image/*",
            ".pdf",
            ".csv",
            ".xlsx"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+codai",
      "url": "/?action=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred"
