# RomAI AGI System - Production Environment Configuration
# Optimized for 5-engine AGI system with 100% operational success rate
# Generated: August 23, 2025

# ================================
# AGI System Core Configuration
# ================================
ROMAI_ENV=production
NODE_ENV=production
PYTHONPATH=/app/src

# AGI Server Configuration
ROMAI_AGI_HOST=0.0.0.0
ROMAI_AGI_PORT=6101
ROMAI_LOG_LEVEL=info
MAX_WORKERS=4
WORKER_TIMEOUT=300
MAX_CONCURRENT_REQUESTS=50

# ================================
# 5-Engine System Configuration
# ================================

# Mathematical Reasoning Engine
MATH_ENGINE_ENABLED=true
MATH_ENGINE_CUDA=true
MATH_ENGINE_MODEL_PATH=/app/cache/models/math
MATH_ENGINE_PRECISION=float32

# Logical Reasoning Engine  
LOGIC_ENGINE_ENABLED=true
LOGIC_ENGINE_CUDA=true
LOGIC_ENGINE_MODEL_PATH=/app/cache/models/logic
LOGIC_ENGINE_REASONING_DEPTH=10

# Romanian Cultural Engine
CULTURAL_ENGINE_ENABLED=true
CULTURAL_ENGINE_AZURE_INTEGRATION=true
CULTURAL_ENGINE_FALLBACK_ENABLED=true
CULTURAL_ENGINE_CONFIDENCE_THRESHOLD=0.7

# Creative Intelligence Engine
CREATIVE_ENGINE_ENABLED=true
CREATIVE_ENGINE_MODES=problem_solving,innovation,artistic,analytical
CREATIVE_ENGINE_TEMPERATURE=0.8
CREATIVE_ENGINE_MAX_LENGTH=2048

# Cross-Modal Integration Engine
INTEGRATION_ENGINE_ENABLED=true
INTEGRATION_ENGINE_LEARNING_ENABLED=true
INTEGRATION_ENGINE_MULTIMODAL=true
INTEGRATION_ENGINE_CAPABILITY_THRESHOLD=0.84

# ================================
# Performance Optimization
# ================================

# PyTorch Configuration
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:2048
TORCH_HOME=/app/cache
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

# Model Caching
TRANSFORMERS_CACHE=/app/cache/transformers
HF_HOME=/app/cache/huggingface
MODEL_CACHE_DIR=/app/cache/models
ENABLE_MODEL_CACHING=true

# Memory Management
MEMORY_LIMIT=8G
MEMORY_WARNING_THRESHOLD=0.85
MEMORY_OPTIMIZATION=true
GARBAGE_COLLECTION_THRESHOLD=0.8

# ================================
# Azure OpenAI Integration
# ================================
AZURE_OPENAI_ENDPOINT=https://swedencentral.api.cognitive.microsoft.com/
AZURE_OPENAI_API_KEY=${AZURE_OPENAI_API_KEY}
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-realtime
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.7
AZURE_OPENAI_TIMEOUT=60

# ================================
# Database and Storage
# ================================

# CBD Database Configuration
CBD_BASE_URL=http://cbd-database:4180
CBD_API_KEY=${CBD_API_KEY}
ENABLE_VECTOR_SEARCH=true
ENABLE_HYBRID_SEARCH=true
ENABLE_GRAPH_STORAGE=true

# PostgreSQL Configuration
DATABASE_URL=postgresql://agi_user:${POSTGRES_PASSWORD}@postgres:5432/romai_agi
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=30

# Redis Configuration
REDIS_URL=redis://:${REDIS_PASSWORD}@redis-cache:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECTION_TIMEOUT=30
ENABLE_REDIS_CLUSTERING=false

# ================================
# Security Configuration
# ================================

# Authentication and Authorization
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_ENCRYPTION_KEY=${API_KEY_ENCRYPTION_KEY}

# CORS and Security Headers
CORS_ENABLED=true
CORS_ORIGINS=https://romai.codai.ro,https://admin.codai.ro,https://api.codai.ro
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_STORAGE=redis

# RBAC (Role-Based Access Control)
ENABLE_RBAC=true
RBAC_ADMIN_ROLES=admin,super_admin
RBAC_USER_ROLES=user,premium_user
RBAC_AGI_ACCESS_ROLES=agi_user,researcher,admin

# ================================
# Monitoring and Observability
# ================================

# Prometheus Metrics
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
METRICS_PATH=/metrics
ENABLE_CUSTOM_METRICS=true

# Health Checks
ENABLE_HEALTH_DASHBOARD=true
HEALTH_PORT=8080
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=45

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/app/logs/romai-agi.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLING_RATE=0.1
ENABLE_PROFILING=false
PROFILING_OUTPUT_DIR=/app/logs/profiles

# ================================
# Feature Flags
# ================================

# Core Features
QUANTUM_ENABLED=true
CONSCIOUSNESS_ENGINE=true
ENABLE_ADVANCED_REASONING=true
ENABLE_SELF_LEARNING=true

# Romanian Features
ENABLE_ROMANIAN_CULTURAL_ANALYSIS=true
ENABLE_ROMANIAN_NLP=true
ENABLE_MULTILINGUAL_SUPPORT=true

# Integration Features
ENABLE_WEBHOOK_SUPPORT=true
ENABLE_STREAMING_RESPONSES=true
ENABLE_BATCH_PROCESSING=true
ENABLE_API_VERSIONING=true

# Experimental Features (Production Safe)
ENABLE_NEURAL_SYMBOLIC_FUSION=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_CONTEXT_PRESERVATION=true

# ================================
# Resource Allocation
# ================================

# CPU Configuration
CPU_CORES=4
CPU_AFFINITY=auto
ENABLE_CPU_PINNING=false

# GPU Configuration (if available)
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
ENABLE_GPU_MONITORING=true
GPU_MEMORY_FRACTION=0.8

# Network Configuration
NETWORK_TIMEOUT=30
NETWORK_RETRY_ATTEMPTS=3
NETWORK_BACKOFF_FACTOR=2
ENABLE_CONNECTION_POOLING=true

# ================================
# Development and Debugging
# ================================

# Debug Configuration (Production Safe)
ENABLE_DEBUG=false
DEBUG_TOOLBAR=false
ENABLE_SQL_ECHO=false
ENABLE_DETAILED_ERRORS=false

# Testing Configuration
ENABLE_TEST_ENDPOINTS=false
TEST_MODE=false
MOCK_EXTERNAL_SERVICES=false

# ================================
# Backup and Recovery
# ================================

# Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=/app/backups

# Recovery Configuration
ENABLE_AUTO_RECOVERY=true
RECOVERY_CHECK_INTERVAL=300
ENABLE_FAILOVER=true

# ================================
# Production Metadata
# ================================
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_DATE=2025-08-23
DEPLOYMENT_ENVIRONMENT=production
AGI_ENGINES_COUNT=5
AGI_ENGINES_OPERATIONAL=5
AGI_TEST_SUCCESS_RATE=100%
PRODUCTION_READY=true

# ================================
# External Service URLs
# ================================
CODAI_API_URL=https://api.codai.ro
GATEWAY_URL=https://gateway.codai.ro  
ID_SERVICE_URL=https://id.codai.ro
WEBSOCKET_URL=wss://api.codai.ro/ws

# Public URLs
NEXT_PUBLIC_API_BASE_URL=https://api.codai.ro
NEXT_PUBLIC_APP_URL=https://romai.codai.ro
NEXT_PUBLIC_AGI_API_URL=https://agi.romai.codai.ro