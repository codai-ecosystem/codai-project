# Copy this file to .env and configure your values

# Azure OpenAI Configuration (Required)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Optional: Azure OpenAI API Version
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ROMAI Configuration (Optional)
ROMAI_MCP_PORT=3001
ROMAI_API_PORT=3000
ROMAI_LOG_LEVEL=info

# Optional: Security Configuration
ROMAI_SECRET_TOKEN=your-secret-token-here
ROMAI_CORS_ENABLED=true
ROMAI_RATE_LIMIT_ENABLED=true

# Optional: Memory Configuration (for future MemorAI integration)
MEMORAI_URL=your-memorai-endpoint
MEMORAI_API_KEY=your-memorai-api-key

# Development Configuration (Optional)
NODE_ENV=development
DEBUG=romai:*

# Production Configuration (Optional)
# Uncomment for production deployment
# NODE_ENV=production
# ROMAI_LOG_LEVEL=warn
# ROMAI_SECURE_MODE=true
