# ROMAI App Environment Configuration
# Copy this to .env.local and configure your values
# This app inherits configuration from the root .env.local file

# ===========================================
# APP-SPECIFIC CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_NAME=ROMAI
NEXT_PUBLIC_APP_VERSION=1.0.0
PORT=6100

# ===========================================
# DATABASE (if app-specific needed)
# ===========================================
# DATABASE_URL=postgresql://localhost:5432/romai
# Note: Use root DATABASE_URL if shared database

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:6100
JWT_SECRET=your-jwt-secret-here

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
DEBUG_MODE=true
LOG_LEVEL=info
MONITORING_ENABLED=true

# ===========================================
# CORS & SECURITY
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:6100

# ===========================================
# SERVICE-SPECIFIC CONFIGURATION
# ===========================================
# Add service-specific environment variables here
# All API keys and secrets inherit from root .env.local

# ===========================================
# AZURE OPENAI CONFIGURATION - DAY 4
# ===========================================
# Azure OpenAI Service Configuration
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4

# Optional Configuration
AZURE_OPENAI_MAX_TOKENS=2000
AZURE_OPENAI_TEMPERATURE=0.7
AZURE_OPENAI_TIMEOUT=30

# For development/testing (when Azure is not configured)
# Set to "true" to use mock responses instead of real Azure calls
AZURE_OPENAI_MOCK_MODE=false

# Logging Configuration
AZURE_OPENAI_DEBUG=false

