# RomAI AGI Production Environment Configuration
# ==============================================
# Copy this to .env.production and configure values

# Core Database Configuration
POSTGRES_PASSWORD=romai_secure_production_2025_$(openssl rand -hex 16)
POSTGRES_DATA_PATH=/var/lib/romai/data/postgres

# Redis Cache Configuration
REDIS_PASSWORD=romai_cache_production_2025_$(openssl rand -hex 16)
REDIS_DATA_PATH=/var/lib/romai/data/redis

# Security Keys (Generate new ones for production!)
API_SECRET_KEY=romai_api_production_2025_$(openssl rand -hex 32)
JWT_SECRET_KEY=romai_jwt_production_2025_$(openssl rand -hex 32)
SESSION_SECRET=romai_session_production_2025_$(openssl rand -hex 32)

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://swedencentral.api.cognitive.microsoft.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-01

# GPU Configuration
ENABLE_GPU=false
CUDA_VISIBLE_DEVICES=0

# Advanced AGI Features
QUANTUM_ENABLED=true
CONSCIOUSNESS_ENGINE=true

# Monitoring
GRAFANA_PASSWORD=romai_grafana_admin_2025

# Data Paths (adjust for your system)
CBD_DATA_PATH=/var/lib/romai/data/cbd
AGI_MODELS_PATH=/var/lib/romai/data/models
AGI_DATA_PATH=/var/lib/romai/data/agi
AGI_LOGS_PATH=/var/log/romai/agi
API_LOGS_PATH=/var/log/romai/api
NGINX_LOGS_PATH=/var/log/romai/nginx
PROMETHEUS_DATA_PATH=/var/lib/romai/data/prometheus
GRAFANA_DATA_PATH=/var/lib/romai/data/grafana
BACKUP_DATA_PATH=/var/lib/romai/backups

# Public URLs (configure for your domain)
NEXT_PUBLIC_API_URL=https://api.romai.your-domain.com
NEXT_PUBLIC_AGI_URL=https://agi.romai.your-domain.com
NEXT_PUBLIC_CBD_URL=https://cbd.romai.your-domain.com

# Production Optimization
NODE_OPTIONS=--max-old-space-size=4096
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:1024

# Feature Flags
ENABLE_MATHEMATICAL_REASONING=true
ENABLE_AUTONOMOUS_PROBLEM_SOLVING=true
ENABLE_META_LEARNING=true
ENABLE_REAL_TIME_LEARNING=true
ENABLE_CODE_GENERATION=true
ENABLE_RLHF_TRAINING=true
ENABLE_CONSTITUTIONAL_AI=true
ENABLE_MULTIMODAL_TRAINING=true
ENABLE_SYNTHETIC_DATA_GENERATION=true
ENABLE_ADVANCED_TRAINING_METHODOLOGIES=true
ENABLE_ROMANIAN_LANGUAGE_SPECIALIZATION=true

# Security & Compliance
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS_STRICT=true
ENABLE_SSL_ONLY=true