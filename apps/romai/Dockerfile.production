# ==============================================================================
# RomAI AGI Production Deployment - Multi-Stage Optimized Container
# ==============================================================================
# Production-grade containerization with security, performance, and monitoring
# Implements Todo #15: Production Deployment Optimization
#
# Features:
# - Multi-stage builds for optimal size and security
# - Advanced dependency caching and layer optimization
# - Production security hardening
# - Health monitoring and observability
# - Resource optimization and scaling readiness
# - ML model serving with GPU acceleration support
# - Distributed training capabilities
# ==============================================================================

# Build stage - Frontend Application
FROM node:20-alpine AS frontend-builder

# Metadata
LABEL maintainer="RomAI AGI Team"
LABEL version="1.0.0"
LABEL description="RomAI AGI Production Frontend Builder"

# Install build dependencies
RUN apk add --no-cache \
    python3 \
    py3-pip \
    make \
    g++ \
    curl \
    git

# Create non-root user for builds
RUN addgroup -g 1001 -S builduser && \
    adduser -S builduser -u 1001 -G builduser

# Set working directory
WORKDIR /app

# Copy package files for dependency caching
COPY package.json package-lock.json* ./
RUN chown -R builduser:builduser /app

# Switch to non-root user for dependency installation
USER builduser

# Install dependencies with production optimizations
RUN npm ci --only=production --prefer-offline --no-audit --cache=/tmp/.npm-cache

# Copy source code
COPY --chown=builduser:builduser . .

# Build the application with production optimizations
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV DISABLE_ESLINT_PLUGIN=true

RUN npm run build && \
    npm prune --production && \
    npm cache clean --force

# ==============================================================================
# Python ML Runtime - Advanced Training and Inference
# ==============================================================================

FROM python:3.11-slim AS python-ml-runtime

# Metadata
LABEL stage="ml-runtime"
LABEL description="Python ML Runtime with Advanced Training Capabilities"

# Install system dependencies for ML workloads
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    libssl-dev \
    libffi-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    zlib1g-dev \
    libncursesw5-dev \
    libgdbm-dev \
    libc6-dev \
    tk-dev \
    libxml2-dev \
    libxmlsec1-dev \
    libjpeg-dev \
    libpng-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create ML user
RUN groupadd -g 1001 mluser && \
    useradd -r -u 1001 -g mluser -s /bin/bash mluser

# Set up ML environment
WORKDIR /app/ml

# Copy ML requirements with advanced training dependencies
COPY src/ml/requirements*.txt ./

# Create comprehensive requirements file for production
RUN cat > requirements.production.txt << 'EOF'
# Core ML Dependencies
torch>=2.0.0
transformers>=4.35.0
accelerate>=0.24.0
datasets>=2.14.0
tokenizers>=0.14.0

# Advanced Training Methodologies
peft>=0.6.0
trl>=0.7.0
bitsandbytes>=0.41.0
deepspeed>=0.12.0
flash-attn>=2.3.0

# Romanian Language Processing
spacy>=3.7.0
ro-core-news-sm @ https://github.com/explosion/spacy-models/releases/download/ro_core_news_sm-3.7.0/ro_core_news_sm-3.7.0-py3-none-any.whl
sentence-transformers>=2.2.0

# Production API Framework
fastapi>=0.104.0
uvicorn[standard]>=0.24.0
pydantic>=2.4.0
python-multipart>=0.0.6

# Monitoring and Observability
prometheus-client>=0.18.0
opentelemetry-api>=1.20.0
opentelemetry-sdk>=1.20.0
structlog>=23.2.0

# Database and Caching
redis>=5.0.0
asyncpg>=0.29.0
sqlalchemy>=2.0.0
alembic>=1.12.0

# Security and Authentication
cryptography>=41.0.0
python-jose[cryptography]>=3.3.0
passlib[bcrypt]>=1.7.4

# Performance and Optimization
orjson>=3.9.0
httpx>=0.25.0
aiofiles>=23.2.0

# GPU Acceleration (CUDA support)
nvidia-ml-py>=12.535.0
cupy-cuda12x>=12.2.0

# Development and Testing
pytest>=7.4.0
pytest-asyncio>=0.21.0
pytest-cov>=4.1.0
black>=23.9.0
isort>=5.12.0
flake8>=6.1.0

# Enterprise Features
kubernetes>=28.1.0
azure-identity>=1.15.0
azure-keyvault-secrets>=4.7.0
boto3>=1.29.0
EOF

# Install ML dependencies with optimization
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.production.txt && \
    python -m spacy download ro_core_news_sm && \
    pip cache purge

# Copy ML training systems
COPY --chown=mluser:mluser src/ml/ ./

# Set permissions
RUN chown -R mluser:mluser /app/ml

# ==============================================================================
# Production Runtime - Optimized Final Stage
# ==============================================================================

FROM python:3.11-slim AS production-runtime

# Metadata for production image
LABEL stage="production"
LABEL version="1.0.0"
LABEL description="RomAI AGI Production Runtime - World-Class AGI System"
LABEL org.opencontainers.image.title="RomAI AGI"
LABEL org.opencontainers.image.description="Advanced General Intelligence with Romanian Language Specialization"
LABEL org.opencontainers.image.vendor="RomAI Team"
LABEL org.opencontainers.image.version="1.0.0"

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Node.js runtime
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Create production users and directories
RUN groupadd -g 1001 romai && \
    useradd -r -u 1001 -g romai -d /app -s /bin/bash romai && \
    mkdir -p /app/logs /app/cache /app/models /app/data && \
    chown -R romai:romai /app

# Set working directory
WORKDIR /app

# Copy Python ML runtime from previous stage
COPY --from=python-ml-runtime --chown=romai:romai /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=python-ml-runtime --chown=romai:romai /usr/local/bin /usr/local/bin
COPY --from=python-ml-runtime --chown=romai:romai /app/ml ./src/ml

# Copy built frontend from builder stage
COPY --from=frontend-builder --chown=romai:romai /app/.next ./.next
COPY --from=frontend-builder --chown=romai:romai /app/public ./public
COPY --from=frontend-builder --chown=romai:romai /app/package.json ./package.json
COPY --from=frontend-builder --chown=romai:romai /app/node_modules ./node_modules

# Copy production configuration
COPY --chown=romai:romai next.config.js ./
COPY --chown=romai:romai tailwind.config.js ./
COPY --chown=romai:romai tsconfig.json ./

# Copy production scripts and configurations
COPY --chown=romai:romai deployment/ ./deployment/
COPY --chown=romai:romai scripts/ ./scripts/

# Create production environment configuration
RUN cat > .env.production << 'EOF'
# Production Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Server Configuration
PORT=6100
ROMAI_AGI_HOST=0.0.0.0
ROMAI_AGI_PORT=6101
ROMAI_LOG_LEVEL=info

# ML Model Configuration
MODEL_CACHE_DIR=/app/cache/models
TRANSFORMERS_CACHE=/app/cache/transformers
HF_HOME=/app/cache/huggingface

# Performance Optimization
NODE_OPTIONS=--max-old-space-size=4096
PYTHONPATH=/app/src

# Security
DISABLE_X_POWERED_BY=true
HELMET_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

# Romanian Language Specialization
ROMANIAN_LANGUAGE_ENABLED=true
CULTURAL_ANALYSIS_ENABLED=true
DIALECT_DETECTION_ENABLED=true
EOF

# Set environment
ENV NODE_ENV=production
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/scripts:$PATH"

# Switch to non-root user
USER romai

# Create startup script
RUN cat > /app/start-production.sh << 'EOF'
#!/bin/bash
set -e

echo "🚀 Starting RomAI AGI Production System..."
echo "📅 $(date)"
echo "🌍 Environment: $NODE_ENV"

# Start ML model server in background
echo "🧠 Starting ML Model Server (Port 6101)..."
cd /app/src/ml/serving
python model_server.py --port 6101 --host 0.0.0.0 --production &
ML_PID=$!

# Wait for ML server to be ready
echo "⏳ Waiting for ML server to be ready..."
for i in {1..30}; do
    if curl -f http://localhost:6101/health > /dev/null 2>&1; then
        echo "✅ ML server ready!"
        break
    fi
    if [ $i -eq 30 ]; then
        echo "❌ ML server failed to start"
        exit 1
    fi
    sleep 2
done

# Start Next.js frontend
echo "🌐 Starting Frontend Server (Port 6100)..."
cd /app
exec npm start
EOF

RUN chmod +x /app/start-production.sh

# Expose ports
EXPOSE 6100 6101 9090

# Volume mounts for persistence
VOLUME ["/app/logs", "/app/cache", "/app/models", "/app/data"]

# Health check with comprehensive validation
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:6100/api/health && \
        curl -f http://localhost:6101/health && \
        curl -f http://localhost:9090/metrics || exit 1

# Production startup
CMD ["/app/start-production.sh"]

# Security scanning labels
LABEL security.scan.enabled="true"
LABEL security.vulnerability.scanner="trivy"
LABEL security.compliance.level="production"

# Performance optimization labels
LABEL performance.optimization.level="maximum"
LABEL performance.caching.enabled="true"
LABEL performance.monitoring.enabled="true"

# Operational metadata
LABEL operational.environment="production"
LABEL operational.scaling.enabled="true"
LABEL operational.backup.enabled="true"
LABEL operational.monitoring.prometheus="enabled"
LABEL operational.logging.structured="true"