{
  "name": "@codai/romai-api-server",
  "version": "0.1.0",
  "description": "ROMAI REST API Server Application - Romanian AI Central Intelligence",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm exec eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm exec eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "keywords": [
    "romai",
    "api",
    "server",
    "romanian",
    "ai",
    "codai",
    "intelligence"
  ],
  "author": "CODAI Contributors",
  "license": "MIT",
  "dependencies": {
    "@codai/security": "workspace:*",
    "@codai/romai-api": "workspace:*",
    "@codai/romai-core": "workspace:*",
    "@codai/romai-types": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ]
}