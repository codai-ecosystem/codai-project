      }

# ML Job Datafeed Configurations

PUT _ml/datafeeds/datafeed-romai-response-time-anomaly
{
        "job_id": "romai-response-time-anomaly",
        "indices": [
          "romai-logs-*"
        ],
        "query": {
          "bool": {
            "must": [
              {
                "exists": {
                  "field": "response_time"
                }
              },
              {
                "range": {
                  "response_time": {
                    "gte": 0
                  }
                }
              }
            ]
          }
        },
        "scroll_size": 1000,
        "frequency": "15m",
        "query_delay": "60s",
        "chunking_config": {
          "mode": "auto"
        }
      }

PUT _ml/datafeeds/datafeed-romai-error-rate-anomaly
{
        "job_id": "romai-error-rate-anomaly",
        "indices": [
          "romai-logs-*"
        ],
        "query": {
          "bool": {
            "should": [
              {
                "term": {
                  "severity": "error"
                }
              },
              {
                "term": {
                  "severity": "warning"
                }
              },
              {
                "term": {
                  "severity": "critical"
                }
              }
            ]
          }
        },
        "scroll_size": 1000,
        "frequency": "10m",
        "query_delay": "30s"
      }

PUT _ml/datafeeds/datafeed-romai-security-anomaly
{
        "job_id": "romai-security-anomaly",
        "indices": [
          "romai-logs-*"
        ],
        "query": {
          "bool": {
            "should": [
              {
                "term": {
                  "log_type": "security"
                }
              },
              {
                "term": {
                  "log_type": "auth"
                }
              },
              {
                "exists": {
                  "field": "auth_event"
                }
              },
              {
                "exists": {
                  "field": "threat_score"
                }
              }
            ]
          }
        },
        "scroll_size": 500,
        "frequency": "5m",
        "query_delay": "30s"
      }

PUT _ml/datafeeds/datafeed-romai-performance-forecasting
{
        "job_id": "romai-performance-forecasting",
        "indices": [
          "romai-logs-*"
        ],
        "query": {
          "bool": {
            "should": [
              {
                "exists": {
                  "field": "cpu_usage_percent"
                }
              },
              {
                "exists": {
                  "field": "memory_used_mb"
                }
              },
              {
                "exists": {
                  "field": "db_query_time"
                }
              }
            ]
          }
        },
        "scroll_size": 2000,
        "frequency": "1h",
        "query_delay": "5m",
        "aggregations": {
          "buckets": {
            "date_histogram": {
              "field": "@timestamp",
              "fixed_interval": "1h"
            },
            "aggs": {
              "avg_cpu": {
                "avg": {
                  "field": "cpu_usage_percent"
                }
              },
              "avg_memory": {
                "avg": {
                  "field": "memory_used_mb"
                }
              },
              "avg_db_time": {
                "avg": {
                  "field": "db_query_time"
                }
              },
              "request_count": {
                "value_count": {
                  "field": "@timestamp"
                }
              }
            }
          }
        }
      }

PUT _ml/datafeeds/datafeed-romai-user-behavior-anomaly
{
        "job_id": "romai-user-behavior-anomaly",
        "indices": [
