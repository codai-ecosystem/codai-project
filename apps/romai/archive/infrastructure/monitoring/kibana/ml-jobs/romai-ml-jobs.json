{
  "ml_jobs": [
    {
      "name": "romai-response-time-anomaly",
      "endpoint": "PUT _ml/anomaly_detectors/romai-response-time-anomaly",
      "config": {
        "description": "ROMAI response time anomaly detection with multi-metric analysis",
        "analysis_config": {
          "bucket_span": "15m",
          "detectors": [
            {
              "detector_description": "Response time anomalies by service",
              "function": "mean",
              "field_name": "response_time",
              "by_field_name": "service"
            },
            {
              "detector_description": "Response time percentile anomalies",
              "function": "high_percentile",
              "field_name": "response_time",
              "percentile": 95
            },
            {
              "detector_description": "Response time variance detection",
              "function": "varp",
              "field_name": "response_time"
            }
          ],
          "influencers": [
            "service",
            "endpoint",
            "user_id",
            "client_ip"
          ],
          "model_plot_config": {
            "enabled": true,
            "annotations_enabled": true
          }
        },
        "data_description": {
          "time_field": "@timestamp",
          "time_format": "epoch_ms"
        },
        "results_index_name": "romai-ml-response-time-results",
        "model_snapshot_retention_days": 30,
        "daily_model_snapshot_retention_after_days": 1
      }

PUT _ml/anomaly_detectors/romai-error-rate-anomaly
{
        "description": "ROMAI error rate spike detection with contextual analysis",
        "analysis_config": {
          "bucket_span": "10m",
          "detectors": [
            {
              "detector_description": "Error rate spikes by service",
              "function": "count",
              "by_field_name": "service",
              "detector_rules": [
                {
                  "actions": [
                    "skip_result"
                  ],
                  "conditions": [
                    {
                      "applies_to": "actual",
                      "operator": "lt",
                      "value": 5
                    }
                  ]
                }
              ]
            },
            {
              "detector_description": "Critical error anomalies",
              "function": "rare",
              "by_field_name": "error_code"
            },
            {
              "detector_description": "Error pattern changes",
              "function": "freq_rare",
              "field_name": "error_message"
            }
          ],
          "influencers": [
            "service",
            "error_code",
            "endpoint",
            "user_id"
          ],
          "model_plot_config": {
            "enabled": true
          }
        },
        "data_description": {
          "time_field": "@timestamp",
          "time_format": "epoch_ms"
        },
        "analysis_limits": {
          "model_memory_limit": "256mb"
        },
        "results_index_name": "romai-ml-error-rate-results"
      }

PUT _ml/anomaly_detectors/romai-security-anomaly
{
        "description": "ROMAI security event anomaly detection with threat analysis",
        "analysis_config": {
          "bucket_span": "5m",
          "detectors": [
            {
              "detector_description": "Unusual authentication patterns",
              "function": "count",
              "by_field_name": "client_ip",
              "over_field_name": "auth_event"
            },
            {
              "detector_description": "Suspicious access patterns",
              "function": "time_of_day",
              "by_field_name": "user_id"
            },
            {
              "detector_description": "Geographic anomalies",
              "function": "rare",
              "by_field_name": "geoip.country_name",
              "over_field_name": "user_id"
            },
            {
              "detector_description": "API abuse detection",
              "function": "high_count",
              "by_field_name": "endpoint",
              "over_field_name": "client_ip"
            }
          ],
          "influencers": [
            "client_ip",
            "user_id",
            "geoip.country_name",
            "endpoint"
          ],
          "model_plot_config": {
            "enabled": true,
            "annotations_enabled": true
          }
        },
        "data_description": {
          "time_field": "@timestamp",
          "time_format": "epoch_ms"
        },
        "analysis_limits": {
          "model_memory_limit": "512mb",
          "categorization_examples_limit": 4
        },
        "results_index_name": "romai-ml-security-results"
      }

