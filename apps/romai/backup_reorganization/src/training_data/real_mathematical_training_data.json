        {
            "problem": "What is the derivative of x^3?",
            "solution": "3x^2",
            "method": "power_rule",
            "steps": [
                "Apply power rule: d/dx[x^n] = nx^(n-1)",
                "d/dx[x^3] = 3x^(3-1) = 3x^2"
            ],
            "difficulty": "intermediate",
            "category": "calculus"
