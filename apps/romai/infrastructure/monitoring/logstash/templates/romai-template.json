{
  "index_patterns": [
    "romai-logs-*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 2,
        "number_of_replicas": 1,
        "refresh_interval": "30s",
        "codec": "best_compression",
        "sort.field": [
          "@timestamp"
        ],
        "sort.order": [
          "desc"
        ],
        "lifecycle": {
          "name": "romai-logs-policy",
          "rollover_alias": "romai-logs"
        },
        "mapping": {
          "total_fields": {
            "limit": 2000
          },
          "depth": {
            "limit": 50
          }
        },
        "analysis": {
          "analyzer": {
            "romai_analyzer": {
              "type": "custom",
              "tokenizer": "standard",
              "filter": [
                "lowercase",
                "stop",
                "snowball"
              ]
            }
          }
        }
      }
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "@version": {
          "type": "keyword"
        },
        "message": {
          "type": "text",
          "analyzer": "romai_analyzer",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "level": {
          "type": "keyword"
        },
        "severity": {
          "type": "keyword"
        },
        "service": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "log_type": {
          "type": "keyword"
        },
        "cluster": {
          "type": "keyword"
        },
        "host": {
          "type": "object",
          "properties": {
            "name": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            },
            "hostname": {
              "type": "keyword"
            }
          }
        },
        "container": {
          "type": "object",
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "image": {
              "type": "keyword"
            }
          }
        },
        "correlation_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "client_ip": {
          "type": "ip"
        },
        "user_agent": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "request": {
          "type": "object",
          "properties": {
            "method": {
              "type": "keyword"
            },
            "url": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            },
            "query": {
              "type": "text"
            },
            "headers": {
              "type": "object",
              "enabled": false
            }
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "status_code": {
              "type": "integer"
            },
            "size": {
              "type": "long"
            },
            "time": {
              "type": "float"
            }
          }
        },
        "response_time": {
          "type": "float"
        },
        "status_code": {
          "type": "integer"
        },
        "error": {
          "type": "object",
          "properties": {
            "type": {
              "type": "keyword"
            },
            "message": {
              "type": "text",
              "analyzer": "romai_analyzer"
            },
            "stack_trace": {
              "type": "text",
              "index": false
            }
          }
        },
        "error_type": {
          "type": "keyword"
        },
        "error_details": {
          "type": "text",
          "analyzer": "romai_analyzer"
        },
        "contains_error": {
          "type": "boolean"
        },
        "performance_issue": {
          "type": "keyword"
        },
        "sql_query": {
          "type": "text",
          "analyzer": "romai_analyzer",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "query_duration": {
          "type": "float"
        },
        "intelligence_type": {
          "type": "keyword"
        },
        "auth_event": {
          "type": "keyword"
        },
        "geoip": {
          "type": "object",
          "properties": {
            "country_name": {
              "type": "keyword"
            },
            "country_code2": {
              "type": "keyword"
            },
            "city_name": {
              "type": "keyword"
            },
            "location": {
              "type": "geo_point"
            },
            "region_name": {
              "type": "keyword"
            },
            "timezone": {
              "type": "keyword"
            }
          }
        },
        "processed_at": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "tags": {
          "type": "keyword"
        },
        "fields": {
          "type": "object",
          "enabled": false
        }
      }
    }
  }
}