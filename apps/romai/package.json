{
  "name": "romai",
  "version": "1.0.0",
  "description": "Romanian AI assistant",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "keywords": [
    "ai",
    "artificial-intelligence",
    "romanian",
    "mcp",
    "model-context-protocol",
    "azure-openai",
    "typescript",
    "monorepo",
    "codai",
    "intelligence"
  ],
  "homepage": "https://romai.ro",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodAI-Project/codai-project.git",
    "directory": "apps/romai"
  },
  "license": "MIT",
  "author": {
    "name": "CODAI Contributors",
    "email": "team@codai.ro",
    "url": "https://codai.ro"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 6100",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter './packages/*' test:integration && pnpm --filter './apps/*' test:integration",
    "lint": "next lint",
    "lint:fix": "pnpm --filter './packages/*' lint:fix && pnpm --filter './apps/*' lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "pnpm --filter './packages/*' clean && pnpm --filter './apps/*' clean",
    "clean:dist": "pnpm --filter './packages/*' clean && pnpm --filter './apps/*' clean",
    "reset": "pnpm clean && pnpm install",
    "mcp:start": "cd apps/mcp-server && pnpm start",
    "mcp:dev": "cd apps/mcp-server && pnpm dev",
    "mcp:build": "cd apps/mcp-server && pnpm build",
    "api:start": "cd apps/api && pnpm start",
    "api:dev": "cd apps/api && pnpm dev",
    "api:build": "cd apps/api && pnpm build",
    "dashboard:start": "cd apps/dashboard && pnpm start",
    "dashboard:dev": "cd apps/dashboard && pnpm dev",
    "dashboard:build": "cd apps/dashboard && pnpm build",
    "start:all": "concurrently \"pnpm mcp:start\" \"pnpm api:start\" \"pnpm dashboard:start\"",
    "dev:all": "concurrently \"pnpm mcp:dev\" \"pnpm api:dev\" \"pnpm dashboard:dev\"",
    "health:check": "node -e \"console.log('ROMAI Health Check: OK')\"",
    "version:check": "node -e \"console.log('ROMAI Version:', require('./package.json').version)\"",
    "info": "pnpm version:check && pnpm workspace:list",
    "start": "next start -p 6100",
    "test:run": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "next": "^15.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "geist": "^1.4.2",
    "@codai/shared-ui": "workspace:*",
    "@codai/translations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "eslint-config-next": "^15.4.1"
  }
}
