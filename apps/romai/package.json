{
  "name": "romai",
  "version": "1.0.0",
  "description": "Romanian AI assistant",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "keywords": [
    "ai",
    "artificial-general-intelligence",
    "agi",
    "romanian",
    "mcp",
    "model-context-protocol",
    "azure-openai",
    "typescript",
    "python",
    "polyglot",
    "functional-organization",
    "domain-driven-design",
    "consciousness",
    "meta-learning",
    "cultural-intelligence",
    "multimodal",
    "monorepo",
    "codai",
    "intelligence"
  ],
  "homepage": "https://romai.ro",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodAI-Project/codai-project.git",
    "directory": "apps/romai"
  },
  "license": "MIT",
  "author": {
    "name": "CODAI Contributors",
    "email": "team@codai.ro",
    "url": "https://codai.ro"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=6.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 6100",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "rm -rf .next dist",
    "reset": "pnpm clean && pnpm install",
    "health:check": "node -e \"console.log('ROMAI Health Check: OK')\"",
    "version:check": "node -e \"console.log('ROMAI Version:', require('./package.json').version)\"",
    "start": "next start -p 6100",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@codai/shared-types": "^1.0.0",
    "dotenv": "^17.2.0",
    "framer-motion": "^12.23.12",
    "geist": "^1.4.2",
    "lucide-react": "^0.536.0",
    "next": "^15.4.5",
    "next-intl": "^4.0.7",
    "openai": "^5.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}