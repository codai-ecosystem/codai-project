{
  "name": "@codai/romai-core",
  "version": "0.1.6",
  "description": "Core intelligence engine for ROMAI ecosystem - Romanian AI Central Intelligence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "pnpm exec tsc --noEmit",
    "lint": "pnpm exec eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm exec eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "romai",
    "core",
    "intelligence",
    "romanian",
    "ai",
    "codai",
    "engine"
  ],
  "author": "CODAI Contributors",
  "license": "MIT",
  "dependencies": {
    "@codai/romai-types": "^0.1.3",
    "openai": "^4.78.1",
    "zod": "^3.24.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
