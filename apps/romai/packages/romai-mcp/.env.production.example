# Production Environment Variables for ROMAI Ultimate MCP Server
# Copy this file to .env and configure with your actual values

# =================================
# CORE CONFIGURATION
# =================================
NODE_ENV=production
ROMAI_ENV=production
PORT=3000

# =================================
# SECURITY CONFIGURATION
# =================================
ROMAI_SECURITY_ENABLED=true

# JWT Configuration - CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-minimum-64-chars-long-change-in-production
JWT_EXPIRES_IN=24h

# Password Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000

# =================================
# DATABASE CONFIGURATION
# =================================
# PostgreSQL Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name
# Example: postgresql://romai:secure_password@postgres-service:5432/romai

# Alternative individual DB settings
DB_HOST=postgres-service
DB_PORT=5432
DB_NAME=romai
DB_USER=romai
DB_PASSWORD=secure_database_password

# =================================
# CACHE CONFIGURATION
# =================================
# Redis Configuration
REDIS_URL=redis://:password@host:6379
# Example: redis://:secure_redis_password@redis-service:6379

# Alternative individual Redis settings
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password

# =================================
# MONITORING CONFIGURATION
# =================================
ROMAI_MONITORING_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# Alert Configuration
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_EMAIL_RECIPIENTS=admin@yourcompany.com,ops@yourcompany.com

# =================================
# LOGGING CONFIGURATION
# =================================
ROMAI_LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_ROTATION_SIZE=10M
LOG_RETENTION_DAYS=30

# =================================
# AI SERVICES CONFIGURATION
# =================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google AI Configuration
GOOGLE_AI_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-pro

# =================================
# CLOUD SERVICES CONFIGURATION
# =================================
# AWS Configuration (for S3, CloudWatch, etc.)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=romai-backups-prod

# =================================
# EXTERNAL INTEGRATIONS
# =================================
# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Email Service (SendGrid example)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@yourcompany.com

# =================================
# SSL/TLS CONFIGURATION
# =================================
# SSL Certificate paths
SSL_CERT_PATH=/etc/ssl/certs/romai.crt
SSL_KEY_PATH=/etc/ssl/private/romai.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# =================================
# PERFORMANCE CONFIGURATION
# =================================
# Memory and CPU limits
MAX_MEMORY_USAGE=512MB
MAX_CPU_USAGE=80

# Connection limits
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30000

# =================================
# BACKUP CONFIGURATION
# =================================
# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-here

# =================================
# MONITORING SERVICES
# =================================
# Prometheus Configuration
PROMETHEUS_ENDPOINT=http://prometheus:9090

# Grafana Configuration
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=your-grafana-api-key

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=romai-logs

# =================================
# DEVELOPMENT OVERRIDES
# =================================
# Only use these in development environments
# DEV_DISABLE_AUTH=false
# DEV_ENABLE_CORS=false
# DEV_LOG_REQUESTS=false

# =================================
# CUSTOM CONFIGURATION
# =================================
# Add your custom environment variables here
# CUSTOM_FEATURE_FLAG=true
# CUSTOM_API_ENDPOINT=https://api.yourservice.com
# CUSTOM_TIMEOUT=10000
