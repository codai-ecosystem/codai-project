{
  "environment": "development",
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "timeouts": {
      "request": 30000,
      "keepAlive": 5000,
      "headersTimeout": 60000
    },
    "compression": {
      "enabled": false
    }
  },
  "security": {
    "enabled": true,
    "jwt": {
      "algorithm": "HS256",
      "expiresIn": "7d",
      "issuer": "romai-mcp-server-dev",
      "audience": "romai-mcp-clients-dev"
    },
    "rateLimiting": {
      "enabled": false,
      "windowMs": 900000,
      "maxRequests": 10000
    },
    "cors": {
      "enabled": true,
      "origin": "*",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With"
      ],
      "credentials": true
    },
    "helmet": {
      "enabled": false
    },
    "ipBlocking": {
      "enabled": false
    },
    "passwordPolicy": {
      "minLength": 8,
      "requireUppercase": false,
      "requireLowercase": false,
      "requireNumbers": false,
      "requireSpecialChars": false
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "enabled": true,
      "port": 9090,
      "path": "/metrics",
      "collectDefaultMetrics": true,
      "collectProcessMetrics": true,
      "collectHttpMetrics": true
    },
    "healthCheck": {
      "enabled": true,
      "path": "/health",
      "interval": 30000,
      "timeout": 5000,
      "retries": 3
    },
    "alerts": {
      "enabled": false
    },
    "tracing": {
      "enabled": false
    }
  },
  "logging": {
    "level": "debug",
    "format": "pretty",
    "output": {
      "console": true,
      "file": true,
      "syslog": false
    },
    "file": {
      "enabled": true,
      "path": "./logs",
      "filename": "romai-mcp-dev.log",
      "maxSize": "10MB",
      "maxFiles": 5,
      "compress": false
    },
    "structured": {
      "enabled": false
    },
    "filters": {
      "excludeHealthChecks": false,
      "excludeMetrics": false,
      "sensitiveFields": [
        "password",
        "token",
        "secret",
        "key",
        "auth"
      ]
    }
  },
  "database": {
    "connection": {
      "pool": {
        "min": 1,
        "max": 10,
        "acquireTimeoutMillis": 30000,
        "createTimeoutMillis": 30000,
        "destroyTimeoutMillis": 5000,
        "idleTimeoutMillis": 30000
      },
      "migrations": {
        "directory": "./migrations",
        "tableName": "migrations",
        "schemaName": "public"
      }
    }
  },
  "cache": {
    "redis": {
      "keyPrefix": "romai:dev:",
      "ttl": 1800,
      "maxRetries": 3,
      "retryDelayOnFailover": 100
    }
  },
  "api": {
    "version": "v1",
    "prefix": "/api",
    "documentation": {
      "enabled": true,
      "path": "/docs",
      "title": "ROMAI Ultimate MCP Server API - Development",
      "description": "Development API for ROMAI Ultimate MCP Server"
    },
    "validation": {
      "enabled": true,
      "strict": false,
      "stripUnknown": false,
      "abortEarly": true
    }
  },
  "tools": {
    "romai": {
      "enabled": true,
      "timeout": 60000,
      "retries": 1,
      "circuitBreaker": {
        "enabled": false
      }
    },
    "external": {
      "timeout": 30000,
      "retries": 1,
      "rateLimit": {
        "enabled": false
      }
    }
  },
  "performance": {
    "clustering": {
      "enabled": false
    },
    "caching": {
      "enabled": false
    },
    "compression": {
      "enabled": false
    }
  },
  "backup": {
    "enabled": false
  }
}