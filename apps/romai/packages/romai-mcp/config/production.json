{
  "environment": "production",
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "timeouts": {
      "request": 30000,
      "keepAlive": 5000,
      "headersTimeout": 60000
    },
    "compression": {
      "enabled": true,
      "level": 6,
      "threshold": 1024
    }
  },
  "security": {
    "enabled": true,
    "jwt": {
      "algorithm": "HS256",
      "expiresIn": "24h",
      "issuer": "romai-mcp-server",
      "audience": "romai-mcp-clients"
    },
    "rateLimiting": {
      "enabled": true,
      "windowMs": 900000,
      "maxRequests": 1000,
      "skipSuccessfulRequests": false,
      "skipFailedRequests": false,
      "standardHeaders": true,
      "legacyHeaders": false
    },
    "cors": {
      "enabled": true,
      "origin": [
        "https://api.romai.dev",
        "https://dashboard.romai.dev",
        "https://monitoring.romai.dev"
      ],
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Requested-With"
      ],
      "credentials": true,
      "maxAge": 86400
    },
    "helmet": {
      "enabled": true,
      "contentSecurityPolicy": {
        "directives": {
          "defaultSrc": [
            "'self'"
          ],
          "scriptSrc": [
            "'self'",
            "'unsafe-inline'"
          ],
          "styleSrc": [
            "'self'",
            "'unsafe-inline'"
          ],
          "imgSrc": [
            "'self'",
            "data:",
            "https:"
          ],
          "connectSrc": [
            "'self'"
          ],
          "fontSrc": [
            "'self'"
          ],
          "objectSrc": [
            "'none'"
          ],
          "mediaSrc": [
            "'self'"
          ],
          "frameSrc": [
            "'none'"
          ]
        }
      },
      "hsts": {
        "maxAge": 31536000,
        "includeSubDomains": true,
        "preload": true
      }
    },
    "ipBlocking": {
      "enabled": true,
      "maxFailedAttempts": 5,
      "lockoutDuration": 900000,
      "whitelist": [
        "127.0.0.1",
        "::1"
      ],
      "blacklist": []
    },
    "passwordPolicy": {
      "minLength": 12,
      "requireUppercase": true,
      "requireLowercase": true,
      "requireNumbers": true,
      "requireSpecialChars": true,
      "maxAge": 7776000,
      "preventReuse": 12
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "enabled": true,
      "port": 9090,
      "path": "/metrics",
      "collectDefaultMetrics": true,
      "collectProcessMetrics": true,
      "collectHttpMetrics": true
    },
    "healthCheck": {
      "enabled": true,
      "path": "/health",
      "interval": 30000,
      "timeout": 5000,
      "retries": 3
    },
    "alerts": {
      "enabled": true,
      "channels": {
        "slack": {
          "enabled": false,
          "webhookUrl": "",
          "channel": "#alerts",
          "username": "ROMAI Monitor"
        },
        "email": {
          "enabled": false,
          "recipients": [],
          "smtpConfig": {}
        },
        "webhook": {
          "enabled": false,
          "url": "",
          "timeout": 5000
        }
      },
      "thresholds": {
        "errorRate": 0.05,
        "responseTime": 1000,
        "memoryUsage": 0.8,
        "cpuUsage": 0.8,
        "diskUsage": 0.9
      }
    },
    "tracing": {
      "enabled": true,
      "sampleRate": 0.1,
      "serviceName": "romai-mcp-server",
      "jaegerEndpoint": ""
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": {
      "console": true,
      "file": true,
      "syslog": false
    },
    "file": {
      "enabled": true,
      "path": "/app/logs",
      "filename": "romai-mcp.log",
      "maxSize": "10MB",
      "maxFiles": 30,
      "compress": true
    },
    "structured": {
      "enabled": true,
      "includeStack": false,
      "includeCaller": true,
      "includeTimestamp": true,
      "includeLevel": true
    },
    "filters": {
      "excludeHealthChecks": true,
      "excludeMetrics": true,
      "sensitiveFields": [
        "password",
        "token",
        "secret",
        "key",
        "auth"
      ]
    }
  },
  "database": {
    "connection": {
      "pool": {
        "min": 2,
        "max": 20,
        "acquireTimeoutMillis": 30000,
        "createTimeoutMillis": 30000,
        "destroyTimeoutMillis": 5000,
        "idleTimeoutMillis": 30000,
        "reapIntervalMillis": 1000,
        "createRetryIntervalMillis": 200
      },
      "migrations": {
        "directory": "./migrations",
        "tableName": "migrations",
        "schemaName": "public"
      }
    }
  },
  "cache": {
    "redis": {
      "keyPrefix": "romai:prod:",
      "ttl": 3600,
      "maxRetries": 3,
      "retryDelayOnFailover": 100,
      "enableOfflineQueue": false,
      "connectTimeout": 10000,
      "lazyConnect": true,
      "maxRetriesPerRequest": 3
    }
  },
  "api": {
    "version": "v1",
    "prefix": "/api",
    "documentation": {
      "enabled": false,
      "path": "/docs",
      "title": "ROMAI Ultimate MCP Server API",
      "description": "Production API for ROMAI Ultimate MCP Server"
    },
    "validation": {
      "enabled": true,
      "strict": true,
      "stripUnknown": true,
      "abortEarly": false
    },
    "serialization": {
      "removeAdditional": true,
      "useDefaults": true,
      "coerceTypes": false
    }
  },
  "tools": {
    "romai": {
      "enabled": true,
      "timeout": 30000,
      "retries": 3,
      "circuitBreaker": {
        "enabled": true,
        "threshold": 5,
        "timeout": 60000,
        "resetTimeout": 30000
      }
    },
    "external": {
      "timeout": 10000,
      "retries": 2,
      "rateLimit": {
        "enabled": true,
        "requests": 100,
        "windowMs": 60000
      }
    }
  },
  "performance": {
    "clustering": {
      "enabled": false,
      "workers": "auto"
    },
    "caching": {
      "enabled": true,
      "defaultTtl": 300,
      "maxKeys": 10000,
      "checkPeriod": 600
    },
    "compression": {
      "enabled": true,
      "threshold": 1024,
      "level": 6
    }
  },
  "backup": {
    "enabled": true,
    "schedule": "0 2 * * *",
    "retention": {
      "daily": 7,
      "weekly": 4,
      "monthly": 6
    },
    "storage": {
      "type": "s3",
      "bucket": "romai-backups-prod",
      "region": "us-east-1",
      "encryption": true
    }
  }
}