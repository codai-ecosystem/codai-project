/**
 * 🧪 RomAI Frontend Integration Tests
 * Testing frontend-backend integration and API communication
 */

import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'
import { render, screen, fireEvent, waitFor } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { setupServer } from 'msw/node'
import { rest } from 'msw'
import '@testing-library/jest-dom'

// Mock API responses
const server = setupServer(
    // AGI Model Server endpoints
    rest.get('http://localhost:6101/health', (req, res, ctx) => {
        return res(ctx.json({
            status: 'healthy',
            version: '1.0.0',
            service: 'RomAI AGI Model Server',
            performance: {
                mathematical: 0.98,
                logical: 0.975,
                integration: 1.0,
                overall: 0.894
            },
            agents: {
                active: 7,
                coordination_efficiency: 0.91
            }
        }))
    }),

    rest.post('http://localhost:6101/solve', (req, res, ctx) => {
        return res(ctx.json({
            solution: '3*x**2 + 4*x - 5',
            confidence: 0.98,
            reasoning_steps: [
                'Identified polynomial derivative problem',
                'Applied power rule: d/dx[x^n] = n*x^(n-1)',
                'Computed derivative of each term',
                'Simplified final expression'
            ],
            execution_time: 0.342
        }))
    }),

    rest.post('http://localhost:6101/reason', (req, res, ctx) => {
        return res(ctx.json({
            conclusion: 'Socrates is mortal',
            confidence: 0.975,
            reasoning_chain: [
                'Premise 1: All humans are mortal',
                'Premise 2: Socrates is human',
                'Logical rule: Universal instantiation',
                'Conclusion: Socrates is mortal'
            ],
            logical_validity: true,
            reasoning_type: 'deductive'
        }))
    }),

    rest.post('http://localhost:6101/integrate', (req, res, ctx) => {
        return res(ctx.json({
            integration_score: 1.0,
            synergy_detected: true,
            coordination_efficiency: 0.91,
            active_components: ['mathematical', 'reasoning', 'learning'],
            performance_optimization: 0.15
        }))
    }),

    rest.post('http://localhost:6101/detect_fallacy', (req, res, ctx) => {
        return res(ctx.json({
            fallacy_detected: true,
            fallacy_type: 'affirming_the_consequent',
            confidence: 0.975,
            explanation: 'The argument incorrectly assumes that if P implies Q and Q is true, then P must be true.'
        }))
    })
)

// Start server before tests
beforeEach(() => server.listen())
afterEach(() => server.resetHandlers())
afterEach(() => server.close())

// Mock AGI Client that actually makes HTTP requests
class AGIClient {
    private baseUrl = 'http://localhost:6101'

    async getHealth() {
        const response = await fetch(`${this.baseUrl}/health`)
        return response.json()
    }

    async solveMathematical(problem: string) {
        const response = await fetch(`${this.baseUrl}/solve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'mathematical', problem })
        })
        return response.json()
    }

    async processLogicalReasoning(premises: string[], task: string) {
        const response = await fetch(`${this.baseUrl}/reason`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'logical', premises, task })
        })
        return response.json()
    }

    async detectFallacy(argument: string) {
        const response = await fetch(`${this.baseUrl}/detect_fallacy`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'fallacy_detection', argument })
        })
        return response.json()
    }

    async integrateComponents(components: string[], task: string) {
        const response = await fetch(`${this.baseUrl}/integrate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'integration', components, task })
        })
        return response.json()
    }
}

// Test components that use the AGI client
const MathematicalIntegrationTest = () => {
    const [result, setResult] = React.useState<any>(null)
    const [loading, setLoading] = React.useState(false)
    const [error, setError] = React.useState<string | null>(null)

    const client = new AGIClient()

    const handleSolve = async () => {
        setLoading(true)
        setError(null)
        try {
            const response = await client.solveMathematical('derivative of x^3 + 2*x^2 - 5*x + 1')
            setResult(response)
        } catch (err) {
            setError(err instanceof Error ? err.message : 'Unknown error')
        } finally {
            setLoading(false)
        }
    }

    return (
        <div data-testid="math-integration-test">
            <h2>Mathematical Engine Integration Test</h2>
            <button
                data-testid="solve-derivative"
                onClick={handleSolve}
                disabled={loading}
            >
                {loading ? 'Solving...' : 'Solve Derivative'}
            </button>

            {error && (
                <div data-testid="error-message" style={{ color: 'red' }}>
                    Error: {error}
                </div>
            )}

            {result && (
                <div data-testid="math-result">
                    <div data-testid="solution">Solution: {result.solution}</div>
                    <div data-testid="confidence">Confidence: {(result.confidence * 100).toFixed(1)}%</div>
                    <div data-testid="execution-time">Time: {result.execution_time}s</div>
                </div>
            )}
        </div>
    )
}

const LogicalReasoningIntegrationTest = () => {
    const [result, setResult] = React.useState<any>(null)
    const [loading, setLoading] = React.useState(false)

    const client = new AGIClient()

    const handleReason = async () => {
        setLoading(true)
        try {
            const response = await client.processLogicalReasoning(
                ['All humans are mortal', 'Socrates is human'],
                'Draw logical conclusion'
            )
            setResult(response)
        } catch (err) {
            console.error('Reasoning error:', err)
        } finally {
            setLoading(false)
        }
    }

    return (
        <div data-testid="logical-integration-test">
            <h2>Logical Reasoning Integration Test</h2>
            <button
                data-testid="process-reasoning"
                onClick={handleReason}
                disabled={loading}
            >
                {loading ? 'Reasoning...' : 'Process Logic'}
            </button>

            {result && (
                <div data-testid="logical-result">
                    <div data-testid="conclusion">Conclusion: {result.conclusion}</div>
                    <div data-testid="validity">Valid: {result.logical_validity ? 'Yes' : 'No'}</div>
                    <div data-testid="reasoning-confidence">Confidence: {(result.confidence * 100).toFixed(1)}%</div>
                </div>
            )}
        </div>
    )
}

const HealthCheckIntegrationTest = () => {
    const [health, setHealth] = React.useState<any>(null)
    const [loading, setLoading] = React.useState(false)

    const client = new AGIClient()

    const checkHealth = async () => {
        setLoading(true)
        try {
            const response = await client.getHealth()
            setHealth(response)
        } catch (err) {
            console.error('Health check error:', err)
        } finally {
            setLoading(false)
        }
    }

    React.useEffect(() => {
        checkHealth()
    }, [])

    return (
        <div data-testid="health-integration-test">
            <h2>AGI Health Check</h2>
            <button
                data-testid="refresh-health"
                onClick={checkHealth}
                disabled={loading}
            >
                {loading ? 'Checking...' : 'Refresh Health'}
            </button>

            {health && (
                <div data-testid="health-result">
                    <div data-testid="health-status">Status: {health.status}</div>
                    <div data-testid="health-service">Service: {health.service}</div>
                    <div data-testid="health-mathematical">Mathematical: {(health.performance.mathematical * 100).toFixed(1)}%</div>
                    <div data-testid="health-logical">Logical: {(health.performance.logical * 100).toFixed(1)}%</div>
                    <div data-testid="health-overall">Overall: {(health.performance.overall * 100).toFixed(1)}%</div>
                    <div data-testid="health-agents">Active Agents: {health.agents.active}</div>
                </div>
            )}
        </div>
    )
}

describe('RomAI Frontend-Backend Integration Tests', () => {
    describe('Mathematical Engine Integration', () => {
        it('successfully integrates with mathematical solving endpoint', async () => {
            const user = userEvent.setup()
            render(<MathematicalIntegrationTest />)

            const solveButton = screen.getByTestId('solve-derivative')
            await user.click(solveButton)

            // Wait for API response
            await waitFor(() => {
                expect(screen.getByTestId('solution')).toHaveTextContent('Solution: 3*x**2 + 4*x - 5')
            }, { timeout: 3000 })

            expect(screen.getByTestId('confidence')).toHaveTextContent('Confidence: 98.0%')
            expect(screen.getByTestId('execution-time')).toHaveTextContent('Time: 0.342s')
        })

        it('handles loading states correctly', async () => {
            const user = userEvent.setup()
            render(<MathematicalIntegrationTest />)

            const solveButton = screen.getByTestId('solve-derivative')
            await user.click(solveButton)

            // Should show loading state
            expect(solveButton).toHaveTextContent('Solving...')
            expect(solveButton).toBeDisabled()

            // Wait for completion
            await waitFor(() => {
                expect(solveButton).toHaveTextContent('Solve Derivative')
                expect(solveButton).not.toBeDisabled()
            })
        })
    })

    describe('Logical Reasoning Integration', () => {
        it('successfully processes logical reasoning through API', async () => {
            const user = userEvent.setup()
            render(<LogicalReasoningIntegrationTest />)

            const reasonButton = screen.getByTestId('process-reasoning')
            await user.click(reasonButton)

            await waitFor(() => {
                expect(screen.getByTestId('conclusion')).toHaveTextContent('Conclusion: Socrates is mortal')
            }, { timeout: 3000 })

            expect(screen.getByTestId('validity')).toHaveTextContent('Valid: Yes')
            expect(screen.getByTestId('reasoning-confidence')).toHaveTextContent('Confidence: 97.5%')
        })

        it('displays logical validity correctly', async () => {
            const user = userEvent.setup()
            render(<LogicalReasoningIntegrationTest />)

            const reasonButton = screen.getByTestId('process-reasoning')
            await user.click(reasonButton)

            await waitFor(() => {
                const validityElement = screen.getByTestId('validity')
                expect(validityElement).toHaveTextContent('Valid: Yes')
            })
        })
    })

    describe('Health Check Integration', () => {
        it('loads health status on component mount', async () => {
            render(<HealthCheckIntegrationTest />)

            await waitFor(() => {
                expect(screen.getByTestId('health-status')).toHaveTextContent('Status: healthy')
            }, { timeout: 3000 })

            expect(screen.getByTestId('health-service')).toHaveTextContent('Service: RomAI AGI Model Server')
            expect(screen.getByTestId('health-mathematical')).toHaveTextContent('Mathematical: 98.0%')
            expect(screen.getByTestId('health-logical')).toHaveTextContent('Logical: 97.5%')
            expect(screen.getByTestId('health-overall')).toHaveTextContent('Overall: 89.4%')
            expect(screen.getByTestId('health-agents')).toHaveTextContent('Active Agents: 7')
        })

        it('can refresh health status manually', async () => {
            const user = userEvent.setup()
            render(<HealthCheckIntegrationTest />)

            // Wait for initial load
            await waitFor(() => {
                expect(screen.getByTestId('health-status')).toBeInTheDocument()
            })

            const refreshButton = screen.getByTestId('refresh-health')
            await user.click(refreshButton)

            // Should show loading state
            expect(refreshButton).toHaveTextContent('Checking...')

            // Wait for refresh completion
            await waitFor(() => {
                expect(refreshButton).toHaveTextContent('Refresh Health')
            })
        })
    })

    describe('Error Handling Integration', () => {
        it('handles network errors gracefully', async () => {
            // Override server to return error
            server.use(
                rest.post('http://localhost:6101/solve', (req, res, ctx) => {
                    return res(ctx.status(500), ctx.json({ error: 'Internal server error' }))
                })
            )

            const user = userEvent.setup()
            render(<MathematicalIntegrationTest />)

            const solveButton = screen.getByTestId('solve-derivative')
            await user.click(solveButton)

            await waitFor(() => {
                expect(screen.getByTestId('error-message')).toBeInTheDocument()
            })
        })

        it('handles timeout scenarios', async () => {
            // Override server to delay response
            server.use(
                rest.post('http://localhost:6101/solve', (req, res, ctx) => {
                    return res(ctx.delay(5000), ctx.json({ solution: 'delayed' }))
                })
            )

            const user = userEvent.setup()
            render(<MathematicalIntegrationTest />)

            const solveButton = screen.getByTestId('solve-derivative')
            await user.click(solveButton)

            // Should show loading state
            expect(solveButton).toHaveTextContent('Solving...')

            // In a real scenario, this would timeout and show error
            // For this test, we'll just verify the loading state persists
            await new Promise(resolve => setTimeout(resolve, 100))
            expect(solveButton).toHaveTextContent('Solving...')
        })
    })

    describe('Performance Validation Integration', () => {
        it('validates that API responses meet performance expectations', async () => {
            const user = userEvent.setup()

            // Test mathematical performance
            render(<MathematicalIntegrationTest />)
            const solveButton = screen.getByTestId('solve-derivative')

            const startTime = Date.now()
            await user.click(solveButton)

            await waitFor(() => {
                expect(screen.getByTestId('solution')).toBeInTheDocument()
            })

            const endTime = Date.now()
            const responseTime = endTime - startTime

            // Validate response time is reasonable (under 2 seconds for UI responsiveness)
            expect(responseTime).toBeLessThan(2000)

            // Validate confidence meets world-class threshold
            const confidenceText = screen.getByTestId('confidence').textContent
            const confidence = parseFloat(confidenceText?.match(/[\d.]+/)?.[0] || '0')
            expect(confidence).toBeGreaterThan(95) // 95%+ confidence
        })

        it('validates logical reasoning performance standards', async () => {
            const user = userEvent.setup()
            render(<LogicalReasoningIntegrationTest />)

            const reasonButton = screen.getByTestId('process-reasoning')
            await user.click(reasonButton)

            await waitFor(() => {
                expect(screen.getByTestId('reasoning-confidence')).toBeInTheDocument()
            })

            // Validate logical reasoning confidence
            const confidenceText = screen.getByTestId('reasoning-confidence').textContent
            const confidence = parseFloat(confidenceText?.match(/[\d.]+/)?.[0] || '0')
            expect(confidence).toBeGreaterThan(95) // 95%+ confidence for world-class reasoning

            // Validate logical validity
            expect(screen.getByTestId('validity')).toHaveTextContent('Valid: Yes')
        })
    })

    describe('Multi-Component Integration', () => {
        it('coordinates multiple AGI components together', async () => {
            const MultiComponentTest = () => {
                const [mathResult, setMathResult] = React.useState(null)
                const [logicResult, setLogicResult] = React.useState(null)
                const [integrationResult, setIntegrationResult] = React.useState(null)

                const client = new AGIClient()

                const runFullWorkflow = async () => {
                    try {
                        // Step 1: Mathematical solving
                        const math = await client.solveMathematical('x^2 + 2x + 1')
                        setMathResult(math)

                        // Step 2: Logical reasoning
                        const logic = await client.processLogicalReasoning(
                            ['All equations have solutions', 'x^2 + 2x + 1 is an equation'],
                            'conclusion'
                        )
                        setLogicResult(logic)

                        // Step 3: Integration
                        const integration = await client.integrateComponents(
                            ['mathematical', 'reasoning'],
                            'Solve and verify mathematical equation'
                        )
                        setIntegrationResult(integration)
                    } catch (err) {
                        console.error('Workflow error:', err)
                    }
                }

                return (
                    <div data-testid="multi-component-test">
                        <button data-testid="run-workflow" onClick={runFullWorkflow}>
                            Run Full AGI Workflow
                        </button>

                        {mathResult && (
                            <div data-testid="workflow-math">Math: {mathResult.solution}</div>
                        )}
                        {logicResult && (
                            <div data-testid="workflow-logic">Logic: {logicResult.conclusion}</div>
                        )}
                        {integrationResult && (
                            <div data-testid="workflow-integration">
                                Integration Score: {(integrationResult.integration_score * 100).toFixed(0)}%
                            </div>
                        )}
                    </div>
                )
            }

            const user = userEvent.setup()
            render(<MultiComponentTest />)

            const workflowButton = screen.getByTestId('run-workflow')
            await user.click(workflowButton)

            // Wait for all components to complete
            await waitFor(() => {
                expect(screen.getByTestId('workflow-math')).toBeInTheDocument()
                expect(screen.getByTestId('workflow-logic')).toBeInTheDocument()
                expect(screen.getByTestId('workflow-integration')).toBeInTheDocument()
            }, { timeout: 5000 })

            // Validate integration score is perfect (100%)
            expect(screen.getByTestId('workflow-integration')).toHaveTextContent('Integration Score: 100%')
        })
    })
})
