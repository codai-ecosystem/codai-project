{
  "name": "@codai/romcp-web",
  "version": "1.0.0",
  "description": "ROMCP Web Frontend - Modern landing page and dashboard for Cautai search engine",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:e2e": "playwright test",
    "clean": "rimraf .next out",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@codai/cautai-client": "workspace:*",
    "@codai/cautai-i18n": "workspace:*",
    "@codai/cautai-ui": "workspace:*",
    "@next/bundle-analyzer": "^14.1.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@vercel/analytics": "^1.1.2",
    "@vercel/speed-insights": "^1.0.10",
    "framer-motion": "^11.0.3",
    "next": "^14.1.0",
    "next-intl": "^3.6.2",
    "next-themes": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-query": "^3.39.3",
    "sharp": "^0.33.2",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@codai/cautai-config": "workspace:*",
    "@playwright/test": "^1.41.2",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.11.10",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "playwright": "^1.41.2",
    "postcss": "^8.4.35",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.2",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nextjs",
    "react",
    "frontend",
    "web",
    "cautai",
    "romcp",
    "landing",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "apps/romcp-web"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://romcp.ro"
}