# LogAI Integration Configuration

# Development LogAI Service (localhost)
LOGAI_DEV_API_KEY=dev_stocai_key_2025
LOGAI_DEV_BASE_URL=http://localhost:4032

# Production LogAI Service (when deployed)
LOGAI_PRODUCTION_API_KEY=prod_stocai_key_secure_2025
LOGAI_PRODUCTION_URL=https://logai.ro

# Environment detection
NODE_ENV=development

# StocAI Service Configuration
STOCAI_SERVICE_NAME=stocai
STOCAI_LOG_LEVEL=debug
STOCAI_ENABLE_CONSOLE_LOGS=true
STOCAI_LOG_BATCH_SIZE=5
STOCAI_LOG_FLUSH_INTERVAL=3000
