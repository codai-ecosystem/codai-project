# Environment variables for MCP Server Template

# Server Configuration
NODE_ENV=development
SERVER_NAME=@codai/mcp-server-template
SERVER_VERSION=1.0.0
LOG_LEVEL=info

# API Configuration
API_TIMEOUT=30000

# Security Configuration
ENABLE_CORS=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Database Configuration (add as needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/mcpdb

# External API Keys (add as needed)
# OPENAI_API_KEY=your_openai_api_key
# AZURE_API_KEY=your_azure_api_key

# Cache Configuration (add as needed)
# REDIS_URL=redis://localhost:6379
