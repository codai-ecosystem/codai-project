# TALENTAI App Environment Configuration
# Copy this to .env.local and configure your values
# This app inherits configuration from the root .env.local file

# ===========================================
# APP-SPECIFIC CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_NAME=TALENTAI
NEXT_PUBLIC_APP_VERSION=1.0.0
PORT=6600

# ===========================================
# DATABASE (if app-specific needed)
# ===========================================
# DATABASE_URL=postgresql://localhost:5432/talentai
# Note: Use root DATABASE_URL if shared database

# ===========================================
# NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:6600
JWT_SECRET=your-jwt-secret-here

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
NODE_ENV=development
DEBUG_MODE=true
LOG_LEVEL=info
MONITORING_ENABLED=true

# ===========================================
# CORS & SECURITY
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:6600

# ===========================================
# SERVICE-SPECIFIC CONFIGURATION
# ===========================================
# Add service-specific environment variables here
# All API keys and secrets inherit from root .env.local

