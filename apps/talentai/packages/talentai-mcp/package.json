{
    "name": "@codai/talentai-mcp",
    "version": "1.0.0",
    "description": "TalentAI MCP Server - HR and talent management with AI-powered insights",
    "type": "module",
    "main": "dist/server.js",
    "bin": {
        "talentai-mcp": "dist/server.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        }
    },
    "scripts": {
        "build": "npx tsc",
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest watch",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write src/**/*.ts",
        "type-check": "tsc --noEmit",
        "clean": "rimraf dist"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "hr",
        "talent",
        "recruitment",
        "codai",
        "typescript",
        "server"
    ],
    "author": "CODAI Ecosystem",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.6.0",
        "@types/node": "^22.7.9",
        "@types/uuid": "^10.0.0",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.7",
        "openai": "^5.10.1",
        "uuid": "^11.1.0",
        "winston": "^3.11.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "@typescript-eslint/parser": "^8.36.0",
        "@vitest/coverage-v8": "^2.1.8",
        "eslint": "^9.31.0",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "tsx": "^4.19.2",
        "typescript": "^5.8.3",
        "vitest": "^2.1.8"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    }
}