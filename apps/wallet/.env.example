# WALLET Environment Configuration
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://localhost:5432/wallet"

# API Configuration  
PORT=3143
CORS_ORIGINS="http://localhost:3000"

# Security
JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Integration API Keys
ETHERS_ENABLED=false
ETHERS_API_KEY="your-api-key-here"
ETHERS_BASE_URL="https://api.example.com"
WEB3_ENABLED=false
WEB3_API_KEY="your-api-key-here"
WEB3_BASE_URL="https://api.example.com"
_SOLANA_WEB3.JS_ENABLED=false
_SOLANA_WEB3.JS_API_KEY="your-api-key-here"
_SOLANA_WEB3.JS_BASE_URL="https://api.example.com"
BITCOINJS_LIB_ENABLED=false
BITCOINJS_LIB_API_KEY="your-api-key-here"
BITCOINJS_LIB_BASE_URL="https://api.example.com"
_UNISWAP_SDK_ENABLED=false
_UNISWAP_SDK_API_KEY="your-api-key-here"
_UNISWAP_SDK_BASE_URL="https://api.example.com"
METAMASK_SDK_ENABLED=false
METAMASK_SDK_API_KEY="your-api-key-here"
METAMASK_SDK_BASE_URL="https://api.example.com"
_WALLETCONNECT_CLIENT_ENABLED=false
_WALLETCONNECT_CLIENT_API_KEY="your-api-key-here"
_WALLETCONNECT_CLIENT_BASE_URL="https://api.example.com"

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL="info"

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_REALTIME=true
FEATURE_EXPERIMENTAL=false