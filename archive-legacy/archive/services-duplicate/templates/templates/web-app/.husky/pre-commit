#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-commit checks..."

# Run linting and formatting
echo "📝 Running lint-staged..."
pnpm lint-staged || exit 1

# TypeScript compilation check
echo "🔧 Checking TypeScript compilation..."
pnpm type-check || exit 1

# Detect excessive 'any' usage
echo "🔍 Checking for excessive 'any' usage..."
pnpm ts:any-check || (
  echo "❌ Found excessive 'any' usage. Please fix before committing."
  exit 1
)

# Run unit tests on staged files
echo "🧪 Running tests for staged files..."
pnpm test:staged || exit 1

# Check for accessibility issues
echo "♿ Running accessibility checks..."
pnpm a11y:check || (
  echo "⚠️ Accessibility issues found. Please review before committing."
  exit 1
)

# Check bundle size impact
echo "📦 Checking bundle size impact..."
pnpm analyze:diff || (
  echo "⚠️ Significant bundle size increase detected. Please review."
)

echo "✅ All pre-commit checks passed!"
