{
    "name": "@memorai/api-service",
    "version": "1.0.0",
    "description": "MemorAI Core API Service - Express.js backend with CBD database integration",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prestart": "pnpm build",
        "health": "curl -f http://localhost:4010/health || exit 1"
    },
    "dependencies": {
        "@codai/cbd": "workspace:*",
        "@codai/shared-ui": "workspace:*",
        "@codai/sso-sdk-basic": "workspace:*",
        "express": "^4.21.2",
        "cors": "^2.8.5",
        "helmet": "^8.0.0",
        "express-rate-limit": "^7.4.1",
        "express-validator": "^7.2.0",
        "jsonwebtoken": "^9.0.2",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.7",
        "uuid": "^10.0.0",
        "winston": "^3.17.0",
        "compression": "^1.7.5",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/cors": "^2.8.17",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/bcryptjs": "^2.4.6",
        "@types/uuid": "^10.0.0",
        "@types/compression": "^1.7.5",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.8.6",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "tsc-alias": "^1.8.10",
        "vitest": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "supertest": "^7.0.0",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.17.0",
        "@typescript-eslint/eslint-plugin": "^8.18.1",
        "@typescript-eslint/parser": "^8.18.1"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "keywords": [
        "memorai",
        "api",
        "express",
        "typescript",
        "cbd",
        "vector-database",
        "memory-management",
        "jwt",
        "authentication"
    ],
    "author": "CODAI Ecosystem",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codai-ecosystem/codai-project.git",
        "directory": "apps/memorai-api"
    },
    "publishConfig": {
        "access": "restricted"
    },
    "bugs": {
        "url": "https://github.com/codai-ecosystem/codai-project/issues"
    },
    "homepage": "https://github.com/codai-ecosystem/codai-project#readme"
}