{
    "name": "@codai/sdk-js",
    "version": "1.0.0",
    "description": "Official JavaScript/TypeScript SDK for CODAI Ecosystem",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "codai",
        "sdk",
        "api",
        "client",
        "typescript",
        "javascript"
    ],
    "author": "CODAI Ecosystem Team",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.0.0",
        "vitest": "^1.0.0"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/codai-ecosystem/codai-project"
    },
    "homepage": "https://codai.dev",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    }
}