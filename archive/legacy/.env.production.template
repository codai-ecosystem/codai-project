# MemorAI Enterprise Production Environment Configuration
# Copy this file to .env.production and update with your values

# ===========================================
# AWS Infrastructure Configuration
# ===========================================
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
DOMAIN_NAME=codai.ro

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=${RDS_ENDPOINT}
DB_PORT=5432
DB_NAME=memorai_production
DB_USERNAME=memorai_admin
DB_PASSWORD=your-super-secure-database-password
DB_SSL=true
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=${REDIS_ENDPOINT}
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true
REDIS_URL=rediss://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ===========================================
# Security Configuration
# ===========================================
JWT_SECRET=your-256-bit-jwt-secret-key-here
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-256-bit-encryption-key
API_KEY_SECRET=your-api-key-signing-secret

# ===========================================
# CBD Enterprise Configuration
# ===========================================
CBD_HOST=0.0.0.0
CBD_PORT=4180
CBD_GRPC_PORT=4181
CBD_METRICS_PORT=9090
CBD_CLUSTER_SIZE=3
CBD_REPLICATION_FACTOR=2
CBD_MAX_CONNECTIONS=10000
CBD_QUERY_TIMEOUT=30000
CBD_VECTOR_DIMENSIONS=1536
CBD_INDEX_TYPE=HNSW
CBD_DISTANCE_METRIC=cosine

# ===========================================
# MemorAI Backend Configuration
# ===========================================
MEMORAI_BACKEND_HOST=0.0.0.0
MEMORAI_BACKEND_PORT=4007
MEMORAI_API_VERSION=v1
MEMORAI_MAX_MEMORY_SIZE=10GB
MEMORAI_BATCH_SIZE=1000
MEMORAI_QUERY_LIMIT=10000

# ===========================================
# MemorAI Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=https://api.memorai.codai.ro
NEXT_PUBLIC_MCP_URL=https://mcp.memorai.codai.ro
NEXT_PUBLIC_APP_NAME=MemorAI Enterprise
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@codai.ro

# ===========================================
# MemorAI MCP Configuration
# ===========================================
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_MAX_CONNECTIONS=100
MCP_TIMEOUT=30000
MCP_LOG_LEVEL=info

# ===========================================
# CODAI Ecosystem Integration
# ===========================================
CODAI_HUB_URL=https://hub.codai.ro
CODAI_ID_URL=https://id.codai.ro
CODAI_AUTH_URL=https://auth.codai.ro
CODAI_API_KEY=your-codai-ecosystem-api-key
CODAI_CLIENT_ID=your-codai-client-id
CODAI_CLIENT_SECRET=your-codai-client-secret

# ===========================================
# Monitoring and Observability
# ===========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://jaeger-collector:14268/api/traces
SENTRY_DSN=your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-api-key

# ===========================================
# Performance Configuration
# ===========================================
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=32
WORKERS_COUNT=4
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000

# ===========================================
# Security Headers and CORS
# ===========================================
CORS_ORIGIN=https://memorai.codai.ro,https://hub.codai.ro
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-API-Key
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ===========================================
# Backup and Data Retention
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
DATA_RETENTION_DAYS=365
ARCHIVE_ENABLED=true

# ===========================================
# Feature Flags
# ===========================================
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REAL_TIME_SYNC=true
FEATURE_MULTI_TENANT=true
FEATURE_API_RATE_LIMITING=true
FEATURE_AUDIT_LOGGING=true

# ===========================================
# Development and Testing (if needed)
# ===========================================
DEBUG=false
LOG_LEVEL=info
ENABLE_PROFILING=false
ENABLE_METRICS=true
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# SSL/TLS Configuration
# ===========================================
SSL_ENABLED=true
SSL_CERT_PATH=/app/certs/tls.crt
SSL_KEY_PATH=/app/certs/tls.key
SSL_CA_PATH=/app/certs/ca.crt
TLS_VERSION=TLSv1.3
