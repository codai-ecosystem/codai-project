# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TypeScript and JavaScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100

# JSON files
[*.json]
indent_size = 2
max_line_length = 120

# YAML files
[*.{yml,yaml}]
indent_size = 2
max_line_length = 80

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# Configuration files
[*.{toml,ini}]
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Python files (if any)
[*.py]
indent_size = 4
max_line_length = 88

# Dockerfile
[Dockerfile*]
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# Package files
[package.json]
indent_size = 2

# Lock files (don't format)
[*.lock]
insert_final_newline = false

# Generated files (don't format)
[*.min.*]
insert_final_newline = false
trim_trailing_whitespace = false

# Binary files (don't format)
[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot}]
insert_final_newline = false
trim_trailing_whitespace = false
