#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

# Run full test suite
echo "🧪 Running full test suite..."
pnpm test || exit 1

# Run E2E tests on critical paths
echo "🎭 Running critical E2E tests..."
pnpm test:e2e:critical || exit 1

# Security audit
echo "🔒 Running security audit..."
pnpm audit || (
  echo "⚠️ Security vulnerabilities found. Please review before pushing."
  exit 1
)

# Check for sensitive data
echo "🔍 Checking for sensitive data..."
pnpm check:secrets || (
  echo "❌ Potential sensitive data found. Please review before pushing."
  exit 1
)

# Build check
echo "🏗️ Verifying build..."
pnpm build || exit 1

# Performance benchmark
echo "⚡ Running performance benchmark..."
pnpm benchmark || (
  echo "⚠️ Performance regression detected. Please review."
)

echo "✅ All pre-push checks passed!"
