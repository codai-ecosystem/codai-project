{
  "name": "create-metu",
  "version": "1.0.0",
  "description": "A modern Next.js 15 monorepo template with Firebase integration",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwind",
    "firebase",
    "monorepo",
    "template",
    "pwa",
    "i18n"
  ],
  "homepage": "https://github.com/metu-org/metu-template#readme",
  "bugs": {
    "url": "https://github.com/metu-org/metu-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metu-org/metu-template.git"
  },
  "license": "MIT",
  "author": "METU Team",
  "bin": {
    "create-metu": "./bin/create-metu.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "a11y:check": "node tools/a11y-validator.js",
    "analyze": "turbo analyze",
    "analyze:bundle": "node scripts/advanced-bundle-analyzer.js",
    "analyze:diff": "node scripts/performance-monitor.js",
    "audit:all": "pnpm quality:full && pnpm security:audit && pnpm cicd:health",
    "benchmark": "node scripts/performance-monitor.js",
    "build": "turbo build",
    "changeset": "changeset",
    "check:secrets": "node scripts/check-secrets.js",
    "cicd:health": "node scripts/cicd-health-monitor.js",
    "clean": "turbo clean",
    "clean:all": "pnpm clean:deps && pnpm clean:cache && pnpm clean",
    "clean:cache": "turbo clean:cache && rm -rf .turbo",
    "clean:deps": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "predev": "node scripts/kill-port.js 6388 6389",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:backend\"",
    "dev:all": "node scripts/dev-unified.js --with-emulators",
    "dev:backend": "turbo run dev --filter @metu/backend",
    "dev:firebase": "cd apps/web && firebase emulators:start",
    "dev:reset": "pnpm clean:all && pnpm install && pnpm dev:setup",
    "dev:setup": "node setup.js",
    "dev:web": "turbo run dev --filter @metu/web",
    "firebase:setup": "node scripts/firebase-setup.js",
    "firebase:validate": "node scripts/validate-firebase-setup.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky install",
    "pwa:check": "node scripts/check-pwa-compatibility.js",
    "pwa:icons": "node scripts/generate-pwa-icons.js",
    "pwa:sync-manifests": "node scripts/sync-manifests.js",
    "pwa:validate": "node scripts/sync-manifests.js --validate-only",
    "quality:check": "node scripts/quality-check.js",
    "quality:full": "pnpm quality:check && pnpm ts:any-check && pnpm a11y:check && pnpm security:audit",
    "release": "pnpm release:check && turbo build && changeset publish",
    "release:check": "pnpm validate:all && pnpm test:e2e:critical && pnpm analyze:bundle",
    "security:audit": "node scripts/security-audit.js",
    "security:check": "pnpm audit --audit-level moderate",
    "setup": "node scripts/dev-setup.js",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:e2e:critical": "cd apps/web && pnpm test:e2e --grep='critical'",
    "test:integration": "node scripts/integration-test.js",
    "test:staged": "turbo test --filter=...{origin/main}",
    "test:ui": "turbo test:ui",
    "test:unit": "turbo test:unit",
    "ts:any-check": "node tools/enhanced-any-detector.js",
    "type-check": "turbo type-check",
    "validate": "node scripts/validate.js",
    "validate:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test:unit",
    "verify:integration": "node scripts/verify-integration.js",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "critters": "^0.0.25"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@metu/eslint-config": "workspace:*",
    "@metu/typescript-config": "workspace:*",
    "@playwright/test": "^1.43.1",
    "chalk": "^5.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "glob": "^11.0.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.4.12",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "turbo": "^2.5.4",
    "typescript": "^5.4.2"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
