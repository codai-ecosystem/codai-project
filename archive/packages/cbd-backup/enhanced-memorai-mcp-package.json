{
    "name": "@codai/memorai-mcp-enhanced",
    "version": "8.0.0",
    "description": "Revolutionary Enhanced MemoraiMCP with CBD (Codai Better Database) - HPKV-inspired AI memory system with semantic search",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "memorai-mcp-enhanced": "./dist/enhanced-server.js",
        "memorai-mcp-cbd": "./dist/enhanced-server.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./enhanced": {
            "types": "./dist/enhanced-server.d.ts",
            "import": "./dist/enhanced-server.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "mcp.config.json"
    ],
    "scripts": {
        "build": "pnpm exec tsc",
        "dev": "tsc --watch",
        "start": "node dist/enhanced-server.js",
        "test": "node test/test-enhanced.js",
        "lint": "pnpm exec eslint src --ext .ts",
        "typecheck": "pnpm exec tsc --noEmit",
        "prepare": "pnpm run build"
    },
    "keywords": [
        "mcp",
        "memory",
        "ai",
        "semantic-search",
        "vector-database",
        "cbd",
        "hpkv",
        "embeddings",
        "conversation",
        "context"
    ],
    "author": "CODAI Ecosystem",
    "license": "MIT",
    "homepage": "https://github.com/codai-ecosystem/codai-project",
    "repository": {
        "type": "git",
        "url": "https://github.com/codai-ecosystem/codai-project.git",
        "directory": "apps/memorai/packages/mcp-enhanced"
    },
    "dependencies": {
        "@codai/cbd": "workspace:*",
        "@modelcontextprotocol/sdk": "^0.6.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^24.0.13",
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "@typescript-eslint/parser": "^8.36.0",
        "eslint": "^9.31.0",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "openai": "^4.0.0"
    }
}