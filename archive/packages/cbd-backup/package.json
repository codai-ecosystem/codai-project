{
  "name": "@codai/cbd",
  "version": "1.0.2",
  "description": "Codai Better Database - High-Performance Vector Memory System with HPKV-inspired architecture and MCP server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cbd-mcp": "./dist/mcp/cli.js",
    "cbd-service": "./bin/cbd-service.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "import": "./dist/vector/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:rust && pnpm exec tsc",
    "build:rust": "cd rust && cargo build --release",
    "build:rust:bindings": "cd rust && cargo build --release --features bindings",
    "build:ts": "pnpm exec tsc",
    "dev": "tsc --watch",
    "service": "node bin/cbd-service.js",
    "service:dev": "nodemon bin/cbd-service.js",
    "lint": "pnpm exec eslint src --ext .ts",
    "test:rust": "cd rust && cargo test",
    "typecheck": "pnpm exec tsc --noEmit",
    "bench:rust": "cd rust && cargo bench",
    "clean": "rm -rf dist && cd rust && cargo clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "database",
    "vector",
    "memory",
    "semantic-search",
    "embeddings",
    "hpkv",
    "ai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "codai"
  ],
  "author": "CODAI Ecosystem",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "faiss-node": "^0.5.0",
    "helmet": "^8.0.0",
    "openai": "^4.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
