# METU Template - Backend Environment Configuration
# ------------------------------------------------
# Copy this file to .env and update the values with your own settings
# For testing, also copy to .env.test with test Firebase project credentials

# Server Configuration
# -------------------
NODE_ENV=development
PORT=8000
HOST=localhost
LOG_LEVEL=info

# Firebase Configuration
# ---------------------
# Required: Your Firebase project ID from the Firebase console
FIREBASE_PROJECT_ID=metu-template

# Required for web app integration: API key from Firebase console
FIREBASE_API_KEY=AIzaSyAjHY7ljjphYfWq-AlyD4-rxTc5_qNkhb8

# Authentication Options (Choose ONE of these methods):
# ---------------------------------------------------
# Option 1: Path to service account key file (recommended for production)
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# Option 2: Service account credentials as environment variables (recommended for deployment)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_COMPLETE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS Configuration
# -----------------
# Comma-separated list of allowed origins for CORS headers
ALLOWED_ORIGINS=http://localhost:3000

# Testing Configuration
# --------------------
# For testing, create a separate .env.test file with:
# - A separate Firebase test project ID
# - Test project service account credentials
# - Different port (e.g., 8001) to avoid conflicts
# - LOG_LEVEL=error to reduce test output noise
# 
# Example .env.test:
# NODE_ENV=test
# FIREBASE_PROJECT_ID=your-test-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-test-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# PORT=8001
# LOG_LEVEL=error
# ALLOWED_ORIGINS=http://localhost:3000

# Stripe Configuration
# -------------------
# Secret key for backend Stripe operations (starts with sk_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook endpoint secret for verifying Stripe webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Optional: For Stripe Connect features
STRIPE_CONNECT_CLIENT_SECRET=sk_test_your_stripe_connect_secret_here
