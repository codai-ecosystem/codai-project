# METU Template - Backend Test Environment Configuration
# ------------------------------------------------------
# Copy this file to .env.test and update with your TEST Firebase project credentials
# IMPORTANT: Use a separate Firebase project for testing to avoid affecting production data

# Test Environment Settings
# -------------------------
NODE_ENV=test
PORT=8001
HOST=localhost
LOG_LEVEL=error

# Firebase Test Project Configuration
# -----------------------------------
# CRITICAL: Use a dedicated Firebase project for testing
# This should NOT be the same as your development or production project
FIREBASE_PROJECT_ID=metu-template-test

# Firebase API Key for test project
FIREBASE_API_KEY=your-test-firebase-api-key

# Test Project Service Account Credentials
# ----------------------------------------
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate new private key and use the credentials here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-test-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_COMPLETE_TEST_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Test CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Test Setup Instructions:
# -----------------------
# 1. Create a new Firebase project for testing (e.g., "my-app-test")
# 2. Enable Authentication and Firestore in the test project
# 3. Go to Project Settings > Service Accounts
# 4. Click "Generate new private key" 
# 5. Copy the values from the downloaded JSON to this file:
#    - project_id → FIREBASE_PROJECT_ID
#    - client_email → FIREBASE_CLIENT_EMAIL  
#    - private_key → FIREBASE_PRIVATE_KEY (keep the \n characters)
# 6. Get the API key from Project Settings > General > Web API Key
#
# Real Data Testing Benefits:
# - Tests actual Firebase Authentication and Firestore integration
# - Catches real-world API issues that mocks would miss
# - Validates Firebase security rules and permissions
# - Ensures error handling works with actual service responses
# - Tests network timeouts and connectivity issues
#
# Test Isolation:
# - Each test run uses unique user identifiers
# - Automatic cleanup removes test data after each test
# - Tests can run in parallel without interference
# - Fallback behavior allows tests to run (with warnings) if credentials are invalid

# Optional: Use service account file instead of environment variables
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/your-test-service-account.json
