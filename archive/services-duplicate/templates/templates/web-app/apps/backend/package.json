{
  "name": "@metu/backend",
  "version": "1.0.0",
  "private": true,
  "description": "METU Template Backend API with Fastify and Firebase Admin",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "predev": "node ../../scripts/kill-port.js 6389",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prestart": "node ../../scripts/kill-port.js 6389",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "fastify-plugin": "^5.0.1",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.2",
    "stripe": "^18.2.1",
    "stripe-firebase": "^0.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@metu/eslint-config": "workspace:*",
    "@metu/typescript-config": "workspace:*",
    "@types/aws-lambda": "^8.10.149",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^1.6.1",
    "aws-lambda-fastify": "^2.2.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
