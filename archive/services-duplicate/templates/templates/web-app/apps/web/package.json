{
  "name": "@metu/web",
  "version": "1.0.0",
  "private": true,
  "description": "METU Template - Modern Next.js 15 web application",
  "scripts": {
    "predev": "node ../../scripts/kill-port.js 6388",
    "dev": "next dev --turbopack --port 4054",
    "build": "next build",
    "prestart": "node ../../scripts/kill-port.js 6388",
    "start": "next start --port 4065",
    "lint": "next lint --fix",
    "type-check": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore,database,hosting,storage --import=./firebase/seed --export-on-exit=./firebase/seed",
    "emulators:stop": "node ./scripts/stop-emulators.js",
    "emulators:restart": "pnpm emulators:stop && pnpm emulators",
    "emulators:clean": "pnpm emulators:stop && pnpm emulators",
    "test": "jest --bail --maxWorkers=2",
    "test:unit": "jest --bail --maxWorkers=2",
    "test:watch": "jest --watch --bail",
    "test:coverage": "jest --coverage --bail --maxWorkers=2",
    "test:fast": "jest --bail --maxWorkers=1 --passWithNoTests --forceExit",
    "test:e2e": "playwright test --max-failures=3",
    "test:e2e:fast": "playwright test --max-failures=1 --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test auth.spec.ts",
    "test:e2e:auth:nav": "playwright test auth-navigation.spec.ts --project=chromium",
    "test:e2e:homepage": "playwright test homepage.spec.ts",
    "test:e2e:dashboard": "playwright test dashboard.spec.ts",
    "test:e2e:dashboard:auth": "playwright test dashboard-auth.spec.ts --project=chromium",
    "test:e2e:theme": "playwright test theme.spec.ts",
    "test:e2e:theme:persistence": "playwright test theme-persistence.spec.ts --project=chromium",
    "test:e2e:i18n": "playwright test i18n.spec.ts",
    "test:e2e:components": "playwright test components.spec.ts",
    "test:e2e:responsive": "playwright test responsive.spec.ts",
    "test:e2e:performance": "playwright test performance.spec.ts",
    "test:e2e:accessibility": "playwright test accessibility.spec.ts",
    "test:e2e:pwa": "playwright test pwa.spec.ts",
    "test:e2e:quick": "playwright test homepage.spec.ts auth-navigation.spec.ts --max-failures=5",
    "test:e2e:smoke": "playwright test smoke.spec.ts --project=chromium",
    "clean": "rm -rf .next .turbo coverage test-results",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "analyze": "cross-env ANALYZE=true next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@next/bundle-analyzer": "^15.3.2",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-email/components": "^0.0.41",
    "@react-email/render": "^1.1.2",
    "@stripe/stripe-js": "^7.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.9.0",
    "framer-motion": "^11.18.2",
    "i18next": "^23.11.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.379.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^4.0.15",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.51.2",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^14.1.0",
    "react-window": "^1.8.8",
    "resend": "^3.2.0",
    "stripe": "^18.2.1",
    "stripe-firebase": "^0.3.2",
    "tailwind-merge": "^2.3.0",
    "web-vitals": "^5.0.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3",
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@metu/eslint-config": "workspace:*",
    "@metu/typescript-config": "workspace:*",
    "@next/env": "^15.3.2",
    "@playwright/test": "^1.43.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-onboarding": "8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/nextjs": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/test": "8.6.14",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.3.2",
    "eslint-plugin-storybook": "^0.12.0",
    "firebase-tools": "^13.10.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30.0.0-beta.3",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "storybook": "8.6.14",
    "tailwindcss": "3.4.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
