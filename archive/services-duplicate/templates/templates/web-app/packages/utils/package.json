{
  "name": "@metu/utils",
  "version": "1.0.0",
  "private": true,
  "description": "METU shared utilities and helper functions",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "pnpm exec eslint src --ext .ts",
    "lint:fix": "pnpm exec eslint src --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@metu/eslint-config": "workspace:*",
    "@metu/typescript-config": "workspace:*",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
