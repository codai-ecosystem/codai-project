# Azure AI Services Configuration - Generated 2025-07-25
# CODAI Ecosystem AI Services - codai-dev deployment

# Azure AI Foundry (Primary recommended service)
AZURE_AI_FOUNDRY_ENDPOINT="https://your-region.api.cognitive.microsoft.com/"
AZURE_AI_FOUNDRY_KEY="your-azure-ai-key-here"

# Azure OpenAI (Specialized OpenAI-only service)  
AZURE_OPENAI_ENDPOINT="https://your-region.api.cognitive.microsoft.com/"
AZURE_OPENAI_KEY="your-azure-ai-key-here"
AZURE_OPENAI_API_VERSION="2024-10-01-preview"

# Azure AI Search (RAG capabilities)
AZURE_SEARCH_ENDPOINT="https://your-search-service-name.search.windows.net"
AZURE_SEARCH_KEY="your-azure-search-admin-key-here"

# Resource Information
AZURE_RESOURCE_GROUP="your-resource-group"
AZURE_LOCATION="your-region"
AZURE_SUBSCRIPTION_ID="your-subscription-id-here"

# Service Names
AZURE_AI_FOUNDRY_NAME="codai-dev-ai-foundry"
AZURE_AI_HUB_NAME="codai-dev-ai-hub"
AZURE_OPENAI_NAME="codai-dev-openai"
AZURE_SEARCH_NAME="your-search-service-name"

# Deployed Models
AZURE_OPENAI_MODELS="gpt-4o,gpt-4o-mini,whisper,gpt-35-turbo,text-embedding-3-large,text-embedding-ada-002,gpt-4o-realtime"

# Model-specific endpoints for METU integration
AZURE_OPENAI_GPT4O_DEPLOYMENT="gpt-4o-realtime"
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_WHISPER_DEPLOYMENT="whisper"
AZURE_OPENAI_GPT35_DEPLOYMENT="gpt-35-turbo"

# Embedding models for semantic search and MemorAI
AZURE_OPENAI_EMBEDDING_LARGE_DEPLOYMENT="text-embedding-3-large"
AZURE_OPENAI_EMBEDDING_ADA_DEPLOYMENT="text-embedding-ada-002"
