{
  "unified": {
    "outputDir": "coverage",
    "formats": [
      "text",
      "html",
      "lcov",
      "json"
    ],
    "thresholds": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      },
      "perFile": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "exclude": [
      "coverage/**",
      "dist/**",
      "build/**",
      "**/*.d.ts",
      "**/*.test.*",
      "**/*.spec.*",
      "**/node_modules/**"
    ]
  },
  "byFramework": {
    "vitest": {
      "enabled": true,
      "outputDir": "coverage/vitest"
    },
    "jest": {
      "enabled": true,
      "outputDir": "coverage/jest"
    },
    "playwright": {
      "enabled": false,
      "outputDir": "coverage/playwright"
    }
  }
}