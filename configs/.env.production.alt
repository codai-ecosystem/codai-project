# 🚀 CODAI Ecosystem - Production Environment Configuration
# Generated: 2025-08-03 23:29 UTC
# Phase 8: Production Deployment Configuration

# Environment Settings
NODE_ENV=production
PORT=4000
DEBUG=false

# Core Services Configuration
CBD_URL=https://api.codai.app
GATEWAY_URL=https://gateway.codai.app
WS_URL=wss://ws.codai.app

# Database Configuration
DATABASE_URL=postgresql://codai_user:${DB_PASSWORD}@prod-db.codai.app:5432/codai_production
REDIS_URL=redis://prod-redis.codai.app:6379
MONGODB_URL=mongodb://prod-mongo.codai.app:27017/codai_production

# Security Configuration
JWT_SECRET=${JWT_SECRET_PRODUCTION}
ENCRYPTION_KEY=${ENCRYPTION_KEY_PRODUCTION}
API_KEY=${API_KEY_PRODUCTION}

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/codai.app.crt
SSL_KEY_PATH=/etc/ssl/private/codai.app.key
FORCE_HTTPS=true

# CORS Configuration
CORS_ORIGIN=https://codai.app,https://*.codai.app
ALLOWED_HOSTS=codai.app,*.codai.app

# Monitoring & Analytics
MONITORING_ENABLED=true
ANALYTICS_ENDPOINT=https://analytics.codai.app
LOG_LEVEL=warn
METRICS_PORT=9090

# External Services
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY_PRODUCTION}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=us-east-1

# Performance Configuration
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=1000
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=100

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_AI_FEATURES=true
ENABLE_PREMIUM_FEATURES=true

# Production Optimization
MINIFY_OUTPUT=true
COMPRESS_RESPONSES=true
ENABLE_CDN=true
CDN_URL=https://cdn.codai.app

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=codai-production-backups

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3
