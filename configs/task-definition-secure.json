{
  "family": "memorai-api-prod",
  "taskRoleArn": "arn:aws:iam::567877624442:role/memorai-ecs-task-prod",
  "executionRoleArn": "arn:aws:iam::567877624442:role/memorai-ecs-task-execution-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "memorai-api",
      "image": "567877624442.dkr.ecr.eu-central-1.amazonaws.com/memorai-api:secure-v2",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 4006,
          "hostPort": 4006,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "MEMORAI_MCP_URL",
          "value": "http://memorai-mcp:4950"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "CBD_BASE_URL",
          "value": "http://cbd-database:4180"
        },
        {
          "name": "PORT",
          "value": "4006"
        },
        {
          "name": "SECURITY_ENABLED",
          "value": "true"
        },
        {
          "name": "API_RATE_LIMIT_ENABLED",
          "value": "true"
        },
        {
          "name": "SQL_INJECTION_PROTECTION",
          "value": "true"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/memorai-api-prod",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:4006/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ]
}
