{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@codai/shared": ["../shared/src"],
      "@codai/ui": ["../ui/src"],
      "@codai/config": ["../config/src"]
    },
    "types": ["node"],
    "typeRoots": ["../../types", "../../node_modules/@types", "./node_modules/@types"]
  },
  "include": [
    "../../types/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist", "build", "coverage", "test-results"],
  "references": []
}
