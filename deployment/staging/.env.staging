# CODAI Staging Environment Configuration

# API Gateway Configuration
API_GATEWAY_URL=https://staging-api.codai.ro
API_GATEWAY_PORT=4000
WS_GATEWAY_URL=wss://staging-api.codai.ro/ws

# Authentication Service
ID_SERVICE_URL=http://id-service:4001
ID_SERVICE_PORT=4001
JWT_SECRET=staging-jwt-secret-key-256-bit
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=3d

# Database Configuration
DATABASE_URL=postgresql://codai:staging-password@postgresql-staging:5432/codai_staging
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50
DATABASE_SSL=false

# Redis Configuration  
REDIS_URL=redis://redis-staging:6379
REDIS_CLUSTER_MODE=false
REDIS_PASSWORD=staging-redis-password
REDIS_TTL=1800

# MEMORAI Service
MEMORAI_SERVICE_URL=http://memorai-service:4002
MEMORAI_SERVICE_PORT=4002
MEMORAI_MAX_FILE_SIZE=50MB
MEMORAI_STORAGE_PATH=/data/memorai

# Core Services Configuration
HUB_SERVICE_URL=http://hub-service:4020
HUB_SERVICE_PORT=4020

LOGAI_SERVICE_URL=http://logai-service:4021  
LOGAI_SERVICE_PORT=4021
LOGAI_LOG_LEVEL=debug
LOGAI_MAX_LOG_SIZE=5MB

# Business Services
CODAI_SERVICE_URL=http://codai-service:4003
CODAI_SERVICE_PORT=4003

BANCAI_SERVICE_URL=http://bancai-service:4005
BANCAI_SERVICE_PORT=4005

CUMPARAI_SERVICE_URL=http://cumparai-service:4007
CUMPARAI_SERVICE_PORT=4007

STUDIAI_SERVICE_URL=http://studiai-service:4009
STUDIAI_SERVICE_PORT=4009

FABRICAI_SERVICE_URL=http://fabricai-service:4011
FABRICAI_SERVICE_PORT=4011

MUZICAI_SERVICE_URL=http://muzicai-service:4013
MUZICAI_SERVICE_PORT=4013

TALENTAI_SERVICE_URL=http://talentai-service:4015
TALENTAI_SERVICE_PORT=4015

SOCIAI_SERVICE_URL=http://sociai-service:4017
SOCIAI_SERVICE_PORT=4017

STOCAI_SERVICE_URL=http://stocai-service:4019
STOCAI_SERVICE_PORT=4019

# External Integrations
OPENAI_API_KEY=sk-staging-openai-api-key
OPENAI_ORG_ID=org-openai-organization-id
CLAUDE_API_KEY=claude-staging-api-key
GEMINI_API_KEY=gemini-staging-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=staging@codai.ro
SMTP_PASS=staging-smtp-password
SMTP_FROM=CODAI Staging <staging@codai.ro>

# File Storage
AWS_ACCESS_KEY_ID=AKIA-staging-access-key
AWS_SECRET_ACCESS_KEY=staging-aws-secret-key
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=codai-staging-storage

# Security
CORS_ORIGINS=https://staging.codai.ro,https://staging-app.codai.ro,https://staging-admin.codai.ro
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=500
SESSION_SECRET=staging-session-secret-key-256-bit

# Monitoring
PROMETHEUS_ENDPOINT=http://prometheus:9090
GRAFANA_URL=https://staging-grafana.codai.ro
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/project-id

# Application Settings
NODE_ENV=staging
LOG_LEVEL=debug
ENABLE_SWAGGER=true
ENABLE_PROFILING=false
MAX_REQUEST_SIZE=5MB
REQUEST_TIMEOUT=15000

# Performance
CACHE_TTL=60
MAX_CONNECTIONS=200
WORKER_PROCESSES=2
CLUSTER_MODE=false

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_REAL_TIME=true
ENABLE_FILE_UPLOAD=true
ENABLE_NOTIFICATIONS=true
ENABLE_SEARCH=true

# Health Check
HEALTH_CHECK_INTERVAL=15000
HEALTH_CHECK_TIMEOUT=3000
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_SCHEDULE=0 4 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=codai-staging-backups
