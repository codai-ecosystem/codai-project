# RomAI AGI Model Server - Production Docker Image
# Includes logical reasoning breakthrough fixes
# Version: v2.0-logical-reasoning-fix

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY apps/romai/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY apps/romai/src/ ./src/

# Set environment variables
ENV PYTHONPATH=/app/src
ENV PORT=6101
ENV ROMAI_AGI_HOST=0.0.0.0
ENV ROMAI_LOG_LEVEL=INFO
ENV NODE_ENV=production

# Expose port
EXPOSE 6101

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:6101/health || exit 1

# Start the server
CMD ["python", "src/ml/serving/model_server.py", "--port", "6101", "--host", "0.0.0.0"]