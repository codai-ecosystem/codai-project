{
  "name": "@codai/advanced-analytics",
  "version": "1.0.0",
  "description": "Comprehensive analytics and monitoring system for user behavior tracking, performance metrics, business intelligence, and predictive analytics in the CODAI ecosystem",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./analytics": {
      "import": "./dist/analytics/index.esm.js",
      "require": "./dist/analytics/index.js",
      "types": "./dist/analytics/index.d.ts"
    },
    "./monitoring": {
      "import": "./dist/monitoring/index.esm.js",
      "require": "./dist/monitoring/index.js",
      "types": "./dist/monitoring/index.d.ts"
    },
    "./reporting": {
      "import": "./dist/reporting/index.esm.js",
      "require": "./dist/reporting/index.js",
      "types": "./dist/reporting/index.d.ts"
    },
    "./predictive": {
      "import": "./dist/predictive/index.esm.js",
      "require": "./dist/predictive/index.js",
      "types": "./dist/predictive/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.esm.js",
      "require": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "analytics",
    "monitoring",
    "business-intelligence",
    "predictive-analytics",
    "ab-testing",
    "performance-metrics",
    "user-behavior",
    "data-visualization",
    "real-time-analytics",
    "codai",
    "typescript",
    "enterprise"
  ],
  "author": "CODAI Team <team@codai.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "libs/advanced-analytics"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://codai.dev/docs/advanced-analytics",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@codai/ai-chatbot": "workspace:*",
    "@codai/advanced-security": "workspace:*",
    "@codai/service-stability": "workspace:*",
    "@codai/project-orchestration": "workspace:*",
    "@codai/mobile-optimization": "workspace:*",
    "codai-performance-monitor": "workspace:*",
    "@codai/performance-monitoring": "workspace:*",
    "@codai/security": "workspace:*",
    "d3": "^7.8.5",
    "chart.js": "^4.4.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "react-chartjs-2": "^5.2.0",
    "plotly.js": "^2.26.0",
    "react-plotly.js": "^2.6.0",
    "recharts": "^2.8.0",
    "victory": "^37.0.2",
    "@tensorflow/tfjs": "^4.10.0",
    "@tensorflow/tfjs-node": "^4.10.0",
    "ml-regression": "^6.0.1",
    "simple-statistics": "^7.8.3",
    "lodash": "^4.17.21",
    "ramda": "^0.29.0",
    "axios": "^1.5.0",
    "ky": "^0.33.3",
    "ws": "^8.14.2",
    "socket.io-client": "^4.7.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "mongodb": "^6.0.0",
    "@influxdata/influxdb-client": "^1.33.2",
    "elasticsearch": "^16.7.3",
    "prom-client": "^15.1.3",
    "pino": "^8.15.0",
    "winston": "^3.10.0",
    "uuid": "^9.0.0",
    "nanoid": "^4.0.2",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.9",
    "moment": "^2.29.4",
    "zod": "^3.22.2",
    "joi": "^17.9.2",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "eventemitter3": "^5.0.1",
    "mitt": "^3.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fastify": "^4.21.0",
    "@hapi/hapi": "^21.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.17",
    "@types/ws": "^8.5.5",
    "@types/lodash": "^4.14.196",
    "@types/ramda": "^0.29.3",
    "@types/pg": "^8.10.2",
    "@types/uuid": "^9.0.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/d3": "^7.4.0",
    "typescript": "^5.1.6",
    "tsx": "^3.12.7",
    "rollup": "^3.27.0",
    "@rollup/plugin-typescript": "^11.1.2",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-json": "^6.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "vitest": "^0.34.0",
    "@vitest/coverage-c8": "^0.33.0",
    "playwright": "^1.36.0",
    "@playwright/test": "^1.36.0",
    "eslint": "^8.46.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "size-limit": "^8.2.6",
    "bundlesize": "^0.18.1",
    "typedoc": "^0.24.8",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1",
    "cross-env": "^7.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "150 kB"
    },
    {
      "path": "dist/index.esm.js",
      "limit": "140 kB"
    }
  ],
  "bundlesize": [
    {
      "path": "./dist/index.js",
      "maxSize": "150 kB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run validate"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/codai-ecosystem"
  },
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:watch": "rollup -c rollup.config.js --watch",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write src/**/*.{ts,tsx,json,md}",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "size": "size-limit",
    "analyze": "npm run build && bundlesize",
    "docs": "typedoc src/index.ts",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "demo": "tsx examples/demo.ts",
    "benchmark": "tsx benchmarks/performance.ts",
    "train": "tsx scripts/train-models.ts",
    "predict": "tsx scripts/run-predictions.ts",
    "export-models": "tsx scripts/export-models.ts",
    "validate-data": "tsx scripts/validate-datasets.ts"
  }
}