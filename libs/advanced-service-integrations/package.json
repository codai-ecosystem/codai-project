{
    "name": "@codai/advanced-service-integrations",
    "version": "1.0.0",
    "description": "Advanced service integration framework for CODAI ecosystem with API orchestration, real-time communication, and microservice coordination",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "lint": "eslint src --ext .ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist coverage",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "keywords": [
        "codai",
        "service-integration",
        "api-orchestration",
        "microservices",
        "real-time",
        "websockets",
        "event-driven",
        "enterprise",
        "scalability",
        "performance",
        "monitoring",
        "typescript"
    ],
    "author": "CODAI Team <team@codai.dev>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/codai-project/codai.git",
        "directory": "libs/advanced-service-integrations"
    },
    "bugs": {
        "url": "https://github.com/codai-project/codai/issues"
    },
    "homepage": "https://codai.dev/docs/advanced-service-integrations",
