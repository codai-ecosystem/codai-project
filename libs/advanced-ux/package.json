{
  "name": "@codai/advanced-ux",
  "version": "1.0.0",
  "description": "Advanced User Experience & Interaction Design System for CODAI Ecosystem",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./patterns": {
      "import": "./dist/patterns/index.es.js",
      "require": "./dist/patterns/index.js",
      "types": "./dist/patterns/index.d.ts"
    },
    "./interactions": {
      "import": "./dist/interactions/index.es.js",
      "require": "./dist/interactions/index.js",
      "types": "./dist/interactions/index.d.ts"
    },
    "./flows": {
      "import": "./dist/flows/index.es.js",
      "require": "./dist/flows/index.js",
      "types": "./dist/flows/index.d.ts"
    },
    "./accessibility": {
      "import": "./dist/accessibility/index.es.js",
      "require": "./dist/accessibility/index.js",
      "types": "./dist/accessibility/index.d.ts"
    },
    "./analytics": {
      "import": "./dist/analytics/index.es.js",
      "require": "./dist/analytics/index.js",
      "types": "./dist/analytics/index.d.ts"
    },
    "./styles": "./dist/styles/globals.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "vite-bundle-analyzer dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@codai/frontend-architecture": "workspace:*",
    "@codai/ui-components": "workspace:*",
    "framer-motion": "^10.16.4",
    "react-spring": "^9.7.3",
    "lottie-react": "^2.4.0",
    "use-gesture": "^10.2.27",
    "react-intersection-observer": "^9.5.2",
    "react-hotkeys-hook": "^4.4.1",
    "focus-trap": "^7.5.4",
    "react-focus-lock": "^2.9.6",
    "react-aria-live": "^3.0.1",
    "react-remove-scroll": "^2.5.7",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "@floating-ui/react": "^0.26.2",
    "cmdk": "^0.2.0",
    "react-hook-form": "^7.48.2",
    "@hookform/resolvers": "^3.3.2",
    "zod": "^3.22.4",
    "react-select": "^5.8.0",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.8",
    "react-window-infinite-loader": "^1.0.9",
    "react-beautiful-dnd": "^13.1.1",
    "react-sortable-hoc": "^2.0.0",
    "react-dropzone": "^14.2.3",
    "react-cropper": "^2.3.3",
    "react-color": "^2.19.3",
    "react-datepicker": "^4.21.0",
    "react-slider": "^2.0.6",
    "react-use": "^17.4.0",
    "ahooks": "^3.7.8",
    "use-debounce": "^9.0.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-beautiful-dnd": "^13.1.6",
    "@types/react-color": "^3.0.9",
    "@types/react-datepicker": "^4.19.4",
    "@types/react-slider": "^1.3.6",
    "@types/react-window": "^1.8.8",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^0.34.6",
    "@vitejs/plugin-react": "^4.1.1",
    "vite-plugin-dts": "^3.6.3",
    "vite-bundle-analyzer": "^0.7.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/user-event": "^14.5.1",
    "jsdom": "^22.1.0",
    "eslint": "^8.53.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "@storybook/react": "^7.5.3",
    "@storybook/react-vite": "^7.5.3",
    "@storybook/addon-essentials": "^7.5.3",
    "@storybook/addon-interactions": "^7.5.3",
    "@storybook/addon-links": "^7.5.3",
    "@storybook/addon-docs": "^7.5.3",
    "@storybook/addon-a11y": "^7.5.3",
    "tailwindcss": "^3.3.5",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "typescript",
    "ux",
    "ui",
    "interaction-design",
    "user-experience",
    "accessibility",
    "animations",
    "micro-interactions",
    "design-system",
    "user-flows",
    "behavioral-analytics",
    "personalization",
    "adaptive-interfaces",
    "gesture-recognition",
    "voice-ui",
    "inclusive-design",
    "performance-optimization",
    "usability-testing",
    "codai-ecosystem"
  ],
  "author": "CODAI Ecosystem Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project",
