{
  "name": "@codai/ai-chatbot",
  "version": "1.0.0",
  "description": "Intelligent AI chatbot core with advanced conversation management and context awareness",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "demo": "tsx examples/basic-demo.ts",
    "docs": "typedoc src/index.ts"
  },
  "keywords": [
    "ai",
    "chatbot",
    "conversation",
    "nlp",
    "machine-learning",
    "context-aware",
    "intelligent-assistant",
    "codai"
  ],
  "author": "CODAI AI Team",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.68.0",
    "langchain": "^0.3.5",
    "@langchain/openai": "^0.3.12",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "winston": "^3.11.0",
    "joi": "^17.13.3",
    "tiktoken": "^1.0.17",
    "compromise": "^14.14.0",
    "sentiment": "^5.0.2",
    "natural": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.2",
    "tsx": "^4.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "typedoc": "^0.25.4"
  },
  "peerDependencies": {
    "@codai/advanced-security": "workspace:*"
  },
  "files": [
    "dist/**/*",
    "examples/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "libs/ai-chatbot"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://github.com/codai-ecosystem/codai-project/tree/main/libs/ai-chatbot#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ]
  }
}