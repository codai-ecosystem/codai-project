{
  "name": "@codai/azure-openai",
  "version": "1.0.0",
  "description": "Centralized Azure OpenAI service for Codai ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "cd ../../ && npx tsc --project libs/azure-openai",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "type-check": "cd ../../ && npx tsc --noEmit --project libs/azure-openai",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "keywords": [
    "azure",
    "openai",
    "ai",
    "codai",
    "typescript"
  ],
  "author": "Codai Ecosystem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project"
  },
  "files": [
    "dist",
    "README.md"
  ]
}