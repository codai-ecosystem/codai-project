{
  "name": "@codai/code-analysis",
  "version": "1.0.0",
  "description": "Advanced AI-powered code analysis engine for the CODAI ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "demo": "node dist/demo/index.js"
  },
  "keywords": [
    "code-analysis",
    "ai-powered",
    "static-analysis",
    "vulnerability-scanning",
    "performance-optimization",
    "architecture-patterns",
    "codai",
    "typescript",
    "ast-parsing"
  ],
  "author": "CODAI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "libs/code-analysis"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "typescript": "^5.6.0",
    "openai": "^4.52.0",
    "anthropic": "^0.24.0",
    "eslint": "^9.0.0",
    "acorn": "^8.12.0",
    "acorn-typescript": "^1.4.0",
    "recast": "^0.23.0",
    "ast-types": "^0.16.0",
    "semver": "^7.6.0",
    "lodash": "^4.17.21",
    "glob": "^10.4.0",
    "fast-glob": "^3.3.0",
    "chokidar": "^3.6.0",
    "yaml": "^2.4.0",
    "jsdom": "^24.0.0",
    "cheerio": "^1.0.0-rc.12",
    "marked": "^13.0.0",
    "highlight.js": "^11.9.0",
    "prismjs": "^1.29.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.3.0",
    "commander": "^12.0.0",
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^5.0.0",
    "ioredis": "^5.4.0",
    "ws": "^8.18.0",
    "socket.io": "^4.7.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^10.0.0",
    "axios": "^1.7.0",
    "node-fetch": "^3.3.0",
    "form-data": "^4.0.0",
    "sharp": "^0.33.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/ws": "^8.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/uuid": "^10.0.0",
    "@types/lodash": "^4.17.0",
    "@types/babel__core": "^7.20.0",
    "@types/babel__parser": "^7.1.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/babel__types": "^7.20.0",
    "@types/semver": "^7.5.0",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/jsdom": "^21.1.0",
    "@types/marked": "^6.0.0",
    "@types/prismjs": "^1.26.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.1.0",
    "rimraf": "^6.0.0",
    "prettier": "^3.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.0"
  },
  "peerDependencies": {
    "@codai/advanced-security": "^1.0.0",
    "@codai/ai-chatbot": "^1.0.0",
    "@codai/service-stability": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.codai.dev/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/**/*.spec.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "warn"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "pnpm test"
    }
  }
}