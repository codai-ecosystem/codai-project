{
  "name": "@codai/metu-stabilization",
  "version": "1.0.0",
  "description": "Phase 2.2 METU Application Stabilization - Web & Desktop App Optimization", "description": "Phase 2.2 METU Application Stabilization - Web & Desktop App Optimization", "name": "@codai/metu-stabilization",
  "version": "1.0.0",
  "description": "Phase    "web-vitals": "^5.0.3",2.2 METU Application Stabilization - Web & Desktop App Optimization",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./web": {
      "import": "./dist/web/index.esm.js",
      "require": "./dist/web/index.js",
      "types": "./dist/web/index.d.ts"
    },
    "./desktop": {
      "import": "./dist/desktop/index.esm.js",
      "require": "./dist/desktop/index.js",
      "types": "./dist/desktop/index.d.ts"
    },
    "./performance": {
      "import": "./dist/performance/index.esm.js",
      "require": "./dist/performance/index.js",
      "types": "./dist/performance/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.esm.js",
      "require": "./dist/ui/index.js",
      "types": "./dist/ui/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix"
  },
  "keywords": [
    "metu",
    "stabilization",
    "performance",
    "electron",
    "next.js",
    "react",
    "ui-optimization",
    "cross-platform",
    "real-time",
    "voice-ai"
  ],
