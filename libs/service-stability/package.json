{
  "name": "@codai/service-stability",
  "version": "1.0.0",
  "description": "Comprehensive service stability and integration system for CODAI ecosystem with health monitoring, load balancing, and failover capabilities",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./health": {
      "import": "./dist/health/index.esm.js",
      "require": "./dist/health/index.js",
      "types": "./dist/health/index.d.ts"
    },
    "./gateway": {
      "import": "./dist/gateway/index.esm.js",
      "require": "./dist/gateway/index.js",
      "types": "./dist/gateway/index.d.ts"
    },
    "./communication": {
      "import": "./dist/communication/index.esm.js",
      "require": "./dist/communication/index.js",
      "types": "./dist/communication/index.d.ts"
    },
    "./monitoring": {
      "import": "./dist/monitoring/index.esm.js",
      "require": "./dist/monitoring/index.js",
      "types": "./dist/monitoring/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "health:check": "node scripts/health-check.js",
    "monitor": "node scripts/service-monitor.js",
    "gateway:start": "node scripts/gateway-start.js",
    "stability:test": "node scripts/stability-test.js"
  },
