{
  "verbose": true,
  "delay": "1000ms",
  "env": {
    "DEBUG": "codai:*",
    "NODE_ENV": "development",
    "LOG_LEVEL": "debug"
  },
  "legacyWatch": true,
  "watch": [
    "src",
    "."
  ],
  "exec": "npx tsx src/server-mvp.ts",
  "ext": "js,ts,json",
  "ignore": [
    "node_modules/",
    "dist/",
    "build/",
    "*.log",
    "*.test.js",
    "*.test.ts"
  ]
}
