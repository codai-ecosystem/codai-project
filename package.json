{
  "name": "@codai/monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@types/react": "^19.1.8",
      "@types/react-dom": "^19.1.6",
      "jest": "^30.0.4",
      "tailwindcss": "^3.4.17",
      "use-sync-external-store": "^1.2.0",
      "dmg-builder": "^26.0.12",
      "electron-builder-squirrel-windows": "^26.0.12",
      "app-builder-lib": "^26.0.12"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "jest",
        "tailwindcss"
      ],
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "jest": "30",
        "tailwindcss": "3"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit-components.test.ts",
    "test:integration": "vitest run tests/api-integration.test.ts",
    "test:e2e": "playwright test tests/comprehensive-coverage.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:debug": "vitest run --reporter=verbose",
    "test:quick": "vitest run tests/unit-components.test.ts --reporter=basic",
    "test:comprehensive": "node run-comprehensive-tests.js",
    "dev": "turbo dev --concurrency=80",
    "build": "turbo build --concurrency=60",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "validate": "pnpm run lint && pnpm run type-check && pnpm run test:coverage",
    "security:audit": "pnpm audit",
    "security:scan": "npm audit --audit-level high",
    "deps:update": "pnpm update --interactive",
    "deps:outdated": "pnpm outdated",
    "ports:check": "node scripts/enforce-port-policy.js",
    "ports:fix": "node scripts/enforce-port-policy.js --fix"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "array-flatten": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.23.3",
    "glob": "^11.0.3",
    "http-proxy-middleware": "^3.0.5",
    "is-stream": "^4.0.1",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "openai": "^5.9.0",
    "playwright": "^1.49.1",
    "prisma": "^6.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@jridgewell/sourcemap-codec": "^1.5.4",
    "@next/env": "^15.3.5",
    "@playwright/test": "^1.54.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/helpers": "^0.5.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.3.5",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-jsdoc": "^51.4.0",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "estraverse": "^5.3.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "next": "^15.4.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.49.1",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supertest": "^7.1.3",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "24.1.0",
    "pnpm": "9.15.9"
  }
}