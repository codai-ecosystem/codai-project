{
  "name": "codai-project",
  "version": "1.0.0",
  "description": "CODAI Ecosystem - AI-native development platform",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "apps/aide/apps/*",
      "apps/aide/packages/*",
      "apps/memorai/apps/*",
      "apps/memorai/packages/*",
      "libs/*"
    ]
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"if(process.env.npm_execpath && !process.env.npm_execpath.includes('pnpm')) { console.error('❌ This repository uses pnpm. Please use \\\"pnpm install\\\" instead of \\\"npm install\\\".\\n ℹ️ If you don\\'t have pnpm installed, run: npm install -g pnpm'); process.exit(1) }\"",
    "// === DEVELOPMENT SCRIPTS ===": "",
    "dev:all": "concurrently \"pnpm dev:frontend\" \"pnpm dev:services\"",
    "dev:frontend": "concurrently \"pnpm --filter codai run dev\" \"pnpm --filter memorai run dev\" \"pnpm --filter docs run dev\"",
    "dev:cautai": "concurrently \"pnpm --filter '@codai/romcp-web' run dev\" \"pnpm --filter '@codai/cautai-server' run start:dev\"",
    "dev:services": "docker-compose up -d postgres redis && pnpm --filter '@codai/memorai-mcp' run dev",
    "dev:essential": "pnpm run services:start && concurrently \"pnpm --filter id run dev\" \"pnpm --filter gateway run dev\" \"pnpm --filter hub run dev\"",
    "dev:setup": "cp .env.example .env.local && pnpm install && pnpm build:packages",
    "start:production": "NODE_ENV=production pnpm --filter codai run start",
    "// === ESSENTIAL SERVICES ===": "",
    "services:start": "docker-compose up -d postgres redis",
    "services:stop": "docker-compose down",
    "services:restart": "pnpm services:stop && pnpm services:start",
    "services:logs": "docker-compose logs -f",
    "services:health": "docker-compose ps && curl -s http://localhost:4300/health && curl -s http://localhost:8020/health",
    "// === BUILD SCRIPTS ===": "",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:packages": "pnpm --filter './packages/*' run build",
    "build:cautai": "pnpm --filter '@codai/cautai-*' run build && pnpm --filter '@codai/romcp-web' run build && pnpm --filter '@codai/cautai-server' run build",
    "build:apps": "pnpm --filter './apps/*' run build",
    "build:essential": "pnpm --filter id --filter gateway --filter hub --filter '@codai/memorai-mcp' --filter bancai run build",
    "build:codai": "pnpm --filter '@codai/shared-ui' run build && pnpm --filter '@codai/api-utils' run build && pnpm --filter codai run build",
    "build:production": "NODE_ENV=production pnpm run build && pnpm run optimize",
    "build:docker": "docker-compose build",
    "build:clean": "pnpm clean && pnpm install && pnpm build",
    "// === TEST SCRIPTS ===": "",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm --recursive --parallel run test:unit",
    "test:integration": "pnpm --recursive run test:integration",
    "test:e2e": "pnpm --filter '@codai/e2e-tests' run test",
    "test:contract": "pnpm --recursive run test:contract",
    "test:essential": "pnpm --filter id --filter gateway --filter hub --filter '@codai/memorai-mcp' --filter bancai run test",
    "test:cautai": "pnpm --filter '@codai/cautai-*' --filter '@codai/romcp-web' --filter '@codai/cautai-server' run test",
    "test:coverage": "pnpm --recursive run test:coverage && pnpm merge:coverage",
    "test:watch": "pnpm --recursive --parallel run test:watch",
    "test:ci": "pnpm run test:unit && pnpm run test:integration && pnpm run test:contract && pnpm run test:e2e",
    "test:performance": "pnpm --filter '@codai/performance-tests' run test",
    "test:security": "pnpm audit --audit-level high && pnpm run security:scan",
    "// === QUALITY ASSURANCE SCRIPTS ===": "",
    "lint": "pnpm --recursive --parallel run lint",
    "lint:fix": "pnpm --recursive --parallel run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "pnpm --recursive --parallel run type-check",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
    "quality:fix": "pnpm run lint:fix && pnpm run format",
    "// === CI/CD PIPELINE SCRIPTS ===": "",
    "ci": "pnpm run quality && pnpm run test:ci && pnpm run build:production",
    "ci:fast": "pnpm run lint && pnpm run test:unit && pnpm run build",
    "ci:security": "pnpm run security:scan && pnpm run test:security",
    "ci:performance": "pnpm run test:performance && pnpm run lighthouse:ci",
    "pipeline": "pnpm run ci && pnpm run ci:security && pnpm run ci:performance",
    "// === DEPLOYMENT SCRIPTS ===": "",
    "preview": "pnpm run build:production && pnpm run start:production",
    "deploy:staging": "pnpm run ci && node scripts/deploy-staging.js",
    "deploy:production": "pnpm run ci && node scripts/deploy-production.js",
    "deploy:docker": "pnpm run build:docker && docker-compose up -d",
    "// === MAINTENANCE SCRIPTS ===": "",
    "clean": "pnpm --recursive run clean && rimraf node_modules .next dist build coverage",
    "clean:cache": "pnpm store prune && rimraf .cache .turbo node_modules/.cache",
    "clean:deps": "rimraf node_modules apps/*/node_modules packages/*/node_modules pnpm-lock.yaml",
    "reset": "pnpm run clean:deps && pnpm install",
    "update": "pnpm update --recursive --latest",
    "install:all": "pnpm install --frozen-lockfile",
    "// === ANALYSIS AND OPTIMIZATION ===": "",
    "analyze": "pnpm --filter codai run analyze",
    "bundle:analyze": "ANALYZE=true pnpm run build:production",
    "lighthouse": "lighthouse http://localhost:3000 --output json --output html --output-path ./reports/lighthouse",
    "lighthouse:ci": "lhci autorun",
    "optimize": "pnpm run optimize:images && pnpm run optimize:deps",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:deps": "depcheck --ignore-dirs=.next,dist,build",
    "// === DEVELOPMENT UTILITIES ===": "",
    "db:migrate": "pnpm --filter '@codai/database' run migrate",
    "db:seed": "pnpm --filter '@codai/database' run seed",
    "db:reset": "pnpm --filter '@codai/database' run reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:health": "docker-compose ps",
    "// === MONITORING AND DEBUGGING ===": "",
    "monitor": "concurrently \"pnpm run monitor:cpu\" \"pnpm run monitor:memory\"",
    "monitor:cpu": "node scripts/monitor-cpu.js",
    "monitor:memory": "node scripts/monitor-memory.js",
    "debug": "NODE_OPTIONS='--inspect' pnpm dev",
    "debug:test": "NODE_OPTIONS='--inspect-brk' pnpm test",
    "profile": "NODE_OPTIONS='--prof' pnpm dev",
    "// === SECURITY SCRIPTS ===": "",
    "security:scan": "snyk test && npm audit",
    "security:fix": "snyk wizard && npm audit fix",
    "security:monitor": "snyk monitor",
    "deps:check": "ncu -u && pnpm audit",
    "// === DOCUMENTATION SCRIPTS ===": "",
    "docs": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:api": "typedoc --out docs/api src",
    "docs:coverage": "nyc report --reporter=html --report-dir=docs/coverage",
    "// === UTILITY SCRIPTS ===": "",
    "merge:coverage": "node scripts/merge-coverage.js",
    "generate:types": "pnpm --recursive run generate:types",
    "generate:api": "pnpm --filter '@codai/api-utils' run generate",
    "storybook": "pnpm --filter '@codai/shared-ui' run storybook",
    "release": "changeset publish",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.0.14",
    "prettier": "^3.6.2",
    "eslint": "^9.31.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.1",
    "lighthouse": "^12.0.0",
    "@lhci/cli": "^0.14.0",
    "snyk": "^1.1298.3",
    "depcheck": "^1.4.7",
    "npm-check-updates": "^17.1.10",
    "typedoc": "^0.26.11",
    "nyc": "^17.1.0",
    "@changesets/cli": "^2.27.9",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9"
  },
  "pnpm": {
    "overrides": {
      "next": "15.4.2",
      "typescript": "5.9.2",
      "@typescript-eslint/eslint-plugin": "8.41.0",
      "@typescript-eslint/parser": "8.41.0",
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
      },
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}