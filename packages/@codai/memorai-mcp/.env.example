# MemorAI Azure OpenAI Configuration Example
# Copy this file to .env and fill in your Azure OpenAI details

# Azure OpenAI Configuration (Primary - Required)
AZURE_OPENAI_ENDPOINT="https://your-azure-openai-endpoint.openai.azure.com/"
AZURE_OPENAI_KEY="your-azure-openai-api-key"
AZURE_OPENAI_API_VERSION="2024-10-01-preview"
AZURE_OPENAI_EMBEDDING_ADA_DEPLOYMENT="text-embedding-ada-002"
AZURE_OPENAI_EMBEDDING_MODEL="text-embedding-ada-002"

# MemorAI Configuration
MEMORAI_CBD_PATH="./memorai-cbd-data"
MEMORAI_LOG_LEVEL="info"
MEMORAI_CACHE_SIZE="10000"
MEMORAI_MAX_MEMORIES="100000"
MEMORAI_DIMENSIONS="1536"

# Feature Flags
MEMORAI_ENABLE_SEMANTIC_SEARCH="true"
MEMORAI_ENABLE_PERFORMANCE_TRACKING="true"
MEMORAI_ENABLE_HYBRID_STORAGE="true"
MEMORAI_FALLBACK_STORAGE="json"

# Environment
NODE_ENV="production"

# Legacy OpenAI (Optional Fallback)
# OPENAI_API_KEY="your-openai-api-key"

# GPT-5 Deployments (New - August 2025)
AZURE_OPENAI_GPT5_DEPLOYMENT=gpt-5
AZURE_OPENAI_GPT5_MINI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_GPT5_NANO_DEPLOYMENT=gpt-5-nano