# Environment Configuration for AI MCP
NODE_ENV=development
LOG_LEVEL=info
SERVER_NAME=@codai/ai-mcp
SERVER_VERSION=1.0.0

# API Configuration
API_TIMEOUT=30000
ENABLE_CORS=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Azure OpenAI Configuration (Primary Provider)
# Note: These are automatically loaded from workspace root .env file
AZURE_OPENAI_ENDPOINT=https://aide-openai-dev.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENTS=gpt-4,gpt-4-turbo,gpt-35-turbo,text-embedding-ada-002

# OpenAI Configuration (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face Configuration (Optional)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODELS=microsoft/DialoGPT-medium,gpt2

# Ollama Configuration (Optional)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODELS=llama2,codellama

# NOTE: Azure OpenAI credentials are automatically loaded from workspace root .env file
# This ensures all MCP servers use the same Azure OpenAI instance for consistency

# GPT-5 Deployments (New - August 2025)
AZURE_OPENAI_GPT5_DEPLOYMENT=gpt-5
AZURE_OPENAI_GPT5_MINI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_GPT5_NANO_DEPLOYMENT=gpt-5-nano