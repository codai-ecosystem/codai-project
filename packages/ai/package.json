{
  "name": "@codai/ai",
  "version": "1.0.0",
  "description": "AI-native features and intelligent automation for Codai ecosystem",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc --build && tsc --build tsconfig.esm.json",
    "dev": "tsc --build --watch",
    "lint": "pnpm exec eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm exec eslint src --ext .ts,.tsx --fix",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.23",
    "@langchain/anthropic": "^0.3.24",
    "@langchain/core": "^0.3.62",
    "@langchain/openai": "^0.5.18",
    "ai": "^4.3.17",
    "openai": "^5.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@codai/config": "workspace:*",
    "@types/node": "^24.0.13",
    "eslint": "^9.31.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "packages/ai"
  },
  "keywords": [
    "ai",
    "machine-learning",
    "openai",
    "anthropic",
    "langchain",
    "codegen",
    "automation"
  ],
  "author": "Codai Team <team@codai.ai>",
  "license": "MIT"
}
