{
  "name": "@codai/aide-integration",
  "version": "1.0.0",
  "description": "AIDE Integration Layer - Centralized service orchestration for connecting AIDE with all CODAI ecosystem services including SSO, analytics, monitoring, security, and deployment.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codai/shared-types": "workspace:*",
    "@codai/config": "workspace:*",
    "@codai/analytics": "workspace:*",
    "@codai/auth": "workspace:*",
    "@codai/memorai": "workspace:*",
    "@codai/glass-mcp": "workspace:*",
    "@codai/romai": "workspace:*",
    "@codai/logai-sdk": "workspace:*",
    "zod": "^3.23.8",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "eslint": "^9.11.1",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./orchestrator": {
      "import": "./dist/orchestrator/index.js",
      "require": "./dist/orchestrator/index.js",
      "types": "./dist/orchestrator/index.d.ts"
    }
  }
}
