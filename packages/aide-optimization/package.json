{
  "name": "@aide/optimization",
  "version": "1.0.0",
  "description": "AIDE Continuous Improvement & ROMAI-Driven Optimization System",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./performance": {
      "types": "./dist/performance/index.d.ts",
      "import": "./dist/performance/index.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence/index.d.ts",
      "import": "./dist/intelligence/index.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring/index.d.ts",
      "import": "./dist/monitoring/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.esm.json",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "openai": "^4.28.4",
    "prom-client": "^15.1.3",
    "node-cron": "^3.0.3",
    "lodash": "^4.17.21",
    "redis": "^4.6.11",
    "ws": "^8.16.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/lodash": "^4.14.202",
    "@types/ws": "^8.5.10",
    "@types/node-fetch": "^2.6.11",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "aide",
    "optimization",
    "romai",
    "continuous-improvement",
    "monitoring",
    "performance",
    "intelligence"
  ],
  "author": "AIDE Team",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md"
  ]
}
