{
  "name": "@codai/api-documentation",
  "version": "1.0.0",
  "description": "Interactive OpenAPI/Swagger documentation generator for Essential CodAI Services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codai-docs": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "generate": "tsx src/cli.ts generate",
    "serve": "tsx src/cli.ts serve",
    "validate": "tsx src/cli.ts validate",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify": "^4.29.1",
    "@fastify/static": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.17.14",
    "openapi-types": "^12.1.3",
    "json-schema-to-typescript": "^15.0.4",
    "axios": "^1.7.2",
    "yaml": "^2.5.1",
    "mustache": "^4.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "chokidar": "^4.0.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/mustache": "^4.2.5",
    "@types/fs-extra": "^11.0.4",
    "tsx": "^4.19.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.18.0"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api-documentation",
    "codai",
    "typescript",
    "interactive-docs"
  ],
  "author": "CodAI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-project/codai.git",
    "directory": "packages/api-documentation"
  }
}