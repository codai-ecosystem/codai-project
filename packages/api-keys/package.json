{
  "name": "@codai/api-keys",
  "version": "1.0.0",
  "description": "Universal API Key Management System for CODAI Ecosystem",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "lint:fix": "pnpm exec eslint src --ext .ts,.tsx --fix",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "keywords": [
    "api-keys",
    "authentication",
    "security",
    "codai",
    "key-management",
    "encryption",
    "tokens"
  ],
  "author": "CODAI Team",
  "license": "MIT",
  "dependencies": {
    "@codai/core": "workspace:*",
    "@codai/logai-sdk": "workspace:*",
    "bcryptjs": "^3.0.2",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "redis": "^5.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.13",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.31.0",
    "jest": "^30.0.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}