{
    "name": "@codai/api-standards",
    "version": "1.0.0",
    "description": "Universal API standards for CODAI ecosystem",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@codai/auth": "workspace:*",
        "@codai/core": "workspace:*",
        "zod": "^3.22.0",
        "express-rate-limit": "^7.1.0",
        "helmet": "^7.1.0",
        "cors": "^2.8.5",
        "morgan": "^1.10.0",
        "compression": "^1.7.4",
        "swagger-ui-express": "^5.0.0",
        "openapi-types": "^12.1.0",
        "express": "^4.18.0",
        "jsonwebtoken": "^9.0.0",
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.0",
        "@types/morgan": "^1.9.0",
        "@types/cors": "^2.8.0",
        "@types/compression": "^1.7.0",
        "@types/swagger-ui-express": "^4.1.0",
        "@types/jsonwebtoken": "^9.0.0",
        "typescript": "^5.0.0",
        "tsup": "^8.0.0",
        "rimraf": "^5.0.0"
    },
    "keywords": [
        "api",
        "standards",
        "codai",
        "rest",
        "openapi",
        "middleware"
    ],
    "author": "CodAI Team",
    "license": "MIT",
    "publishConfig": {
        "access": "restricted"
    }
}