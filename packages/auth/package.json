{
  "name": "@codai/auth",
  "version": "1.1.2",
  "description": "Universal authentication utilities for the Codai ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc --build && tsc --build tsconfig.esm.json",
    "dev": "tsc --build --watch",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@codai/core": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "js-cookie": "^3.0.5",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.3",
    "jsonwebtoken": "^9.0.2",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/speakeasy": "^2.0.10",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.31.0",
    "jest": "^30.0.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codai",
    "authentication",
    "auth",
    "jwt",
    "session",
    "typescript"
  ],
  "author": "Codai Team",
  "license": "MIT"
}