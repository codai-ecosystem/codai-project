{
  "name": "@codai/cautai-config",
  "version": "1.0.0",
  "description": "Shared configuration for Cautai packages - ESLint, TypeScript, Prettier, Vitest",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./eslint": {
      "import": "./dist/eslint.mjs",
      "require": "./dist/eslint.js",
      "types": "./dist/eslint.d.ts"
    },
    "./typescript": {
      "import": "./dist/typescript.mjs",
      "require": "./dist/typescript.js",
      "types": "./dist/typescript.d.ts"
    },
    "./prettier": {
      "import": "./dist/prettier.mjs",
      "require": "./dist/prettier.js",
      "types": "./dist/prettier.d.ts"
    },
    "./vitest": {
      "import": "./dist/vitest.mjs",
      "require": "./dist/vitest.js",
      "types": "./dist/vitest.d.ts"
    },
    "./tailwind": {
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js",
      "types": "./dist/tailwind.d.ts"
    },
    "./unbuild": {
      "import": "./dist/unbuild.mjs",
      "require": "./dist/unbuild.js",
      "types": "./dist/unbuild.d.ts"
    }
  },
  "scripts": {
    "build": "unbuild",
    "build:watch": "unbuild --watch",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.js,.mjs",
    "lint:fix": "eslint src --ext .ts,.js,.mjs --fix",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.9.2",
    "vitest": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "unbuild": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.10",
    "rimraf": "^5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "keywords": [
    "config",
    "eslint",
    "typescript",
    "prettier",
    "vitest",
    "cautai",
    "shared"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "packages/cautai-config"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://cautai.ro"
}