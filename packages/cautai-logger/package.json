{
  "name": "@codai/logger",
  "version": "1.0.0",
  "description": "Comprehensive logging and error handling for Cautai",
  "author": "CODAI Ecosystem",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@codai/config": "workspace:*",
    "@types/node": "^20.11.5",
    "eslint": "^8.57.0",
    "typescript": "^5.9.2",
    "unbuild": "^2.0.0",
    "vitest": "^1.6.0",
    "rimraf": "^5.0.5"
  }
}