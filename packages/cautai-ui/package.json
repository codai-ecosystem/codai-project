{
  "name": "@codai/cautai-ui",
  "version": "1.0.0",
  "description": "Cautai UI Design System - React components and styles for the Cautai ecosystem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css",
    "./tailwind": {
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js",
      "types": "./dist/tailwind.d.ts"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "unbuild && pnpm build:styles",
    "build:watch": "concurrently \"unbuild --watch\" \"pnpm build:styles:watch\"",
    "build:styles": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "build:styles:watch": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --watch",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist storybook-static"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.317.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@codai/cautai-config": "workspace:*",
    "@codai/cautai-i18n": "workspace:*",
    "@storybook/addon-essentials": "^7.6.10",
    "@storybook/addon-interactions": "^7.6.10",
    "@storybook/addon-links": "^7.6.10",
    "@storybook/blocks": "^7.6.10",
    "@storybook/react": "^7.6.10",
    "@storybook/react-vite": "^7.6.10",
    "@storybook/testing-library": "^0.2.2",
    "@types/node": "^20.11.10",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "storybook": "^7.6.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.2",
    "unbuild": "^2.0.0",
    "vite": "^5.1.0",
    "vitest": "^1.2.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "tailwindcss",
    "cautai",
    "storybook"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "packages/cautai-ui"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://cautai.ro"
}