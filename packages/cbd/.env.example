# CBD Engine Service Environment Configuration
# Set this to your actual OpenAI API key for embedding functionality
OPENAI_API_KEY=sk-placeholder-key-for-testing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# CBD Service Configuration
CBD_PORT=4180
CBD_HOST=localhost
CBD_DATA_PATH=./cbd-data

# Node.js Configuration
NODE_ENV=development
