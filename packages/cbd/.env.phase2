# CBD Multi-Cloud Environment Configuration

# ================================
# Phase 2: Multi-Cloud Integration
# ================================

# General Configuration
CBD_PHASE=2
CBD_CLOUD_STRATEGY=performance
CBD_PRIMARY_CLOUD=local
CBD_ENABLE_MULTI_CLOUD=true

# ================================
# AWS Configuration (Optional)
# ================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here (optional)

# AWS Services Configuration
# AWS_DYNAMODB_ENDPOINT=https://dynamodb.us-east-1.amazonaws.com
# AWS_OPENSEARCH_ENDPOINT=https://your-domain.us-east-1.es.amazonaws.com
# AWS_S3_BUCKET=cbd-universal-storage
# AWS_RDS_ENDPOINT=your-rds-instance.us-east-1.rds.amazonaws.com

# ================================
# Azure Configuration (Optional)
# ================================
# AZURE_TENANT_ID=your_tenant_id_here
# AZURE_CLIENT_ID=your_client_id_here
# AZURE_CLIENT_SECRET=your_client_secret_here
# AZURE_SUBSCRIPTION_ID=your_subscription_id_here
# AZURE_RESOURCE_GROUP=cbd-resources

# Azure Services Configuration
# AZURE_COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
# AZURE_COSMOS_DB_KEY=your_cosmos_key_here
# AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# AZURE_SEARCH_KEY=your_search_key_here
# AZURE_STORAGE_ACCOUNT=cbdstorageaccount
# AZURE_STORAGE_KEY=your_storage_key_here

# ================================
# GCP Configuration (Optional)
# ================================
# GOOGLE_CLOUD_PROJECT=your_project_id_here
# GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# GCP Services Configuration
# GCP_FIRESTORE_DATABASE=(default)
# GCP_SPANNER_INSTANCE=cbd-instance
# GCP_SPANNER_DATABASE=cbd-database
# GCP_STORAGE_BUCKET=cbd-gcp-storage
# GCP_BIGQUERY_DATASET=cbd_analytics

# ================================
# Local Configuration (Current)
# ================================
CBD_LOCAL_DATA_PATH=./data
CBD_LOCAL_BACKUP_PATH=./backup
CBD_LOCAL_MAX_MEMORY_MB=2048
CBD_LOCAL_ENABLE_PERSISTENCE=true
CBD_LOCAL_COMPRESSION=true

# ================================
# Monitoring Configuration
# ================================
CBD_MONITORING_ENABLED=true
CBD_MONITORING_INTERVAL=60000
CBD_MONITORING_CLOUDWATCH=false
CBD_MONITORING_AZURE_MONITOR=false
CBD_MONITORING_GCP_OPERATIONS=false

# ================================
# Cost Optimization
# ================================
CBD_COST_OPTIMIZATION=true
CBD_MAX_MONTHLY_COST=100
CBD_COST_ALERTS=true
CBD_AUTO_SCALING=true
CBD_SPOT_INSTANCES=false

# ================================
# Security Configuration
# ================================
CBD_ZERO_TRUST=true
CBD_QUANTUM_ENCRYPTION=true
CBD_COMPLIANCE_AUTOMATION=true
CBD_THREAT_MONITORING=true

# ================================
# Service Ports (Phase 2)
# ================================
CBD_CORE_PORT=4180
CBD_COLLABORATION_PORT=4600
CBD_AI_ANALYTICS_PORT=4700
CBD_GRAPHQL_PORT=4800
CBD_SERVICE_MESH_PORT=4000

# ================================
# AI Services Configuration
# ================================
CBD_AI_ENABLED=true
CBD_ML_BACKEND=tensorflow.js
CBD_NLP_ENABLED=true
CBD_DOCUMENT_INTELLIGENCE=true
CBD_QUERY_OPTIMIZATION=true
CBD_ANALYTICS_ENABLED=true

# ================================
# Phase 2 Advanced Features
# ================================
CBD_REAL_TIME_COLLABORATION=true
CBD_OPERATIONAL_TRANSFORM=true
CBD_USER_PRESENCE=true
CBD_WEBSOCKETS=true
CBD_JWT_AUTHENTICATION=true

# Demo JWT Secret (Change in production)
CBD_JWT_SECRET=your_jwt_secret_key_change_in_production_123456789

# ================================
# Development Settings
# ================================
NODE_ENV=development
DEBUG=cbd:*
LOG_LEVEL=info

# ================================
# Database Paradigms
# ================================
CBD_DOCUMENT_ENABLED=true
CBD_VECTOR_ENABLED=true
CBD_GRAPH_ENABLED=true
CBD_KEY_VALUE_ENABLED=true
CBD_TIME_SERIES_ENABLED=true
CBD_FILE_STORAGE_ENABLED=true

# ================================
# Performance Tuning
# ================================
CBD_MAX_CONNECTIONS=1000
CBD_QUERY_TIMEOUT=30000
CBD_CACHE_SIZE_MB=512
CBD_COMPRESSION_LEVEL=6
CBD_BATCH_SIZE=1000

# ================================
# Future Technologies (Phase 4)
# ================================
CBD_QUANTUM_COMPUTING=false
CBD_DIGITAL_TWINS=false
CBD_BLOCKCHAIN_AUDIT=false
CBD_MIXED_REALITY=false
CBD_EDGE_COMPUTING=false
