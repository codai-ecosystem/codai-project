# CBD Enterprise Dockerfile
# Multi-stage build for optimized production image

# Build stage
FROM rust:1.75-slim as builder

WORKDIR /usr/src/app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Build optimized release binary
RUN cargo build --release --bin cbd-enterprise

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    libpq5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1001 -g root cbd

# Copy binary from builder stage
COPY --from=builder /usr/src/app/target/release/cbd-enterprise /usr/local/bin/cbd-enterprise

# Create necessary directories
RUN mkdir -p /app/data /app/logs && \
    chown -R cbd:root /app && \
    chmod -R g+rwX /app

# Switch to non-root user
USER 1001

WORKDIR /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:4180/health || exit 1

# Expose ports
EXPOSE 4180 4181 9090

# Environment variables
ENV RUST_LOG=info
ENV CBD_HOST=0.0.0.0
ENV CBD_PORT=4180
ENV CBD_GRPC_PORT=4181
ENV CBD_METRICS_PORT=9090
ENV CBD_DATA_PATH=/app/data
ENV CBD_LOG_PATH=/app/logs

# Start command
CMD ["cbd-enterprise"]
