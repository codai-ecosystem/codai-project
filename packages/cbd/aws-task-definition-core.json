{
    "family": "cbd-universal-db",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::567877624442:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::567877624442:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "cbd-core",
            "image": "567877624442.dkr.ecr.eu-west-1.amazonaws.com/cbd-universal-db:latest",
            "portMappings": [
                {
                    "containerPort": 4180,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/cbd-universal-db",
                    "awslogs-region": "eu-west-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "environment": [
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "PORT",
                    "value": "4180"
                },
                {
                    "name": "CBD_MODE",
                    "value": "production"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:4180/health || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            }
        }
    ]
}