/**
 * Time-Series Storage Engine - InfluxDB-compatible time-series database
 * Part of CBD Universal Database Phase 3
 */

import { EventEmitter } from 'events';

export interface TimeSeriesPoint {
    measurement: string;
    tags: Record<string, string>;
