            filteredPoints.sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());d<string, number | string | boolean>;
    timestamp: Date;
}

export interface TimeSeriesQuery {
    measurement: string;
    startTime?: Date;
    endTime?: Date;
    tags?: Record<string, string>;
    fields?: string[];
    aggregation?: 'mean' | 'sum' | 'count' | 'min' | 'max' | 'first' | 'last';
    groupBy?: string[];
    interval?: string; // e.g., '1m', '5m', '1h', '1d'
    limit?: number;
    offset?: number;
}

export interface TimeSeriesResult {
    measurement: string;
    points: TimeSeriesPoint[];
    totalCount: number;
    executionTime: number;
}

export interface TimeSeriesStats {
    totalPoints: number;
    measurements: Map<string, number>;
    timeRange: {
        earliest: Date | null;
        latest: Date | null;
    };
    retention: {
        policies: RetentionPolicy[];
        totalSize: number;
    };
    queryLatency: {
        p50: number;
        p95: number;
        p99: number;
    };
}

export interface RetentionPolicy {
    name: string;
    duration: string; // e.g., '30d', '1y', 'INF'
    shardDuration: string; // e.g., '1d', '1w'
    replicationFactor: number;
    isDefault: boolean;
}

export interface Measurement {
    name: string;
    tags: Set<string>;
    fields: Map<string, 'number' | 'string' | 'boolean'>;
    pointCount: number;
    firstPoint: Date | null;
    lastPoint: Date | null;
}

export class TimeSeriesStorageEngine extends EventEmitter {
    private measurements: Map<string, Measurement> = new Map();
    private points: Map<string, TimeSeriesPoint[]> = new Map(); // measurement -> points
    private tagIndex: Map<string, Map<string, Map<string, Set<number>>>> = new Map(); // measurement -> tag -> value -> point indices
    private timeIndex: Map<string, Map<number, number[]>> = new Map(); // measurement -> time bucket -> point indices
    private retentionPolicies: Map<string, RetentionPolicy> = new Map();
    private stats: number[] = []; // Query latencies
    private readonly bucketSize = 60000; // 1 minute buckets in milliseconds

    constructor() {
        super();
        this.setupDefaultRetentionPolicy();
        this.emit('engine:initialized', { type: 'timeseries' });
    }

    async initialize(): Promise<void> {
        // Initialize the time-series storage engine
        this.emit('initialized');
    }

    /**
     * Write method for CBD service compatibility
     */
    async write(measurement: string, tags: Record<string, string> = {}, fields: Record<string, number>, timestamp?: number): Promise<any> {
        const point: TimeSeriesPoint = {
            measurement: measurement || 'default',
            tags: tags || {},
            fields: fields,
            timestamp: timestamp ? new Date(timestamp) : new Date()
        };

        await this.writePoint(point);

        return {
            id: `ts_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
            timestamp: point.timestamp,
            value: Object.values(fields)[0] || 0,
            tags: point.tags,
            fields: fields
        };
    }

    /**
     * Write a time-series point
     */
    async writePoint(point: TimeSeriesPoint): Promise<void> {
        try {
            const { measurement, tags, fields, timestamp } = point;

            // Ensure measurement exists
            if (!this.measurements.has(measurement)) {
                this.measurements.set(measurement, {
                    name: measurement,
                    tags: new Set(),
                    fields: new Map(),
                    pointCount: 0,
                    firstPoint: null,
                    lastPoint: null
                });
                this.points.set(measurement, []);
                this.tagIndex.set(measurement, new Map());
                this.timeIndex.set(measurement, new Map());
            }

            const measurementInfo = this.measurements.get(measurement)!;
            const pointsArray = this.points.get(measurement)!;

            // Update measurement metadata
            Object.keys(tags).forEach(tag => measurementInfo.tags.add(tag));
            Object.entries(fields).forEach(([field, value]) => {
                measurementInfo.fields.set(field, typeof value as 'number' | 'string' | 'boolean');
            });

            // Update time range
            if (!measurementInfo.firstPoint || timestamp < measurementInfo.firstPoint) {
                measurementInfo.firstPoint = timestamp;
            }
            if (!measurementInfo.lastPoint || timestamp > measurementInfo.lastPoint) {
                measurementInfo.lastPoint = timestamp;
            }

            // Add point
            pointsArray.push(point);
            const pointIndex = pointsArray.length - 1;
            measurementInfo.pointCount++;

            // Update tag index
            const measurementTagIndex = this.tagIndex.get(measurement)!;
            for (const [tagKey, tagValue] of Object.entries(tags)) {
                const tagMap = measurementTagIndex.get(tagKey) || new Map<string, Set<number>>();
                const valueSet = tagMap.get(tagValue) || new Set<number>();
                valueSet.add(pointIndex);
                tagMap.set(tagValue, valueSet);
                measurementTagIndex.set(tagKey, tagMap);
            }

            // Update time index
            const measurementTimeIndex = this.timeIndex.get(measurement)!;
            const timeBucket = Math.floor(timestamp.getTime() / this.bucketSize);
            const bucketPoints = measurementTimeIndex.get(timeBucket) || [];
            bucketPoints.push(pointIndex);
            measurementTimeIndex.set(timeBucket, bucketPoints);

            this.emit('point:written', { measurement, timestamp, tags, fields });

        } catch (error) {
            this.emit('timeseries:error', { operation: 'writePoint', point, error });
            throw error;
        }
    }

    /**
     * Write multiple points in batch
     */
    async writePoints(points: TimeSeriesPoint[]): Promise<void> {
        const startTime = Date.now();

        for (const point of points) {
            await this.writePoint(point);
        }

        const duration = Date.now() - startTime;
        this.emit('points:batchWritten', {
            count: points.length,
            duration,
            throughput: points.length / (duration / 1000)
        });
    }

    /**
     * Query time-series data
     */
    async query(query: TimeSeriesQuery): Promise<TimeSeriesResult> {
        const startTime = Date.now();

        try {
            const {
                measurement,
                startTime: queryStartTime,
                endTime: queryEndTime,
                tags = {},
                fields,
                aggregation,
                groupBy,
                interval,
                limit,
                offset = 0
            } = query;

            if (!this.measurements.has(measurement)) {
                return {
                    measurement,
                    points: [],
                    totalCount: 0,
                    executionTime: Date.now() - startTime
                };
            }

            const pointsArray = this.points.get(measurement)!;
            let candidateIndices = new Set<number>();

            // Filter by time range
            if (queryStartTime || queryEndTime) {
                const measurementTimeIndex = this.timeIndex.get(measurement)!;
                const startBucket = queryStartTime ? Math.floor(queryStartTime.getTime() / this.bucketSize) : -Infinity;
                const endBucket = queryEndTime ? Math.floor(queryEndTime.getTime() / this.bucketSize) : Infinity;

                for (const [bucket, indices] of measurementTimeIndex) {
                    if (bucket >= startBucket && bucket <= endBucket) {
                        indices.forEach(idx => candidateIndices.add(idx));
                    }
                }
            } else {
                // All points
                for (let i = 0; i < pointsArray.length; i++) {
                    candidateIndices.add(i);
                }
            }

            // Filter by tags
            if (Object.keys(tags).length > 0) {
                const measurementTagIndex = this.tagIndex.get(measurement)!;

                for (const [tagKey, tagValue] of Object.entries(tags)) {
                    const tagMap = measurementTagIndex.get(tagKey);
                    if (!tagMap) {
                        candidateIndices.clear();
                        break;
                    }

                    const valueSet = tagMap.get(tagValue);
                    if (!valueSet) {
                        candidateIndices.clear();
                        break;
                    }

                    // Intersect with current candidates
                    candidateIndices = new Set([...candidateIndices].filter(x => valueSet.has(x)));
                }
            }

            // Get actual points and apply fine-grained time filtering
            let filteredPoints = Array.from(candidateIndices)
                .map(idx => pointsArray[idx])
                .filter(point => {
                    if (!point) return false;
                    if (queryStartTime && point.timestamp < queryStartTime) return false;
                    if (queryEndTime && point.timestamp > queryEndTime) return false;
                    return true;
                });

            // Sort by timestamp
            filteredPoints.sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());

            const totalCount = filteredPoints.length;

            // Apply aggregation and grouping
            if (aggregation || groupBy || interval) {
                filteredPoints = this.applyAggregation(filteredPoints, aggregation, groupBy, interval);
            }

            // Apply field selection
            if (fields && fields.length > 0) {
                filteredPoints = filteredPoints.map(point => ({
                    ...point,
                    fields: Object.fromEntries(
                        Object.entries(point.fields).filter(([key]) => fields.includes(key))
                    )
                }));
            }

            // Apply pagination
            if (offset > 0) {
                filteredPoints = filteredPoints.slice(offset);
            }
            if (limit) {
                filteredPoints = filteredPoints.slice(0, limit);
            }

            const duration = Date.now() - startTime;
            this.trackLatency(duration);

            this.emit('timeseries:queried', {
                measurement,
                resultCount: filteredPoints.length,
                totalCount,
                duration
            });

            return {
                measurement,
                points: filteredPoints,
                totalCount,
                executionTime: duration
            };

        } catch (error) {
            this.emit('timeseries:error', { operation: 'query', query, error });
            throw error;
        }
    }

    /**
     * Create a retention policy
     */
    async createRetentionPolicy(
        name: string,
        duration: string,
        shardDuration: string = '1d',
        replicationFactor: number = 1,
        isDefault: boolean = false
    ): Promise<void> {
        try {
            if (this.retentionPolicies.has(name)) {
                throw new Error(`Retention policy ${name} already exists`);
            }

            const policy: RetentionPolicy = {
                name,
                duration,
                shardDuration,
                replicationFactor,
                isDefault
            };

            this.retentionPolicies.set(name, policy);

            // If this is set as default, unset other defaults
            if (isDefault) {
                for (const [policyName, existingPolicy] of this.retentionPolicies) {
                    if (policyName !== name) {
                        existingPolicy.isDefault = false;
                    }
                }
            }

            this.emit('retention:policyCreated', policy);

        } catch (error) {
            this.emit('timeseries:error', { operation: 'createRetentionPolicy', name, error });
            throw error;
        }
    }

    /**
     * Delete old data based on retention policies
     */
    async applyRetentionPolicies(): Promise<void> {
        const now = new Date();
        let totalDeletedPoints = 0;

        for (const policy of this.retentionPolicies.values()) {
            if (policy.duration === 'INF') continue;

            const retentionMs = this.parseDuration(policy.duration);
            const cutoffTime = new Date(now.getTime() - retentionMs);

            for (const [measurement, points] of this.points) {
                const originalLength = points.length;

                // Remove old points
                const newPoints = points.filter(point => point.timestamp >= cutoffTime);
                this.points.set(measurement, newPoints);

                const deletedCount = originalLength - newPoints.length;
                totalDeletedPoints += deletedCount;

                if (deletedCount > 0) {
                    // Update measurement metadata
                    const measurementInfo = this.measurements.get(measurement)!;
                    measurementInfo.pointCount = newPoints.length;

                    if (newPoints.length > 0) {
                        measurementInfo.firstPoint = newPoints[0]!.timestamp;
                        measurementInfo.lastPoint = newPoints[newPoints.length - 1]!.timestamp;
                    } else {
                        measurementInfo.firstPoint = null;
                        measurementInfo.lastPoint = null;
                    }

                    // Rebuild indexes for this measurement
                    await this.rebuildIndexes(measurement);
                }
            }
        }

        if (totalDeletedPoints > 0) {
            this.emit('retention:applied', { deletedPoints: totalDeletedPoints });
        }
    }

    /**
     * Get time-series statistics
     */
    async getTimeSeriesStats(): Promise<TimeSeriesStats> {
        let totalPoints = 0;
        const measurements = new Map<string, number>();
        let earliest: Date | null = null;
        let latest: Date | null = null;

        for (const [name, measurement] of this.measurements) {
            totalPoints += measurement.pointCount;
            measurements.set(name, measurement.pointCount);

            if (measurement.firstPoint && (!earliest || measurement.firstPoint < earliest)) {
                earliest = measurement.firstPoint;
            }
            if (measurement.lastPoint && (!latest || measurement.lastPoint > latest)) {
                latest = measurement.lastPoint;
            }
        }

        const sortedLatencies = this.stats.slice().sort((a, b) => a - b);

        return {
            totalPoints,
            measurements,
            timeRange: { earliest, latest },
            retention: {
                policies: Array.from(this.retentionPolicies.values()),
                totalSize: totalPoints * 100 // Rough estimate in bytes
            },
            queryLatency: {
                p50: this.percentile(sortedLatencies, 0.5),
                p95: this.percentile(sortedLatencies, 0.95),
                p99: this.percentile(sortedLatencies, 0.99)
            }
        };
    }

    /**
     * List all measurements
     */
    async listMeasurements(): Promise<string[]> {
        return Array.from(this.measurements.keys());
    }

    /**
     * Get measurement schema
     */
    async getMeasurementSchema(measurement: string): Promise<Measurement | null> {
        return this.measurements.get(measurement) || null;
    }

    /**
     * Delete a measurement and all its data
     */
    async deleteMeasurement(measurement: string): Promise<boolean> {
        if (!this.measurements.has(measurement)) {
            return false;
        }

        this.measurements.delete(measurement);
        this.points.delete(measurement);
        this.tagIndex.delete(measurement);
        this.timeIndex.delete(measurement);

        this.emit('measurement:deleted', { measurement });
        return true;
    }

    /**
     * Delete points matching criteria
     */
    async deletePoints(
        measurement: string,
        startTime?: Date,
        endTime?: Date,
        tags?: Record<string, string>
    ): Promise<number> {
        if (!this.measurements.has(measurement)) {
            return 0;
        }

        const pointsArray = this.points.get(measurement)!;
        const originalLength = pointsArray.length;

        // Filter points to keep (opposite of delete criteria)
        const filteredPoints = pointsArray.filter(point => {
            if (startTime && point.timestamp >= startTime && (!endTime || point.timestamp <= endTime)) {
                if (tags && Object.keys(tags).length > 0) {
                    // Check if all tags match
                    const matches = Object.entries(tags).every(([key, value]) => point.tags[key] === value);
                    if (matches) return false; // This point should be deleted
                } else if (!tags || Object.keys(tags).length === 0) {
                    return false; // Delete all points in time range
                }
            }
            return true; // Keep this point
        });

        this.points.set(measurement, filteredPoints);
        const deletedCount = originalLength - filteredPoints.length;

        if (deletedCount > 0) {
            // Update measurement metadata
            const measurementInfo = this.measurements.get(measurement)!;
            measurementInfo.pointCount = filteredPoints.length;

            if (filteredPoints.length > 0) {
                measurementInfo.firstPoint = filteredPoints[0]!.timestamp;
                measurementInfo.lastPoint = filteredPoints[filteredPoints.length - 1]!.timestamp;
            } else {
                measurementInfo.firstPoint = null;
                measurementInfo.lastPoint = null;
            }

            // Rebuild indexes
            await this.rebuildIndexes(measurement);

            this.emit('points:deleted', { measurement, deletedCount });
        }

        return deletedCount;
    }

    // Private helper methods
    private setupDefaultRetentionPolicy(): void {
        this.retentionPolicies.set('default', {
            name: 'default',
            duration: '30d',
            shardDuration: '1d',
            replicationFactor: 1,
            isDefault: true
        });
    }

    private applyAggregation(
        points: TimeSeriesPoint[],
        aggregation?: string,
        groupBy?: string[],
        interval?: string
    ): TimeSeriesPoint[] {
        if (!aggregation && !groupBy && !interval) {
            return points;
        }

        // Group points by interval or groupBy criteria
        const groups = new Map<string, TimeSeriesPoint[]>();

        for (const point of points) {
            let groupKey = '';

            if (interval) {
                const intervalMs = this.parseDuration(interval);
                const bucket = Math.floor(point.timestamp.getTime() / intervalMs) * intervalMs;
                groupKey += `time:${bucket}`;
            }

            if (groupBy) {
                for (const tagKey of groupBy) {
                    groupKey += `|${tagKey}:${point.tags[tagKey] || 'null'}`;
                }
            }

            if (!groupKey) {
                groupKey = 'all';
            }

            if (!groups.has(groupKey)) {
                groups.set(groupKey, []);
            }
            groups.get(groupKey)!.push(point);
        }

        // Apply aggregation to each group
        const aggregatedPoints: TimeSeriesPoint[] = [];

        for (const [groupKey, groupPoints] of groups) {
            if (groupPoints.length === 0) continue;

            const firstPoint = groupPoints[0];
            const aggregatedFields: Record<string, number | string | boolean> = {};

            // Extract time from group key if interval is used
            let timestamp = firstPoint.timestamp;
            if (interval) {
                const timeMatch = groupKey.match(/time:(\d+)/);
                if (timeMatch) {
                    timestamp = new Date(parseInt(timeMatch[1]));
                }
            }

            // Aggregate numeric fields
            for (const fieldName of Object.keys(firstPoint.fields)) {
                const values = groupPoints
                    .map(p => p.fields[fieldName])
                    .filter(v => typeof v === 'number') as number[];

                if (values.length === 0) {
                    aggregatedFields[fieldName] = firstPoint.fields[fieldName];
                    continue;
                }

                switch (aggregation) {
                    case 'mean':
                        aggregatedFields[fieldName] = values.reduce((a, b) => a + b, 0) / values.length;
                        break;
                    case 'sum':
                        aggregatedFields[fieldName] = values.reduce((a, b) => a + b, 0);
                        break;
                    case 'count':
                        aggregatedFields[`${fieldName}_count`] = values.length;
                        break;
                    case 'min':
                        aggregatedFields[fieldName] = Math.min(...values);
                        break;
                    case 'max':
                        aggregatedFields[fieldName] = Math.max(...values);
                        break;
                    case 'first':
                        aggregatedFields[fieldName] = values[0];
                        break;
                    case 'last':
                        aggregatedFields[fieldName] = values[values.length - 1];
                        break;
                    default:
                        aggregatedFields[fieldName] = firstPoint.fields[fieldName];
                }
            }

            aggregatedPoints.push({
                measurement: firstPoint.measurement,
                tags: firstPoint.tags,
                fields: aggregatedFields,
                timestamp
            });
        }

        return aggregatedPoints.sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime());
    }

    private parseDuration(duration: string): number {
        const match = duration.match(/^(\d+)([smhdw])$/);
        if (!match) {
            throw new Error(`Invalid duration format: ${duration}`);
        }

        const value = parseInt(match[1]);
        const unit = match[2];

        switch (unit) {
            case 's': return value * 1000;
            case 'm': return value * 60 * 1000;
            case 'h': return value * 60 * 60 * 1000;
            case 'd': return value * 24 * 60 * 60 * 1000;
            case 'w': return value * 7 * 24 * 60 * 60 * 1000;
            default: throw new Error(`Unknown duration unit: ${unit}`);
        }
    }

    private async rebuildIndexes(measurement: string): Promise<void> {
        const points = this.points.get(measurement)!;

        // Clear existing indexes
        this.tagIndex.set(measurement, new Map());
        this.timeIndex.set(measurement, new Map());

        const measurementTagIndex = this.tagIndex.get(measurement)!;
        const measurementTimeIndex = this.timeIndex.get(measurement)!;

        // Rebuild indexes
        points.forEach((point, index) => {
            // Tag index
            for (const [tagKey, tagValue] of Object.entries(point.tags)) {
                const tagMap = measurementTagIndex.get(tagKey) || new Map();
                const valueSet = tagMap.get(tagValue) || new Set();
                valueSet.add(index);
                tagMap.set(tagValue, valueSet);
                measurementTagIndex.set(tagKey, tagMap);
            }

            // Time index
            const timeBucket = Math.floor(point.timestamp.getTime() / this.bucketSize);
            const bucketPoints = measurementTimeIndex.get(timeBucket) || [];
            bucketPoints.push(index);
            measurementTimeIndex.set(timeBucket, bucketPoints);
        });
    }

    private trackLatency(duration: number): void {
        this.stats.push(duration);

        // Keep only last 1000 measurements
        if (this.stats.length > 1000) {
            this.stats.splice(0, this.stats.length - 1000);
        }
    }

    private percentile(sortedArray: number[], p: number): number {
        if (sortedArray.length === 0) return 0;
        const index = Math.ceil(sortedArray.length * p) - 1;
        return sortedArray[Math.max(0, index)] || 0;
    }
}
