{
  "name": "@codai/cli",
  "version": "1.0.0",
  "description": "Universal CLI for CODAI Ecosystem - Manage all services from one interface",
  "main": "dist/index.js",
  "bin": {
    "codai": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc --build && tsc --build tsconfig.esm.json",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "lint:fix": "pnpm exec eslint src --ext .ts,.tsx --fix",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@codai/core": "workspace:*",
    "@codai/logai-sdk": "workspace:*",
    "@codai/sdk": "workspace:*",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.7.0",
    "ora": "^8.2.0",
    "table": "^6.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.8",
    "@types/node": "^24.0.13",
    "eslint": "^9.31.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project",
    "directory": "packages/cli"
  },
  "keywords": [
    "codai",
    "cli",
    "ecosystem",
    "ai",
    "management",
    "universal",
    "orchestration",
    "enterprise"
  ],
  "author": "CODAI Team <dev@codai.ro>",
  "license": "MIT"
}
