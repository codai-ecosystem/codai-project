# ControlAI MCP Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Azure OpenAI Configuration (Required for AI features)
# =============================================================================

# Your Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-openai-instance.openai.azure.com/

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-api-key-here

# Model deployment name (optional, defaults to gpt-4o)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# =============================================================================
# Server Configuration (Optional)
# =============================================================================

# HTTP server port (optional, defaults to 6001)
CONTROLAI_PORT=6001

# Server host (optional, defaults to localhost)
CONTROLAI_HOST=localhost

# CORS origin (optional, defaults to *)
CONTROLAI_CORS_ORIGIN=*

# =============================================================================
# Database Configuration (Optional)
# =============================================================================

# Custom database path (optional, defaults to ~/.controlai-mcp/controlai.db)
# CONTROLAI_DATABASE_PATH=/path/to/your/controlai.db

# =============================================================================
# Environment-specific configurations
# =============================================================================

# For development - enables additional logging
NODE_ENV=development

# Path to additional environment configuration (optional)
# DOTENV_CONFIG_PATH=/path/to/additional/.env
