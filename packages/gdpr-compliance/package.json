{
  "name": "@codai/gdpr-compliance",
  "version": "1.0.0",
  "description": "Comprehensive GDPR compliance package for Essential CodAI Services providing data privacy controls, consent management, audit trails, and regulatory reporting.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "start": "node dist/index.js",
    "compliance:audit": "tsx src/cli.ts audit",
    "compliance:report": "tsx src/cli.ts report",
    "compliance:cleanup": "tsx src/cli.ts cleanup",
    "compliance:export": "tsx src/cli.ts export"
  },
  "keywords": [
    "gdpr",
    "compliance",
    "privacy",
    "data-protection",
    "consent-management",
    "audit-trail",
    "regulatory-reporting",
    "codai",
    "essential-services"
  ],
  "author": "CodAI Ecosystem <dev@codai.ro>",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.29.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/websocket": "^11.0.1",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "@elastic/elasticsearch": "^8.18.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "uuid": "^11.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "chokidar": "^4.0.1",
    "validator": "^13.12.0",
    "date-fns": "^4.1.0",
    "crypto": "^1.0.1",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "pdf-lib": "^1.17.1",
    "nodemailer": "^6.9.16",
    "handlebars": "^4.7.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.1",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "@types/nodemailer": "^6.4.19",
    "typescript": "^5.6.0",
    "tsx": "^4.19.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-ecosystem/codai-project.git",
    "directory": "packages/gdpr-compliance"
  },
  "bugs": {
    "url": "https://github.com/codai-ecosystem/codai-project/issues"
  },
  "homepage": "https://docs.codai.ro/compliance"
}