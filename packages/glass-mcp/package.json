{
  "name": "@codai/glass-mcp",
  "version": "8.1.0",
  "description": "Glass MCP v8.1 - AI-Powered Visual Automation Platform with Real Mouse Cursor Drawing",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "glass-mcp": "./dist/mcp-server-enhanced-drawing.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drawing": {
      "import": "./dist/drawing/index.js",
      "types": "./dist/drawing/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc src/**/*.ts --outDir dist --declaration --declarationMap --sourceMap --target ES2022 --module ESNext --lib ES2022,DOM --moduleResolution bundler --skipLibCheck --allowSyntheticDefaultImports --esModuleInterop",
    "clean": "rimraf dist",
    "dev": "tsc --build --watch",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "ai",
    "automation",
    "drawing",
    "graphics",
    "windows",
    "vision",
    "mcp",
    "glass"
  ],
  "author": "CODAI Team",
  "license": "MIT",
  "dependencies": {
    "onnxruntime-node": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.17.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "rimraf": "^6.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },

  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32"
  ]
}