{
  "name": "@codai/glass-mcp",
  "version": "11.2.5",
  "description": "Glass MCP v11.2.5 - Complete Revolutionary Windows Automation Platform with comprehensive Paint automation solutions. Features 6 consolidated tools (glass_vision, glass_drawing, glass_interact, glass_workflows, glass_system, glass_network) with 37 operations plus advanced Paint integration: precise button clicking, Bezier curve drawing, color palette management, shape tools, mathematical drawing engine, PowerShell Core integration, Win32 API control, and pixel-perfect automation. Production-ready MCP server with demonstrated Paint automation superiority.",
  "type": "module",
  "main": "dist/mcp-server.js",
  "bin": {
    "glass-mcp": "./dist/mcp-server.js"
  },
  "exports": {
    ".": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsc --build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:consolidated": "vitest run src/__tests__/consolidated-tools.test.ts",
    "start": "node dist/mcp-server.js"
  },
