{
    "name": "@memorai/cli",
    "version": "1.0.0",
    "description": "Command-line interface for MemorAI - AI memory infrastructure platform",
    "keywords": [
        "memorai",
        "cli",
        "memory",
        "ai",
        "vector",
        "search",
        "embeddings"
    ],
    "author": "MemorAI Team <team@memorai.ro>",
    "license": "MIT",
    "homepage": "https://memorai.ro",
    "repository": {
        "type": "git",
        "url": "https://github.com/codai-project/memorai.git",
        "directory": "packages/memorai-cli"
    },
    "bugs": {
        "url": "https://github.com/codai-project/memorai/issues"
    },
    "type": "module",
    "engines": {
        "node": ">=18.0.0"
    },
    "bin": {
        "memorai": "./dist/cli.js"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "CHANGELOG.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
        "dev": "tsx src/cli.ts",
        "clean": "rimraf dist",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write src/**/*.ts",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "prepublishOnly": "pnpm build",
        "local-link": "pnpm build && npm link",
        "memorai": "tsx src/cli.ts"
    },
    "dependencies": {
        "@memorai/sdk": "workspace:*",
        "commander": "^12.1.0",
        "inquirer": "^9.2.23",
        "chalk": "^5.3.0",
        "ora": "^8.1.0",
        "table": "^6.8.1",
        "json2csv": "^6.0.0-alpha.2",
        "yaml": "^2.6.0",
        "dotenv": "^16.4.7",
        "conf": "^13.0.1",
        "update-notifier": "^7.3.1"
    },
    "devDependencies": {
        "@types/inquirer": "^9.0.7",
        "@types/node": "^22.10.6",
        "@types/update-notifier": "^6.0.8",
        "@types/json2csv": "^5.0.7",
        "@typescript-eslint/eslint-plugin": "^8.21.0",
        "@typescript-eslint/parser": "^8.21.0",
        "eslint": "^9.21.0",
        "prettier": "^3.4.2",
        "rimraf": "^6.0.1",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}