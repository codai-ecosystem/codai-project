{
    "dashboard": {
        "id": null,
        "title": "MemorAI MCP Server - Production Dashboard",
        "tags": [
            "memorai",
            "mcp",
            "production"
        ],
        "style": "dark",
        "timezone": "UTC",
        "refresh": "30s",
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "System Overview",
                "type": "stat",
                "targets": [
                    {
                        "expr": "memorai_mcp:overall_health_score",
                        "legendFormat": "Health Score",
                        "refId": "A"
                    },
                    {
                        "expr": "sum(memorai_mcp:requests_per_second_5m)",
                        "legendFormat": "RPS",
                        "refId": "B"
                    },
                    {
                        "expr": "sum(memorai_mcp:memory_operations_per_second_5m)",
                        "legendFormat": "Memory Ops/sec",
                        "refId": "C"
                    },
                    {
                        "expr": "sum(memorai_mcp:active_connections)",
                        "legendFormat": "Active Connections",
                        "refId": "D"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "red",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 0.8
                                },
                                {
                                    "color": "green",
                                    "value": 0.95
                                }
                            ]
                        },
                        "unit": "percentunit"
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "HTTP Request Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "sum by (method, status) (memorai_mcp:http_request_rate_5m)",
                        "legendFormat": "{{method}} {{status}}",
                        "refId": "A"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Requests/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 3,
                "title": "Response Time Distribution",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:http_latency_95th_5m",
                        "legendFormat": "95th percentile",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:http_latency_99th_5m",
                        "legendFormat": "99th percentile",
                        "refId": "B"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Seconds",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "Memory Operations",
                "type": "graph",
                "targets": [
                    {
                        "expr": "sum by (operation) (memorai_mcp:memory_operation_rate_5m)",
                        "legendFormat": "{{operation}}",
                        "refId": "A"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Operations/sec",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                }
            },
            {
                "id": 5,
                "title": "Memory Operation Latency",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:memory_operation_latency_95th_5m",
                        "legendFormat": "95th percentile",
                        "refId": "A"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Seconds",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                }
            },
            {
                "id": 6,
                "title": "Resource Utilization",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:cpu_utilization_5m",
                        "legendFormat": "CPU",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:memory_utilization_mb / 2048",
                        "legendFormat": "Memory (normalized)",
                        "refId": "B"
                    },
                    {
                        "expr": "memorai_mcp:heap_utilization",
                        "legendFormat": "Heap",
                        "refId": "C"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Utilization",
                        "min": 0,
                        "max": 1
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 24
                }
            },
            {
                "id": 7,
                "title": "Database Performance",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:postgres_connection_utilization",
                        "legendFormat": "PostgreSQL Connections",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:postgres_query_rate_5m",
                        "legendFormat": "Query Rate",
                        "refId": "B"
                    },
                    {
                        "expr": "memorai_mcp:redis_hit_rate_5m",
                        "legendFormat": "Redis Hit Rate",
                        "refId": "C"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Rate/Utilization",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 24
                }
            },
            {
                "id": 8,
                "title": "Memory Storage Utilization",
                "type": "gauge",
                "targets": [
                    {
                        "expr": "memorai_mcp:memory_storage_utilization",
                        "legendFormat": "Storage Usage",
                        "refId": "A"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "green",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 0.7
                                },
                                {
                                    "color": "red",
                                    "value": 0.9
                                }
                            ]
                        },
                        "unit": "percentunit",
                        "min": 0,
                        "max": 1
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 0,
                    "y": 32
                }
            },
            {
                "id": 9,
                "title": "Network Performance",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:network_throughput_bytes_5m",
                        "legendFormat": "Throughput",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:network_latency_95th_5m",
                        "legendFormat": "Latency (95th)",
                        "refId": "B"
                    },
                    {
                        "expr": "memorai_mcp:network_packet_loss_rate_5m",
                        "legendFormat": "Packet Loss",
                        "refId": "C"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Bytes/Latency/Loss",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 16,
                    "x": 8,
                    "y": 32
                }
            },
            {
                "id": 10,
                "title": "Memory Network Status",
                "type": "stat",
                "targets": [
                    {
                        "expr": "memorai_mcp:memory_network_peers_active",
                        "legendFormat": "Active Peers",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:memory_replication_success_rate_5m",
                        "legendFormat": "Replication Success",
                        "refId": "B"
                    },
                    {
                        "expr": "memorai_mcp:memory_conflict_rate_5m",
                        "legendFormat": "Conflicts/sec",
                        "refId": "C"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "color": {
                            "mode": "thresholds"
                        },
                        "thresholds": {
                            "steps": [
                                {
                                    "color": "green",
                                    "value": 0
                                },
                                {
                                    "color": "yellow",
                                    "value": 0.1
                                },
                                {
                                    "color": "red",
                                    "value": 1
                                }
                            ]
                        }
                    }
                },
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 40
                }
            },
            {
                "id": 11,
                "title": "Business Metrics",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:total_memories_stored",
                        "legendFormat": "Total Memories",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:memory_creation_rate_1h",
                        "legendFormat": "Creation Rate",
                        "refId": "B"
                    },
                    {
                        "expr": "memorai_mcp:memory_retrieval_rate_1h",
                        "legendFormat": "Retrieval Rate",
                        "refId": "C"
                    }
                ],
                "yAxes": [
                    {
                        "label": "Count/Rate",
                        "min": 0
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 48
                }
            },
            {
                "id": 12,
                "title": "SLA/SLO Compliance",
                "type": "graph",
                "targets": [
                    {
                        "expr": "memorai_mcp:availability_sli_5m",
                        "legendFormat": "Availability SLI",
                        "refId": "A"
                    },
                    {
                        "expr": "memorai_mcp:latency_sli_5m",
                        "legendFormat": "Latency SLI",
                        "refId": "B"
                    },
                    {
                        "expr": "memorai_mcp:error_rate_sli_5m",
                        "legendFormat": "Error Rate SLI",
                        "refId": "C"
                    },
                    {
                        "expr": "memorai_mcp:memory_success_sli_5m",
                        "legendFormat": "Memory Ops SLI",
                        "refId": "D"
                    }
                ],
                "yAxes": [
                    {
                        "label": "SLI Score",
                        "min": 0,
                        "max": 1
                    }
                ],
                "alert": {
                    "conditions": [
                        {
                            "query": {
                                "params": [
                                    "A",
                                    "5m",
                                    "now"
                                ]
                            },
                            "reducer": {
                                "type": "avg"
                            },
                            "evaluator": {
                                "params": [
                                    0.999
                                ],
                                "type": "lt"
                            }
                        }
                    ],
                    "frequency": "10s",
                    "handler": 1,
                    "name": "MemorAI MCP SLA Breach",
                    "message": "SLA breach detected in MemorAI MCP Server",
                    "noDataState": "alerting",
                    "executionErrorState": "alerting"
                },
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 48
                }
            }
        ],
        "templating": {
            "list": [
                {
                    "name": "instance",
                    "type": "query",
                    "query": "label_values(up{job=\"memorai-mcp-server\"}, instance)",
                    "refresh": 1,
                    "multi": false,
                    "includeAll": false
                },
                {
                    "name": "time_range",
                    "type": "interval",
                    "query": "1m,5m,15m,1h,3h,6h,12h,1d",
                    "current": {
                        "text": "5m",
                        "value": "5m"
                    }
                }
            ]
        },
        "annotations": {
            "list": [
                {
                    "name": "Deployments",
                    "enable": true,
                    "iconColor": "green",
                    "query": "ALERTS{alertname=\"DeploymentStarted\"}",
                    "textFormat": "Deployment: {{instance}}"
                },
                {
                    "name": "Incidents",
                    "enable": true,
                    "iconColor": "red",
                    "query": "ALERTS{severity=\"critical\"}",
                    "textFormat": "Critical: {{alertname}}"
                }
            ]
        }
    }
}