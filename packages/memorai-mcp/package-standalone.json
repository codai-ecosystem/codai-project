{
  "name": "@memorai/mcp-server",
  "version": "1.0.1",
  "description": "MemorAI MCP Server with Microsoft-compliant SDK patterns",
  "main": "dist/src/modern-server-compliant.js",
  "bin": {
    "memorai-mcp": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/modern-server-compliant.js"
    },
    "./types": "./dist/types/index.d.ts"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/modern-server-compliant.js",
    "cli": "node dist/src/cli.js",
    "dev": "tsx src/modern-server-compliant.ts",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memorai",
    "memory",
    "search",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codai-project/memorai-mcp"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}