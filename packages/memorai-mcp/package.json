{
    "name": "@codai/memorai-mcp",
    "version": "1.0.0",
    "type": "module",
    "description": "MemorAI MCP Server - 2025 Standards Compliant Memory Management",
    "main": "build/server.js",
    "bin": {
        "memorai-mcp": "build/server.js"
    },
    "files": [
        "build/**/*",
        "src/**/*",
        "package.json",
        "README.md"
    ],
    "exports": {
        ".": "./build/server.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc && chmod +x build/server.js",
        "dev": "tsx src/server.ts",
        "start": "node build/server.js",
        "start:stdio": "tsx src/server.ts",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage --reporter=verbose",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.17.0",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "^2.1.1",
        "@vitest/ui": "^2.1.1",
        "playwright": "^1.48.0",
        "supertest": "^7.1.4",
        "tsx": "^4.7.1",
        "typescript": "^5.8.3",
        "vitest": "^2.1.1"
    },
    "keywords": [
        "mcp",
        "memory",
        "ai",
        "model-context-protocol",
        "microsoft-compliant"
    ],
    "author": "CODAI Team",
    "license": "MIT"
}