{
    "name": "@codai/memorai-mcp",
    "version": "9.9.0-microsoft-compliant",
    "type": "module",
    "description": "MemorAI MCP Server - Microsoft-Compliant Implementation following official documentation patterns",
    "main": "dist/src/modern-server-compliant.js",
    "bin": {
        "memorai-mcp": "dist/src/modern-server-compliant.js"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "package.json",
        "README.md"
    ],
    "exports": {
        ".": "./dist/src/modern-server-compliant.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsx src/modern-server-compliant.ts",
        "start": "node dist/src/modern-server-compliant.js",
        "start:stdio": "tsx src/modern-server-compliant.ts --stdio",
        "health": "curl http://localhost:4950/health",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage --reporter=verbose",
        "test:e2e": "playwright test src/e2e",
        "test:all": "npm test && npm run test:e2e",
        "playwright:install": "playwright install",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.17.0",
        "@types/supertest": "^6.0.2",
        "@vitest/coverage-v8": "^2.1.1",
        "@vitest/ui": "^2.1.1", 
        "playwright": "^1.48.0",
        "supertest": "^7.0.0",
        "tsx": "^4.7.1",
        "typescript": "^5.8.3",
        "vitest": "^2.1.1"
    },
    "keywords": [
        "mcp",
        "memory",
        "ai",
        "model-context-protocol",
        "microsoft-compliant"
    ],
    "author": "CODAI Team",
    "license": "MIT"
}