{
    "name": "@memorai/sdk",
    "version": "1.0.0",
    "description": "Official TypeScript SDK for MemorAI - AI Memory Infrastructure Platform",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "build:watch": "tsc --watch",
        "start": "node dist/index.js",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepack": "pnpm build",
        "prepublishOnly": "pnpm test && pnpm build"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "eventemitter3": "^5.0.1",
        "jsonwebtoken": "^9.0.2",
        "uuid": "^10.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.8.6",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.5.13",
        "@typescript-eslint/eslint-plugin": "^8.18.1",
        "@typescript-eslint/parser": "^8.18.1",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.17.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "keywords": [
        "memorai",
        "sdk",
        "typescript",
        "ai",
        "memory",
        "vector-database",
        "embedding",
        "semantic-search",
        "context-preservation",
        "agent-memory"
    ],
    "author": "CODAI Ecosystem",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/codai-ecosystem/codai-project.git",
        "directory": "packages/memorai-sdk"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "bugs": {
        "url": "https://github.com/codai-ecosystem/codai-project/issues"
    },
    "homepage": "https://memorai.ro"
}
