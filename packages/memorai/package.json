{
  "name": "@codai/memorai",
  "version": "8.0.2",
  "type": "module",
  "description": "Universal Database & Storage Service for CODAI Ecosystem - CBD Backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "memorai-api": "dist/cli/api-server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./database": {
      "import": "./dist/database.mjs",
      "require": "./dist/database.js"
    },
    "./storage": {
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js"
    },
    "./memory": {
      "import": "./dist/memory.mjs",
      "require": "./dist/memory.js"
    },
    "./sync": {
      "import": "./dist/sync.mjs",
      "require": "./dist/sync.js"
    },
    "./api": {
      "import": "./dist/api.mjs",
      "require": "./dist/api.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc --build && tsc --build tsconfig.esm.json",
    "dev": "tsc --build --watch",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "type-check": "pnpm exec tsc --noEmit",
    "migrate": "tsx ../../apps/memorai/migrate-to-cbd.ts",
    "mcp:cbd": "tsx ../../apps/memorai/cbd-mcp-server.ts",
    "emergency:recovery": "node ../../apps/memorai/emergency-recovery.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codai/core": "^1.1.1",
    "@codai/shared-types": "^1.0.0",
    "@codai/cbd": "^1.0.7",
    "@modelcontextprotocol/sdk": "^0.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "fuse.js": "^7.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.31.0",
    "jest": "^30.0.4",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "next": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codai",
    "database",
    "storage",
    "memory",
    "vector-db",
    "file-storage",
    "blob-storage",
    "real-time",
    "sync",
    "typescript"
  ],
  "author": "CODAI Team",
  "license": "MIT"
}