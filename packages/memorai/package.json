{
  "name": "@codai/memorai",
  "version": "1.0.0",
  "type": "module",
  "description": "Universal Database & Storage Service for CODAI Ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "memorai-api": "dist/cli/api-server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./database": {
      "import": "./dist/database.mjs",
      "require": "./dist/database.js"
    },
    "./storage": {
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js"
    },
    "./memory": {
      "import": "./dist/memory.mjs",
      "require": "./dist/memory.js"
    },
    "./sync": {
      "import": "./dist/sync.mjs",
      "require": "./dist/sync.js"
    },
    "./api": {
      "import": "./dist/api.mjs",
      "require": "./dist/api.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc --build && tsc --build tsconfig.esm.json",
    "dev": "tsc --build --watch",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "test": "jest",
    "type-check": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@codai/core": "workspace:*",
    "@codai/shared-types": "workspace:*",
    "@prisma/client": "^6.12.0",
    "@supabase/supabase-js": "^2.48.1",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "fuse.js": "^7.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.13",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.31.0",
    "jest": "^30.0.4",
    "prisma": "^6.12.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "next": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codai",
    "database",
    "storage",
    "memory",
    "vector-db",
    "file-storage",
    "blob-storage",
    "real-time",
    "sync",
    "typescript"
  ],
  "author": "CODAI Team",
  "license": "MIT"
}