{
  "name": "@codai/monitoring",
  "version": "1.0.0",
  "description": "Comprehensive monitoring and observability system for MemorAI platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./monitoring": {
      "import": "./dist/MonitoringSystem.mjs",
      "require": "./dist/MonitoringSystem.js",
      "types": "./dist/MonitoringSystem.d.ts"
    },
    "./health": {
      "import": "./dist/HealthChecker.mjs",
      "require": "./dist/HealthChecker.js",
      "types": "./dist/HealthChecker.d.ts"
    },
    "./alerts": {
      "import": "./dist/AlertManager.mjs",
      "require": "./dist/AlertManager.js",
      "types": "./dist/AlertManager.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "systeminformation": "^5.21.20",
    "prom-client": "^15.1.0",
    "nodemailer": "^6.9.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "monitoring",
    "observability",
    "logging",
    "alerts",
    "health-checks",
    "metrics",
    "performance",
    "memorai",
    "production"
  ],
  "author": "MemorAI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/memorai/codai-project.git",
    "directory": "packages/monitoring"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}