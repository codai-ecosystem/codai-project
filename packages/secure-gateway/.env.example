# Secure API Gateway - Environment Configuration

## Required Environment Variables

# Gateway Configuration
PORT=3000
NODE_ENV=production

# JWT Secret (MUST be changed in production)
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=https://codai.ro,https://api.codai.ro,https://admin.codai.ro,https://apps.codai.ro,https://docs.codai.ro

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/var/log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# Service Discovery
ECS_CLUSTER_NAME=codai-cluster-prod
SERVICE_DISCOVERY_NAMESPACE=codai-cluster-prod.local

# Database Configuration (if needed)
DATABASE_URL=postgresql://user:password@localhost:5432/codai_gateway

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

## Production Deployment Values

# JWT Secret (generated securely)
JWT_SECRET=codai_prod_jwt_Kj8m9nP2qR4sT6vW8xZ0bC3eF5gH7jL9nQ2sU4wY6zA8cE0gI2kM

