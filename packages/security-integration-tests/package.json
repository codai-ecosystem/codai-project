{
  "name": "@codai/security-integration-tests",
  "version": "1.0.0",
  "description": "Comprehensive security integration testing suite for Essential CodAI Services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:security": "tsx src/cli.ts run-all-tests",
    "test:rate-limiting": "tsx src/cli.ts test rate-limiting",
    "test:threat-detection": "tsx src/cli.ts test threat-detection",
    "test:vulnerability-scan": "tsx src/cli.ts test vulnerability-scan",
    "test:security-headers": "tsx src/cli.ts test security-headers",
    "test:input-sanitization": "tsx src/cli.ts test input-sanitization",
    "test:performance-impact": "tsx src/cli.ts test performance-impact",
    "generate-report": "tsx src/cli.ts generate-report",
    "setup": "tsx src/cli.ts setup",
    "monitor": "tsx src/cli.ts monitor",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "security",
    "testing",
    "integration",
    "codai",
    "penetration-testing",
    "vulnerability-assessment",
    "security-validation"
  ],
  "author": "CodAI Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fastify": "^4.29.1",
    "winston": "^3.15.0",
    "@elastic/elasticsearch": "^8.18.1",
    "uuid": "^11.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "validator": "^13.12.0",
    "sanitize-html": "^2.13.1",
    "xss": "^1.0.15",
    "puppeteer": "^23.11.1",
    "ws": "^8.18.0",
    "node-cron": "^3.0.3",
    "cheerio": "^1.0.0",
    "performance-now": "^2.1.0",
    "loadtest": "^8.0.9",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/jest": "^29.5.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/validator": "^13.12.2",
    "@types/sanitize-html": "^2.13.0",
    "@types/ws": "^8.5.13",
    "@types/puppeteer": "^5.4.7",
    "@types/cheerio": "^0.22.35",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "prettier": "^3.4.2",
    "@types/eslint": "^9.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}