{
    "name": "@codai/security",
    "version": "1.0.0",
    "description": "Enterprise-grade security middleware for CODAI ecosystem",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.4",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4",
        "eslint": "^8.55.0",
        "rimraf": "^5.0.5"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "keywords": [
        "security",
        "tls",
        "waf",
        "https",
        "codai",
        "middleware",
        "express"
    ],
    "author": "CODAI Team",
    "license": "MIT"
}