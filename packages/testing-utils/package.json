{
  "name": "@codai/testing-utils",
  "version": "1.0.0",
  "description": "Testing utilities and configurations for CODAI ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "configs"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "tsc --watch",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "lint:fix": "pnpm exec eslint src --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.6.0",
    "vitest": "^3.2.4",
    "playwright": "^1.54.1",
    "@playwright/test": "^1.54.1",
    "happy-dom": "^15.1.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.3",
    "mock-fs": "^5.4.0",
    "nock": "^13.5.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "@types/mock-fs": "^4.13.4",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
