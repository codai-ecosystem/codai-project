{
  "name": "@codai/monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "react": "^19.1.1",
      "react-dom": "^19.1.1",
      "@types/react": "^19.1.9",
      "@types/react-dom": "^19.1.7",
      "jest": "^30.0.4",
      "tailwindcss": "^3.4.17",
      "vitest": "^3.2.4",
      "@vitest/ui": "^3.2.4",
      "@vitest/coverage-v8": "^3.2.4",
      "use-sync-external-store": "^1.2.0",
      "dmg-builder": "^26.0.12",
      "electron-builder-squirrel-windows": "^26.0.12",
      "app-builder-lib": "^26.0.12",
      "tough-cookie@<4.1.3": ">=4.1.3",
      "undici@>=4.5.0 <5.28.5": ">=5.28.5",
      "path-to-regexp@>=4.0.0 <6.3.0": ">=6.3.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "undici@<5.29.0": ">=5.29.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "jest",
        "tailwindcss",
        "vitest",
        "@vitest/ui",
        "@vitest/coverage-v8"
      ],
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "jest": "30",
        "tailwindcss": "3",
        "vitest": "3",
        "@vitest/ui": "3",
        "@vitest/coverage-v8": "3"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit-tests",
    "test:integration": "vitest run --project integration-tests",
    "test:api": "vitest run --config tests/integration/vitest.config.ts tests/integration/api-integration.test.ts",
    "test:database": "vitest run --config tests/integration/vitest.config.ts tests/integration/database-integration.test.ts",
    "test:cross-app": "vitest run --config tests/integration/vitest.config.ts tests/integration/cross-application-integration.test.ts",
    "test:e2e:comprehensive": "playwright test tests/e2e/comprehensive-e2e.spec.ts",
    "test:e2e:workflows": "playwright test tests/e2e/user-workflows.spec.ts",
    "test:e2e:components": "playwright test tests/e2e/component-tests.spec.ts",
    "test:e2e:api": "playwright test tests/e2e/api-workflows.spec.ts",
    "test:gateway": "pnpm run test:gateway:unit && pnpm run test:gateway:integration && pnpm run test:gateway:e2e",
    "test:gateway:unit": "vitest run tests/unit/gateway-service.test.ts",
    "test:gateway:integration": "vitest run tests/integration/gateway-service.test.ts",
    "test:gateway:e2e": "playwright test tests/e2e/gateway-service.spec.ts",
    "test:gateway:performance": "playwright test tests/performance/gateway-service.test.ts",
    "test:gateway:security": "playwright test tests/security/gateway-service.test.ts",
    "test:codai": "pnpm run test:codai:unit && pnpm run test:codai:integration && pnpm run test:codai:e2e",
    "test:codai:unit": "vitest run tests/unit/codai-service.test.ts",
    "test:codai:integration": "vitest run tests/integration/codai-service.test.ts",
    "test:codai:e2e": "playwright test tests/e2e/codai-service.spec.ts",
    "test:codai:performance": "playwright test tests/performance/codai-service.test.ts",
    "test:codai:security": "playwright test tests/security/codai-service.test.ts",
    "test:admin": "pnpm run test:admin:unit && pnpm run test:admin:integration && pnpm run test:admin:e2e",
    "test:admin:unit": "vitest run tests/unit/admin-service.test.ts",
    "test:admin:integration": "vitest run tests/integration/admin-service.test.ts",
    "test:admin:e2e": "playwright test tests/e2e/admin-service.spec.ts",
    "test:admin:performance": "playwright test tests/performance/admin-service.test.ts",
    "test:admin:security": "playwright test tests/security/admin-service.test.ts",
    "test:hub": "pnpm run test:hub:integration",
    "test:hub:integration": "vitest run tests/integration/hub-service.test.ts",
    "test:id": "pnpm run test:id:integration",
    "test:id:integration": "vitest run tests/integration/id-service.test.ts",
    "test:bancai": "pnpm run test:bancai:integration",
    "test:bancai:integration": "vitest run tests/integration/bancai-service.test.ts",
    "test:memorai": "pnpm run test:memorai:integration",
    "test:memorai:integration": "vitest run tests/integration/memorai-service.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:debug": "vitest run --reporter=verbose",
    "test:quick": "vitest run tests/unit-components.test.ts --reporter=basic",
    "test:comprehensive": "node run-comprehensive-tests.js",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:storybook": "test-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=${CHROMATIC_PROJECT_TOKEN}",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "cypress:run:edge": "cypress run --browser edge",
    "test:k6": "k6 run tests/k6/gateway-load-test.js",
    "test:artillery": "artillery run tests/artillery/gateway-performance.yml",
    "test:load": "pnpm run test:k6 && pnpm run test:artillery",
    "test:jest": "jest",
    "test:vitest": "vitest",
    "test:all": "pnpm run test:jest && pnpm run test:vitest && pnpm run test:playwright && pnpm run test:cypress",
    "test:services": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:ui": "pnpm run test:storybook && pnpm run test:cypress:open",
    "storybook:build": "storybook build",
    "storybook:deploy": "chromatic --project-token=PROJECT_TOKEN",
    "dev": "node scripts/dev-helper.js",
    "dev:all": "turbo dev --concurrency=10",
    "dev:admin": "turbo dev --filter=admin",
    "dev:hub": "turbo dev --filter=hub",
    "dev:id": "turbo dev --filter=id",
    "dev:admin-ecosystem": "turbo dev --filter=admin --filter=hub --filter=id",
    "build": "turbo build --concurrency=20",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run test:coverage",
    "security:audit": "pnpm audit",
    "security:scan": "npm audit --audit-level high",
    "deps:update": "pnpm update --interactive",
    "deps:outdated": "pnpm outdated",
    "ports:check": "node scripts/enforce-port-policy.js",
    "ports:fix": "node scripts/enforce-port-policy.js --fix",
    "orchestrator": "node scripts/orchestrator-cli.js",
    "orchestrator:interactive": "node scripts/orchestrator-cli.js interactive",
    "orchestrator:status": "node scripts/orchestrator-cli.js status",
    "orchestrator:list": "node scripts/orchestrator-cli.js list",
    "orchestrator:examples": "node scripts/orchestrator-examples.js",
    "start:service": "node scripts/orchestrator-cli.js start",
    "dev:primary": "turbo dev --filter=@codai/gateway --filter=codai --filter=admin --filter=hub --filter=id --filter=bancai --filter=memorai --filter=@codai/cbd",
    "build:primary": "turbo build --filter=@codai/gateway --filter=codai --filter=admin --filter=hub --filter=id --filter=bancai --filter=memorai --filter=@codai/cbd",
    "dev:services": "turbo dev --filter=@codai/gateway --filter=codai --filter=admin --filter=hub --filter=id --filter=bancai --filter=memorai --filter=@codai/cbd",
    "dev:metu": "pnpm --filter=metu dev:full",
    "dev:metu:backend": "pnpm --filter=metu server:dev",
    "dev:metu:web": "pnpm --filter=metu dev:web",
    "dev:metu:electron": "pnpm --filter=metu dev:electron",
    "build:check": "turbo build --dry-run",
    "build:force": "turbo build --force",
    "lint:check": "turbo lint --no-fix",
    "type-check:primary": "turbo type-check --filter=codai --filter=admin --filter=hub --filter=id --filter=bancai --filter=memorai",
    "clean:cache": "turbo clean && rm -rf .turbo",
    "validate:primary": "pnpm run type-check:primary && pnpm run build:primary",
    "health-check": "node scripts/health-check.js",
    "deploy:check": "pnpm run validate && pnpm run build",
    "deploy:primary": "pnpm run validate:primary && echo 'Primary apps ready for deployment!'",
    "orchestrator:enhanced": "node scripts/dev-orchestrator-enhanced.js",
    "orchestrator:enhanced:start": "node scripts/dev-orchestrator-enhanced.js start",
    "orchestrator:enhanced:status": "node scripts/dev-orchestrator-enhanced.js status",
    "test:comprehensive:full": "node scripts/comprehensive-test-runner.js run",
    "dev:orchestrated": "node scripts/dev-orchestrator-enhanced.js start",
    "test:with-services": "node scripts/comprehensive-test-runner.js run"
  },
