{
  "name": "@codai/mobile-template",
  "version": "1.0.0",
  "description": "Modern Expo template for CODAI ecosystem mobile applications",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "pnpm exec eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "rimraf .expo dist coverage"
  },
  "dependencies": {
    "@codai/core": "workspace:*",
    "@codai/sdk": "workspace:*",
    "@codai/ui": "workspace:*",
    "@codai/logai-sdk": "workspace:*",
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/bottom-tabs": "^7.1.0",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/stack": "^7.1.1",
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-font": "~13.0.1",
    "expo-linear-gradient": "~14.0.1",
    "expo-blur": "~14.0.1",
    "expo-haptics": "~14.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-notifications": "~0.30.0",
    "nativewind": "^2.0.11",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-reanimated": "~3.16.1",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.2.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-safe-area-context"
      ]
    }
  }
}