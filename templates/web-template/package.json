{
    "name": "@codai/web-template",
    "version": "1.0.0",
    "description": "Modern Next.js 15 template for CODAI ecosystem web applications",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "test:e2e": "playwright test",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "clean": "rimraf .next dist coverage test-results"
    },
    "dependencies": {
        "@codai/core": "workspace:*",
        "@codai/sdk": "workspace:*",
        "@codai/ui": "workspace:*",
        "@codai/logai-sdk": "workspace:*",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.2.4",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-toast": "^1.2.14",
        "@radix-ui/react-tooltip": "^1.2.7",
        "clsx": "^2.1.1",
        "framer-motion": "^11.15.0",
        "lucide-react": "^0.298.0",
        "next": "^15.1.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwind-merge": "^2.5.4",
        "tailwindcss-animate": "^1.0.7",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^15.1.0",
        "@playwright/test": "^1.49.1",
        "@types/node": "^22.10.2",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@typescript-eslint/eslint-plugin": "^8.18.1",
        "@typescript-eslint/parser": "^8.18.1",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^2.1.8",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "postcss": "^8.5.6",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "rimraf": "^6.0.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vitest": "^2.1.8"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}