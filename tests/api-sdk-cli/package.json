{
    "name": "@codai/api-sdk-cli-tests",
    "version": "1.0.0",
    "description": "Comprehensive SDK, CLI, and API testing suite for CODAI ecosystem",
    "type": "module",
    "scripts": {
        "test": "playwright test",
        "test:sdk": "playwright test --grep \"SDK\"",
        "test:cli": "playwright test --grep \"CLI\"",
        "test:api": "playwright test --grep \"API\"",
        "test:load": "playwright test --grep \"Load Test\"",
        "test:security": "playwright test --grep \"Security\"",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "report": "playwright show-report",
        "install": "playwright install",
        "build:samples": "node scripts/build-sample-apps.js",
        "setup:cli": "node scripts/setup-cli-tools.js"
    },
    "dependencies": {
        "@playwright/test": "^1.40.1",
        "axios": "^1.6.2",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "node-fetch": "^3.3.2",
        "ws": "^8.14.2",
        "yaml": "^2.3.4"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.10.4",
        "@types/ws": "^8.5.10",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "codai",
        "sdk",
        "cli",
        "api",
        "testing",
        "rest",
        "graphql",
        "load-testing",
        "security"
    ]
}