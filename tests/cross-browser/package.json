{
    "name": "phase8-cross-browser-testing",
    "version": "1.0.0",
    "description": "Phase 8 Cross-browser and Device Testing Validation",
    "scripts": {
        "test": "playwright test",
        "test:chrome": "playwright test --project=chromium",
        "test:firefox": "playwright test --project=firefox",
        "test:safari": "playwright test --project=webkit",
        "test:mobile": "playwright test --grep mobile",
        "test:tablet": "playwright test --grep tablet",
        "test:desktop": "playwright test --grep desktop",
        "test:responsive": "playwright test --grep responsive"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2"
    }
}