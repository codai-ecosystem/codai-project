{
    "name": "@codai/integration-tests",
    "version": "1.0.0",
    "description": "Comprehensive integration testing suite for CODAI ecosystem",
    "private": true,
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "test:ui": "playwright test --ui",
        "test:chromium": "playwright test --project=chromium",
        "test:firefox": "playwright test --project=firefox",
        "test:webkit": "playwright test --project=webkit",
        "test:edge": "playwright test --project=edge",
        "test:e2e": "playwright test --project=e2e-testing",
        "test:load": "playwright test --project=load-testing",
        "test:resilience": "playwright test --project=resilience-testing",
        "test:deployment": "playwright test --project=deployment-testing",
        "report": "playwright show-report",
        "report:open": "start playwright-report/index.html"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2",
        "@types/node": "^20.10.5",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "ws": "^8.14.2",
        "form-data": "^4.0.0",
        "jsonwebtoken": "^9.0.2",
        "yaml": "^2.3.4",
        "express": "^4.18.2",
        "multer": "^1.4.5-lts.1",
        "socket.io-client": "^4.7.4",
        "puppeteer": "^21.6.1",
        "sharp": "^0.33.1",
        "cheerio": "^1.0.0-rc.12"
    },
    "keywords": [
        "integration-testing",
        "playwright",
        "codai",
        "ecosystem",
        "end-to-end",
        "system-testing",
        "service-communication",
        "load-testing",
        "resilience-testing"
    ]
}