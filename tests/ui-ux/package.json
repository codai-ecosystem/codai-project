{
    "name": "phase9-ui-ux-testing",
    "version": "1.0.0",
    "description": "Phase 9: UI/UX Testing Validation for CODAI Project",
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --grep=\"UI Testing\"",
        "test:ux": "playwright test --grep=\"UX Testing\"",
        "test:visual": "playwright test --grep=\"Visual Regression\"",
