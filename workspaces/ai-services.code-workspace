{
    "folders": [
        {
            "name": "AI Services",
            "path": "../apps/aide"
        },
        {
            "name": "AI API",
            "path": "../apps/aide-api"
        },
        {
            "name": "AI CLI",
            "path": "../apps/aide-cli"
        },
        {
            "name": "AI Native",
            "path": "../apps/aide-native"
        },
        {
            "name": "Romai",
            "path": "../apps/romai"
        },
        {
            "name": "Memorai",
            "path": "../apps/memorai"
        }
    ],
    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true,
            "**/target": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true,
            "**/target": true
        },
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#7C3AED",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#7C3AED",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "ms-python.python",
            "ms-toolsai.jupyter",
            "rust-lang.rust-analyzer",
            "humao.rest-client",
            "ms-vscode.vscode-json"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start All AI Services",
                "dependsOrder": "parallel",
                "dependsOn": [
                    "Start AIDE",
                    "Start AIDE API",
                    "Start AIDE CLI",
                    "Start Romai",
                    "Start Memorai"
                ],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                }
            },
            {
                "label": "Start AIDE",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:AI Services}"
                },
                "env": {
                    "PORT": "4020"
                }
            },
            {
                "label": "Start AIDE API",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:AI API}"
                },
                "env": {
                    "PORT": "4021"
                }
            },
            {
                "label": "Start AIDE CLI",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:AI CLI}"
                },
                "env": {
                    "PORT": "4022"
                }
            },
            {
                "label": "Start Romai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Romai}"
                },
                "env": {
                    "PORT": "4030"
                }
            },
            {
                "label": "Start Memorai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Memorai}"
                },
                "env": {
                    "PORT": "4040"
                }
            },
            {
                "label": "Test AI Services",
                "type": "shell",
                "command": "pnpm test",
                "group": "test"
            },
            {
                "label": "Build AI Services",
                "type": "shell",
                "command": "pnpm build",
                "group": "build"
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug AIDE API",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:AI API}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4021"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            },
            {
                "name": "Debug Romai",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Romai}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4030"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            }
        ]
    }
}
