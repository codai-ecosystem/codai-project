{
    "folders": [
        {
            "name": "Business Apps",
            "path": "../apps/sociai"
        },
        {
            "name": "Conversai",
            "path": "../apps/conversai"
        },
        {
            "name": "Publicai",
            "path": "../apps/publicai"
        },
        {
            "name": "Promovai",
            "path": "../apps/promovai"
        },
        {
            "name": "Marketai",
            "path": "../apps/marketai"
        },
        {
            "name": "Talentai",
            "path": "../apps/talentai"
        },
        {
            "name": "Admin",
            "path": "../apps/admin"
        },
        {
            "name": "Hub",
            "path": "../apps/hub"
        }
    ],
    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true
        },
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#3B82F6",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#3B82F6",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "ms-playwright.playwright",
            "vitest.explorer",
            "humao.rest-client",
            "ms-vscode.vscode-json"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start All Business Services",
                "dependsOrder": "parallel",
                "dependsOn": [
                    "Start Sociai",
                    "Start Conversai", 
                    "Start Publicai",
                    "Start Promovai",
                    "Start Marketai",
                    "Start Talentai",
                    "Start Admin",
                    "Start Hub"
                ],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                }
            },
            {
                "label": "Start Sociai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Business Apps}",
                    "env": {
                        "PORT": "4070"
                    }
                }
            },
            {
                "label": "Start Conversai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Conversai}",
                    "env": {
                        "PORT": "4071"
                    }
                }
            },
            {
                "label": "Start Publicai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Publicai}",
                    "env": {
                        "PORT": "4072"
                    }
                }
            },
            {
                "label": "Start Promovai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Promovai}",
                    "env": {
                        "PORT": "4073"
                    }
                }
            },
            {
                "label": "Start Marketai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Marketai}",
                    "env": {
                        "PORT": "4074"
                    }
                }
            },
            {
                "label": "Start Talentai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Talentai}",
                    "env": {
                        "PORT": "4075"
                    }
                }
            },
            {
                "label": "Start Admin",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Admin}",
                    "env": {
                        "PORT": "4080"
                    }
                }
            },
            {
                "label": "Start Hub",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Hub}",
                    "env": {
                        "PORT": "4090"
                    }
                }
            },
            {
                "label": "Build Business Services",
                "type": "shell",
                "command": "pnpm build",
                "group": "build"
            },
            {
                "label": "Test Business Services",
                "type": "shell",
                "command": "pnpm test",
                "group": "test"
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Admin",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Admin}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4080"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            },
            {
                "name": "Debug Hub",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Hub}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4090"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            }
        ]
    }
}
