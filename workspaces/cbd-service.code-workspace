{
    "folders": [
        {
            "name": "CBD Service",
            "path": "../packages/cbd"
        },
        {
            "name": "CBD Data",
            "path": "../cbd-data"
        },
        {
            "name": "Memorai CBD Data",
            "path": "../memorai-cbd-data"
        },
        {
            "name": "Root Config",
            "path": "../"
        }
    ],
    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/target": true,
            "**/.turbo": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/target": true,
            "**/.turbo": true
        },
        "terminal.integrated.cwd": "${workspaceFolder:CBD Service}",
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#8B5CF6",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#8B5CF6",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "rust-lang.rust-analyzer",
            "vadimcn.vscode-lldb",
            "humao.rest-client",
            "ms-vscode.vscode-json"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start CBD Service",
                "type": "shell",
                "command": "npm run service",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}",
                    "env": {
                        "CBD_PORT": "4180",
                        "CBD_HOST": "localhost"
                    }
                },
                "runOptions": {
                    "instanceLimit": 1
                }
            },
            {
                "label": "Build CBD TypeScript",
                "type": "shell",
                "command": "pnpm build:ts",
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}"
                }
            },
            {
                "label": "Build CBD Rust",
                "type": "shell",
                "command": "pnpm build:rust",
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}"
                }
            },
            {
                "label": "Build CBD Full",
                "type": "shell",
                "command": "pnpm build",
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}"
                }
            },
            {
                "label": "Test CBD",
                "type": "shell",
                "command": "pnpm test",
                "group": "test",
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}"
                }
            },
            {
                "label": "Test CBD Rust",
                "type": "shell",
                "command": "pnpm test:rust",
                "group": "test",
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}"
                }
            },
            {
                "label": "Benchmark CBD",
                "type": "shell",
                "command": "pnpm bench:rust",
                "group": "test",
                "options": {
                    "cwd": "${workspaceFolder:CBD Service}"
                }
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug CBD Service",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:CBD Service}/bin/cbd-service.js",
                "env": {
                    "NODE_ENV": "development",
                    "CBD_PORT": "4180",
                    "CBD_HOST": "localhost"
                },
                "skipFiles": ["<node_internals>/**"]
            },
            {
                "name": "(lldb) CBD Rust Debug",
                "type": "lldb",
                "request": "launch",
                "program": "${workspaceFolder:CBD Service}/rust/target/debug/cbd-engine",
                "args": [],
                "cwd": "${workspaceFolder:CBD Service}/rust"
            }
        ]
    }
}
