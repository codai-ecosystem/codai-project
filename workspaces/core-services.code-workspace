{
    "folders": [
        {
            "name": "Gateway Service",
            "path": "../apps/gateway"
        },
        {
            "name": "CODAI Service",
            "path": "../apps/codai"
        },
        {
            "name": "Admin Service", 
            "path": "../apps/admin"
        },
        {
            "name": "Hub Service",
            "path": "../apps/hub"
        },
        {
            "name": "ID Service",
            "path": "../apps/id"
        },
        {
            "name": "Root Config",
            "path": "../"
        }
    ],
    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.turbo": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.turbo": true
        },
        "terminal.integrated.cwd": "${workspaceFolder:Gateway Service}",
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#1b10b9",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#1021b9",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "ms-vscode.vscode-json",
            "redhat.vscode-yaml",
            "humao.rest-client"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start Gateway",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Gateway Service}",
                    "env": {
                        "GATEWAY_PORT": "4000"
                    }
                },
                "runOptions": {
                    "instanceLimit": 1
                }
            },
            {
                "label": "Start CODAI Service",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:CODAI Service}",
                    "env": {
                        "PORT": "4001"
                    }
                },
                "runOptions": {
                    "instanceLimit": 1
                }
            },
            {
                "label": "Start Admin Service",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Admin Service}",
                    "env": {
                        "PORT": "4002"
                    }
                },
                "runOptions": {
                    "instanceLimit": 1
                }
            },
            {
                "label": "Start All Core Services",
                "dependsOrder": "parallel",
                "dependsOn": [
                    "Start Gateway",
                    "Start CODAI Service",
                    "Start Admin Service"
                ],
                "group": "build"
            },
            {
                "label": "Build All Services",
                "type": "shell",
                "command": "pnpm build",
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder:Root Config}"
                }
            },
            {
                "label": "Test Gateway",
                "type": "shell",
                "command": "pnpm test",
                "group": "test",
                "options": {
                    "cwd": "${workspaceFolder:Gateway Service}"
                }
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Gateway",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Gateway Service}/src/api-gateway.ts",
                "outFiles": ["${workspaceFolder:Gateway Service}/dist/**/*.js"],
                "env": {
                    "NODE_ENV": "development",
                    "GATEWAY_PORT": "4000"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            }
        ]
    }
}
