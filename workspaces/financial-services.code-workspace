{
    "folders": [
        {
            "name": "Financial Services",
            "path": "../apps/bancai"
        },
        {
            "name": "Shopping AI",
            "path": "../apps/cumparai"
        },
        {
            "name": "Wallet Service",
            "path": "../apps/wallet"
        },
        {
            "name": "Market AI",
            "path": "../apps/marketai"
        },
        {
            "name": "Root Config",
            "path": "../"
        }
    ],
    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.turbo": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.turbo": true
        },
        "terminal.integrated.cwd": "${workspaceFolder:Financial Services}",
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#F59E0B",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#F59E0B",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "ms-vscode.vscode-json",
            "humao.rest-client"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start Bancai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Financial Services}",
                    "env": {
                        "PORT": "4005"
                    }
                }
            },
            {
                "label": "Start Cumparai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Shopping AI}",
                    "env": {
                        "PORT": "4006"
                    }
                }
            },
            {
                "label": "Start All Financial Services",
                "dependsOrder": "parallel",
                "dependsOn": [
                    "Start Bancai",
                    "Start Cumparai"
                ],
                "group": "build"
            }
        ]
    }
}
