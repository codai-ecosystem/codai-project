    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Studiai",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Studiai}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4212"
