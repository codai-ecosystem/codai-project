    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true
        },
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#EA580C",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#EA580C",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "ms-playwright.playwright",
            "vitest.explorer",
            "humao.rest-client",
            "ms-vscode.vscode-json"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start All Lifestyle Services",
                "dependsOrder": "parallel",
                "dependsOn": [
                    "Start Acasai",
                    "Start Ajutai",
                    "Start Curtai",
                    "Start Donai",
                    "Start Fabricai",
                    "Start Jucai",
                    "Start Legalizai",
                    "Start Logai",
                    "Start Muzicai",
                    "Start Prezentai",
                    "Start Studiai",
                    "Start Sunai"
                ],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                }
            },
            {
                "label": "Start Acasai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Acasai}",
                    "env": {
                        "PORT": "4200"
                    }
