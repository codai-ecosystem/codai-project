{
    "folders": [
        {
            "name": "Stocai",
            "path": "../apps/stocai"
        },
        {
            "name": "Dexai",
            "path": "../apps/dexai"
        },
        {
            "name": "X Platform",
            "path": "../apps/x"
        },
        {
            "name": "Dash",
            "path": "../apps/dash"
        },
        {
            "name": "Wallet",
            "path": "../apps/wallet"
        },
        {
            "name": "Identity",
            "path": "../apps/id"
        },
        {
            "name": "Metu",
            "path": "../apps/metu"
        },
        {
            "name": "Metu Web",
            "path": "../apps/metu-web"
        },
        {
            "name": "Mod",
            "path": "../apps/mod"
        }
    ],
    "settings": {
        "typescript.preferences.includePackageJsonAutoImports": "on",
        "typescript.suggest.autoImports": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true,
            "**/target": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/dist": true,
            "**/.next": true,
            "**/.turbo": true,
            "**/target": true
        },
        "workbench.colorCustomizations": {
            "titleBar.activeBackground": "#B91C1C",
            "titleBar.activeForeground": "#FFFFFF",
            "statusBar.background": "#B91C1C",
            "statusBar.foreground": "#FFFFFF"
        }
    },
    "extensions": {
        "recommendations": [
            "esbenp.prettier-vscode",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-typescript-next",
            "dbaeumer.vscode-eslint",
            "christian-kohler.path-intellisense",
            "ms-playwright.playwright",
            "vitest.explorer",
            "rust-lang.rust-analyzer",
            "humao.rest-client",
            "ms-vscode.vscode-json",
            "ms-python.python",
            "ms-vscode.cpptools"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start All Platform Services",
                "dependsOrder": "parallel",
                "dependsOn": [
                    "Start Stocai",
                    "Start Dexai",
                    "Start X Platform",
                    "Start Dash",
                    "Start Wallet",
                    "Start Identity",
                    "Start Metu",
                    "Start Metu Web",
                    "Start Mod"
                ],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                }
            },
            {
                "label": "Start Stocai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Stocai}",
                    "env": {
                        "PORT": "4300"
                    }
                }
            },
            {
                "label": "Start Dexai",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Dexai}",
                    "env": {
                        "PORT": "4301"
                    }
                }
            },
            {
                "label": "Start X Platform",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:X Platform}",
                    "env": {
                        "PORT": "4302"
                    }
                }
            },
            {
                "label": "Start Dash",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Dash}",
                    "env": {
                        "PORT": "4303"
                    }
                }
            },
            {
                "label": "Start Wallet",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Wallet}",
                    "env": {
                        "PORT": "4304"
                    }
                }
            },
            {
                "label": "Start Identity",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Identity}",
                    "env": {
                        "PORT": "4305"
                    }
                }
            },
            {
                "label": "Start Metu",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Metu}",
                    "env": {
                        "PORT": "4306"
                    }
                }
            },
            {
                "label": "Start Metu Web",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Metu Web}",
                    "env": {
                        "PORT": "4307"
                    }
                }
            },
            {
                "label": "Start Mod",
                "type": "shell",
                "command": "pnpm dev",
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "options": {
                    "cwd": "${workspaceFolder:Mod}",
                    "env": {
                        "PORT": "4308"
                    }
                }
            },
            {
                "label": "Build Platform Services",
                "type": "shell",
                "command": "pnpm build",
                "group": "build"
            },
            {
                "label": "Test Platform Services",
                "type": "shell",
                "command": "pnpm test",
                "group": "test"
            },
            {
                "label": "Build Rust Components",
                "type": "shell",
                "command": "cargo build",
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder:Metu}"
                }
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Wallet",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Wallet}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4304"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            },
            {
                "name": "Debug Identity",
                "type": "node",
                "request": "launch",
                "program": "${workspaceFolder:Identity}/src/server.ts",
                "env": {
                    "NODE_ENV": "development",
                    "PORT": "4305"
                },
                "runtimeArgs": ["-r", "ts-node/register"],
                "skipFiles": ["<node_internals>/**"]
            },
            {
                "name": "Debug Metu (Rust)",
                "type": "lldb",
                "request": "launch",
                "program": "${workspaceFolder:Metu}/target/debug/metu",
                "cwd": "${workspaceFolder:Metu}",
                "args": []
            }
        ]
    }
}
